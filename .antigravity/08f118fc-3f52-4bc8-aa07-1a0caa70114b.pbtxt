        replacement_content: "      {/* Header & Quick Actions */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <div>\n          <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-1\">\n            REGISTRO DE BLADERS & PADR\303\223N\n          </h1>\n          <p className=\"font-body-text text-sm md:text-base text-gray-600 dark:text-gray-400\">\n            Padr\303\263n oficial de participantes, fotos de perfil, insignias de honor y Decks de combate.\n          </p>\n        </div>\n\n        {/* Quick Load Roster Presets */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => handleLoadRoster(OFFICIAL_DEFAULT_BLADERS)}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#04A8FC] hover:bg-[#008fe0] text-white font-headline font-black text-xs uppercase shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-105 active:scale-95\"\n            title=\"Cargar autom\303\241ticamente los 8 bladers oficiales con combos completos\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">bolt</span>\n            <span>Cargar Roster Oficial (8)</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLoadRoster(OFFICIAL_16_BLADERS)}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-headline font-bold text-xs uppercase transition-all hover:scale-105 active:scale-95 border border-slate-700\"\n            title=\"Cargar padr\303\263n completo de 16 competidores para torneos grandes\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">groups</span>\n            <span>Roster Grande (16)</span>\n          </button>\n        </div>\n      </div>"
