          text: "  tournament_name TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  season TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  logo_url TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  type TEXT DEFAULT \'elimination\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
