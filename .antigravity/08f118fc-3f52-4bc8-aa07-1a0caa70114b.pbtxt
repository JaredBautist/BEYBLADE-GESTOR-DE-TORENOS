        }
        lines {
          text: "      (blader.combos?.[0] ? `${blader.combos[0].blade} ${blader.combos[0].ratchet}${blader.combos[0].bit}`.trim() : \'\')"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    );"
