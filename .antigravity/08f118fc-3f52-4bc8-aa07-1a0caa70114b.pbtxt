th > 0 && (\n              <div className=\"flex items-center gap-1.5 mb-4 p-1.5 bg-black/5 dark:bg-white/5 rounded-lg\">\n                <span className=\"text-[10px] font-label-caps text-gray-500 uppercase px-1 font-bold\">\n                  Deck:\n                </span>\n                {bladerA.combos.map((combo) => (\n                  <button\n                    key={combo.slot}\n                    onClick={() => setSelectedComboSlotA(combo.slot)}\n                    className={`flex-1 py-1 px-2 rounded text-[11px] font-label-caps uppercase truncate transition-all ${\n                      selectedComboSlotA === combo.slot\n                        ? \'bg-[#AC191F] text-white font-bold shadow-sm\'\n                        : \'text-gray-600 dark:text-gray-400 hover:bg-black/10 dark:hover:bg-white/10\'\n                    }`}\n                  >\n                    {combo.blade.substring(0, 8)}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* Large Score Display */}\n            <div className=\"flex justify-center items-center py-4 my-2 bg-black/5 dark:bg-black/20 rounded-2xl border border-[#AC191F]/20\">\n              <div className=\"text-center\">\n                <span className=\"block text-gray-500 dark:text-gray-400 font-label-caps text-xs uppercase tracking-widest font-semibold mb-1\">\n                  PUNTOS\n                </span>\n                <span\n                  id=\"score-display-a\"\n                  className=\"font-headline font-black text-6xl md:text-8xl text-[#AC191F] leading-none drop-shadow-sm tracking-tighter inline-block\"\n                >\n                  {currentMatch.scoreA}\n                </span>\n              </div>\n            </div>\n\n            {/* Tactical Scoring Controls */}\n            <div className=\"space-y-2.5 mt-4\">\n              {/* Xtreme Finish (3 PTS) */}\n              <button\n                id=\"btn-red-xtreme-finish\"\n                onClick={() => handlePointClick(\'A\', \'xtreme\', config.victoryConditions.xtremeDashPts)}\n                className=\"w-full bg-[#AC191F] hover:bg-[#c91d24] text-white py-3 px-4 rounded-xl flex items-center justify-between font-label-caps uppercase tracking-wider font-bold shadow-md shadow-[#AC191F]/20 hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-red-950\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-lg\">bolt</span>\n                  <span>XTREME FINISH</span>\n                </div>\n                <span className=\"bg-black/30 px-2.5 py-0.5 rounded-lg text-xs\">\n                  +{config.victoryConditions.xtremeDashPts} PTS\n                </span>\n              </button>\n\n              {/* Burst Finish & Over Finish (2 PTS each) */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-red-burst-finish\"\n                  onClick={() => handlePointClick(\'A\', \'burst\', config.victoryConditions.burstFinishPts)}\n                  className=\"bg-[#FFA500] hover:bg-[#ff9500] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-amber-800\"\n                >\n                  <span>BURST FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.burstFinishPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-red-over-finish\"\n                  onClick={() => handlePointClick(\'A\', \'over\', config.victoryConditions.overFinishPts)}\n                  className=\"bg-[#39FF14] hover:bg-[#32e610] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-green-800\"\n                >\n                  <span>OVER FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.overFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n\n              {/* Stadium Out & Spin Finish */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-red-stadium-out\"\n                  onClick={() => handlePointClick(\'A\', \'stadium\', config.victoryConditions.stadiumOutPts)}\n                  className=\"bg-gray-600 hover:bg-gray-500 text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-gray-900\"\n                >\n                  <span>STADIUM OUT</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.stadiumOutPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-red-spin-finish\"\n                  onClick={() => handlePointClick(\'A\', \'spin\', config.victoryConditions.spinFinishPts)}\n                  className=\"bg-[#04A8FC] hover:bg-[#0096e6] text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-blue-900\"\n                >\n                  <span>SPIN FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.spinFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* CENTER VS & TARGET MODULE */}\n        <div className=\"lg:col-span-2 flex flex-col justify-center items-center gap-5 py-4 lg:py-0\">\n          {/* Circular VS badge */}\n          <div className=\"relative flex justify-center items-center w-full\">\n            <div className=\"w-16 h-16 rounded-full bg-white dark:bg-[#1f1f25] border-2 border-[#04A8FC] shadow-lg flex items-center justify-center rotate-12 transform hover:rotate-0 transition-transform\">\n              <span className=\"font-headline font-black text-2xl text-[#1a1c1e] dark:text-white italic -rotate-12\">\n                VS\n              </span>\n            </div>\n          </div>\n\n          {/* Target Score Chip */}\n          <div className=\"glass-panel p-4 rounded-2xl flex flex-col items-center gap-1 w-full text-center border-2 border-[#FCEE21]/60 bg-[#FCEE21]/10 dark:bg-yellow-950/20 shadow-sm\">\n            <span className=\"font-label-caps text-[11px] text-amber-700 dark:text-amber-300 uppercase font-black tracking-wider\">\n              OBJETIVO\n            </span>\n            <span className=\"font-headline font-black text-3xl text-amber-600 dark:text-yellow-400 leading-none\">\n              {currentMatch.targetScore} PTS\n            </span>\n            <span className=\"text-[10px] font-label-caps text-gray-500 uppercase\">\n              Para Ganar\n            </span>\n          </div>\n\n          {/* Reset button */}\n          <button\n            id=\"btn-reset-match\"\n            onClick={() => {\n              soundManager.playClick();\n              onResetMatch();\n            }}\n            className=\"w-full glass-panel py-2 px-3 rounded-xl font-label-caps text-xs uppercase tracking-wider text-gray-600 dark:text-gray-300 hover:text-black dark:hover:text-white hover:border-[#AC191F] flex items-center justify-center gap-1.5 transition-all shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">restart_alt</span>\n            <span>Reiniciar Marcador</span>\n          </button>\n\n          {/* Toggle Point Log view */}\n          <button\n            onClick={() => setShowEventLog(!showEventLog)}\n            className=\"text-[11px] font-label-caps uppercase text-[#04A8FC] hover:underline flex items-center gap-1\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">\n              {showEventLog ? \'expand_less\' : \'history\'}\n            </span>\n            <span>{showEventLog ? \'Ocultar Registro\' : \'Ver Registro\'}</span>\n          </button>\n        </div>\n\n        {/* BLUE CORNER (Blader B) */}\n        <div className=\"lg:col-span-5 flex flex-col\">\n          <div className=\"glass-panel p-5 rounded-2xl relative overflow-hidden group border-r-4 border-r-[#04A8FC] border-t border-l border-b border-[#bec7d3]/40 dark:border-white/10 shadow-sm flex flex-col justify-between h-full bg-gradient-to-b from-white/90 to-blue-50/20 dark:from-[#16161d]/90 dark:to-blue-950/10\">\n            {/* Tactical background glow */}\n            <div className=\"absolute top-0 left-0 w-36 h-36 bg-[#04A8FC]/10 rounded-full blur-3xl pointer-events-none -ml-10 -mt-10\"></div>\n\n            {/* Profile Info */}\n            <div className=\"flex flex-row-reverse items-center gap-4 mb-4 relative z-10 text-right\">\n              <BladerAvatar\n                blader={bladerB}\n                size=\"xl\"\n                cornerColor=\"blue\"\n                showBadge={true}\n                badgeText=\"BLUE\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"font-label-caps text-xs text-[#04A8FC] uppercase font-bold tracking-wider\">\n                  Esquina Azul {bladerB?.team ? `\342\200\242 ${bladerB.team}` : \'\'}\n                </p>\n                <h3 className=\"font-headline font-black text-2xl md:text-3xl text-[#1a1c1e] dark:text-white uppercase truncate\">\n                  {bladerB?.name || \'Esquina Azul\'}\n                </h3>\n                <p className=\"text-gray-500 dark:text-gray-400 text-xs font-label-caps uppercase truncate\">\n                  {currentComboB?.name || (bladerB?.combos?.length ? bladerB.combos[0].name : \'Configuraci\303\263n de Combate\')}\n                </p>\n              </div>\n            </div>\n\n            {/* Combo selector chips (if combos available) */}\n            {bladerB && bladerB.combos && bladerB.combos.length > 0 && (\n              <div className=\"flex items-center justify-end gap-1.5 mb-4 p-1.5 bg-black/5 dark:bg-white/5 rounded-lg\">\n                <span className=\"text-[10px] font-label-caps text-gray-500 uppercase px-1 font-bold\">\n                  Deck:\n                </span>\n                {bladerB.combos.map((combo) => (\n                  <button\n                    key={combo.slot}\n                    onClick={() => setSelectedComboSlotB(combo.slot)}\n                    className={`flex-1 py-1 px-2 rounded text-[11px] font-label-caps uppercase truncate transition-all ${\n                      selectedComboSlotB === combo.slot\n                        ? \'bg-[#04A8FC] text-white font-bold shadow-sm\'\n                        : \'text-gray-600 dark:text-gray-400 hover:bg-black/10 dark:hover:bg-white/10\'\n                    }`}\n                  >\n                    {combo.blade.substring(0, 8)}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* Large Score Display */}\n            <div className=\"flex justify-center items-center py-4 my-2 bg-black/5 dark:bg-black/20 rounded-2xl border border-[#04A8FC]/20\">\n              <div className=\"text-center\">\n                <span className=\"block text-gray-500 dark:text-gray-400 font-label-caps text-xs uppercase tracking-widest font-semibold mb-1\">\n                  PUNTOS\n                </span>\n                <span\n                  id=\"score-display-b\"\n                  className=\"font-headline font-black text-6xl md:text-8xl text-[#04A8FC] leading-none drop-shadow-sm tracking-tighter inline-block\"\n                >\n                  {currentMatch.scoreB}\n                </span>\n              </div>\n            </div>\n\n            {/* Tactical Scoring Controls */}\n            <div className=\"space-y-2.5 mt-4\">\n              {/* Xtreme Finish (3 PTS) */}\n              <button\n                id=\"btn-blue-xtreme-finish\"\n                onClick={() => handlePointClick(\'B\', \'xtreme\', config.victoryConditions.xtremeDashPts)}\n                className=\"w-full bg-[#04A8FC] hover:bg-[#0096e6] text-white py-3 px-4 rounded-xl flex items-center justify-between font-label-caps uppercase tracking-wider font-bold shadow-md shadow-[#04A8FC]/20 hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-blue-950\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-lg\">bolt</span>\n                  <span>XTREME FINISH</span>\n                </div>\n                <span className=\"bg-black/30 px-2.5 py-0.5 rounded-lg text-xs\">\n                  +{config.victoryConditions.xtremeDashPts} PTS\n                </span>\n              </button>\n\n              {/* Burst Finish & Over Finish (2 PTS each) */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-blue-burst-finish\"\n                  onClick={() => handlePointClick(\'B\', \'burst\', config.victoryConditions.burstFinishPts)}\n                  className=\"bg-[#FFA500] hover:bg-[#ff9500] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-amber-800\"\n                >\n                  <span>BURST FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.burstFinishPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-blue-over-finish\"\n                  onClick={() => handlePointClick(\'B\', \'over\', config.victoryConditions.overFinishPts)}\n                  className=\"bg-[#39FF14] hover:bg-[#32e610] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-green-800\"\n                >\n                  <span>OVER FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.overFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n\n              {/* Stadium Out & Spin Finish */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-blue-stadium-out\"\n                  onClick={() => handlePointClick(\'B\', \'stadium\', config.victoryConditions.stadiumOutPts)}\n                  className=\"bg-gray-600 hover:bg-gray-500 text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-gray-900\"\n                >\n                  <span>STADIUM OUT</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.stadiumOutPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-blue-spin-finish\"\n                  onClick={() => handlePointClick(\'B\', \'spin\', config.victoryConditions.spinFinishPts)}\n                  className=\"bg-[#04A8FC] hover:bg-[#0096e6] text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-blue-900\"\n                >\n                  <span>SPIN FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.spinFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>"
      replacement_content: "      {/* Main Battle Arena 12-Column Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\">\n        {/* RED CORNER (Blader A) */}\n        <div className=\"lg:col-span-5 flex flex-col\">\n          <div className=\"glass-panel p-5 rounded-2xl relative overflow-hidden group border-l-4 border-l-[#DC2626] border-t border-r border-b border-slate-200 dark:border-white/10 shadow-sm flex flex-col justify-between h-full bg-white dark:bg-[#15151e]\">\n            {/* Tactical background glow */}\n            <div className=\"absolute top-0 right-0 w-36 h-36 bg-red-500/5 dark:bg-red-500/10 rounded-full blur-3xl pointer-events-none -mr-10 -mt-10\"></div>\n\n            {/* Profile Info */}\n            <div className=\"flex items-center gap-4 mb-4 relative z-10\">\n              <BladerAvatar\n                blader={bladerA}\n                size=\"xl\"\n                cornerColor=\"red\"\n                showBadge={true}\n                badgeText=\"RED\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"font-label-caps text-xs text-[#DC2626] dark:text-[#f87171] uppercase font-black tracking-wider\">\n                  Esquina Roja {bladerA?.team ? `\342\200\242 ${bladerA.team}` : \'\'}\n                </p>\n                <h3 className=\"font-headline font-black text-2xl md:text-3xl text-slate-900 dark:text-white uppercase truncate\">\n                  {bladerA?.name || \'Esquina Roja\'}\n                </h3>\n                <p className=\"text-slate-500 dark:text-slate-400 text-xs font-label-caps uppercase truncate\">\n                  {currentComboA?.name || (bladerA?.combos?.length ? bladerA.combos[0].name : \'Configuraci\303\263n de Combate\')}\n                </p>\n              </div>\n            </div>\n\n            {/* Combo selector chips (if combos available) */}\n            {bladerA && bladerA.combos && bladerA.combos.length > 0 && (\n              <div className=\"flex items-center gap-1.5 mb-4 p-1.5 bg-slate-100 dark:bg-white/5 rounded-xl border border-slate-200/60 dark:border-white/5\">\n                <span className=\"text-[10px] font-label-caps text-slate-500 uppercase px-1 font-bold\">\n                  Deck:\n                </span>\n                {bladerA.combos.map((combo) => (\n                  <button\n                    key={combo.slot}\n                    onClick={() => setSelectedComboSlotA(combo.slot)}\n                    className={`flex-1 py-1 px-2 rounded-lg text-[11px] font-label-caps uppercase truncate transition-all ${\n                      selectedComboSlotA === combo.slot\n                        ? \'bg-[#DC2626] text-white font-bold shadow-sm\'\n                        : \'text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-white/10\'\n                    }`}\n                  >\n                    {combo.blade.substring(0, 8)}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* Large Score Display */}\n            <div className=\"flex justify-center items-center py-5 my-2 bg-red-50/70 dark:bg-red-950/20 rounded-2xl border-2 border-red-200 dark:border-red-900/40 shadow-inner\">\n              <div className=\"text-center\">\n                <span className=\"block text-slate-500 dark:text-slate-400 font-label-caps text-xs uppercase tracking-widest font-black mb-1\">\n                  PUNTOS\n                </span>\n                <span\n                  id=\"score-display-a\"\n                  className=\"font-headline font-black text-6xl md:text-8xl text-[#DC2626] dark:text-[#f87171] leading-none drop-shadow-sm tracking-tighter inline-block\"\n                >\n                  {currentMatch.scoreA}\n                </span>\n              </div>\n            </div>\n\n            {/* Tactical Scoring Controls */}\n            <div className=\"space-y-2.5 mt-4\">\n              {/* Xtreme Finish (3 PTS) */}\n              <button\n                id=\"btn-red-xtreme-finish\"\n                onClick={() => handlePointClick(\'A\', \'xtreme\', config.victoryConditions.xtremeDashPts)}\n                className=\"w-full bg-[#DC2626] hover:bg-[#B91C1C] text-white py-3 px-4 rounded-xl flex items-center justify-between font-label-caps uppercase tracking-wider font-black shadow-md shadow-red-500/20 hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-red-900\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-lg\">bolt</span>\n                  <span>XTREME FINISH</span>\n                </div>\n                <span className=\"bg-black/25 px-2.5 py-0.5 rounded-lg text-xs font-mono\">\n                  +{config.victoryConditions.xtremeDashPts} PTS\n                </span>\n              </button>\n\n              {/* Burst Finish & Over Finish (2 PTS each) */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-red-burst-finish\"\n                  onClick={() => handlePointClick(\'A\', \'burst\', config.victoryConditions.burstFinishPts)}\n                  className=\"bg-[#D97706] hover:bg-[#B45309] text-white py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-amber-900\"\n                >\n                  <span>BURST FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.burstFinishPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-red-over-finish\"\n                  onClick={() => handlePointClick(\'A\', \'over\', config.victoryConditions.overFinishPts)}\n                  className=\"bg-[#16A34A] hover:bg-[#15803D] text-white py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-green-900\"\n                >\n                  <span>OVER FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.overFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n\n              {/* Stadium Out & Spin Finish */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-red-stadium-out\"\n                  onClick={() => handlePointClick(\'A\', \'stadium\', config.victoryConditions.stadiumOutPts)}\n                  className=\"bg-slate-600 hover:bg-slate-700 text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-slate-900\"\n                >\n                  <span>STADIUM OUT</span>\n                  <span className=\"text-[10px] bg-black/25 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.stadiumOutPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-red-spin-finish\"\n                  onClick={() => handlePointClick(\'A\', \'spin\', config.victoryConditions.spinFinishPts)}\n                  className=\"bg-[#0284C7] hover:bg-[#0369A1] text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-sky-900\"\n                >\n                  <span>SPIN FINISH</span>\n                  <span className=\"text-[10px] bg-black/25 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.spinFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* CENTER VS & TARGET MODULE */}\n        <div className=\"lg:col-span-2 flex flex-col justify-center items-center gap-4 py-4 lg:py-0\">\n          {/* Circular VS badge */}\n          <div className=\"relative flex justify-center items-center w-full\">\n            <div className=\"w-16 h-16 rounded-2xl bg-white dark:bg-[#1c1c27] border-2 border-[#04A8FC] shadow-md flex items-center justify-center rotate-6 hover:rotate-0 transition-transform\">\n              <span className=\"font-headline font-black text-2xl text-slate-900 dark:text-white italic\">\n                VS\n              </span>\n            </div>\n          </div>\n\n          {/* Target Score Chip */}\n          <div className=\"glass-panel p-4 rounded-2xl flex flex-col items-center gap-1 w-full text-center border-2 border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-950/20 shadow-sm\">\n            <span className=\"font-label-caps text-[11px] text-amber-800 dark:text-amber-300 uppercase font-black tracking-wider\">\n              OBJETIVO\n            </span>\n            <span className=\"font-headline font-black text-3xl text-amber-600 dark:text-yellow-400 leading-none\">\n              {currentMatch.targetScore} PTS\n            </span>\n            <span className=\"text-[10px] font-label-caps text-slate-500 uppercase\">\n              Para Ganar\n            </span>\n          </div>\n\n          {/* Reset button */}\n          <button\n            id=\"btn-reset-match\"\n            onClick={() => {\n              soundManager.playClick();\n              onResetMatch();\n            }}\n            className=\"w-full glass-panel py-2 px-3 rounded-xl font-label-caps text-xs uppercase tracking-wider text-slate-700 dark:text-slate-300 hover:text-red-600 dark:hover:text-white hover:border-red-300 dark:hover:border-red-500/40 flex items-center justify-center gap-1.5 transition-all shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">restart_alt</span>\n            <span>Reiniciar Marcador</span>\n          </button>\n\n          {/* Toggle Point Log view */}\n          <button\n            onClick={() => setShowEventLog(!showEventLog)}\n            className=\"text-[11px] font-label-caps uppercase text-[#0284c7] dark:text-[#04A8FC] hover:underline flex items-center gap-1 font-bold\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">\n              {showEventLog ? \'expand_less\' : \'history\'}\n            </span>\n            <span>{showEventLog ? \'Ocultar Registro\' : \'Ver Registro\'}</span>\n          </button>\n        </div>\n\n        {/* BLUE CORNER (Blader B) */}\n        <div className=\"lg:col-span-5 flex flex-col\">\n          <div className=\"glass-panel p-5 rounded-2xl relative overflow-hidden group border-r-4 border-r-[#0284C7] border-t border-l border-b border-slate-200 dark:border-white/10 shadow-sm flex flex-col justify-between h-full bg-white dark:bg-[#15151e]\">\n            {/* Tactical background glow */}\n            <div className=\"absolute top-0 left-0 w-36 h-36 bg-sky-500/5 dark:bg-sky-500/10 rounded-full blur-3xl pointer-events-none -ml-10 -mt-10\"></div>\n\n            {/* Profile Info */}\n            <div className=\"flex flex-row-reverse items-center gap-4 mb-4 relative z-10 text-right\">\n              <BladerAvatar\n                blader={bladerB}\n                size=\"xl\"\n                cornerColor=\"blue\"\n                showBadge={true}\n                badgeText=\"BLUE\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"font-label-caps text-xs text-[#0284C7] dark:text-[#38bdf8] uppercase font-black tracking-wider\">\n                  Esquina Azul {bladerB?.team ? `\342\200\242 ${bladerB.team}` : \'\'}\n                </p>\n                <h3 className=\"font-headline font-black text-2xl md:text-3xl text-slate-900 dark:text-white uppercase truncate\">\n                  {bladerB?.name || \'Esquina Azul\'}\n                </h3>\n                <p className=\"text-slate-500 dark:text-slate-400 text-xs font-label-caps uppercase truncate\">\n                  {currentComboB?.name || (bladerB?.combos?.length ? bladerB.combos[0].name : \'Configuraci\303\263n de Combate\')}\n                </p>\n              </div>\n            </div>\n\n            {/* Combo selector chips (if combos available) */}\n            {bladerB && bladerB.combos && bladerB.combos.length > 0 && (\n              <div className=\"flex items-center justify-end gap-1.5 mb-4 p-1.5 bg-slate-100 dark:bg-white/5 rounded-xl border border-slate-200/60 dark:border-white/5\">\n                <span className=\"text-[10px] font-label-caps text-slate-500 uppercase px-1 font-bold\">\n                  Deck:\n                </span>\n                {bladerB.combos.map((combo) => (\n                  <button\n                    key={combo.slot}\n                    onClick={() => setSelectedComboSlotB(combo.slot)}\n                    className={`flex-1 py-1 px-2 rounded-lg text-[11px] font-label-caps uppercase truncate transition-all ${\n                      selectedComboSlotB === combo.slot\n                        ? \'bg-[#0284C7] text-white font-bold shadow-sm\'\n                        : \'text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-white/10\'\n                    }`}\n                  >\n                    {combo.blade.substring(0, 8)}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* Large Score Display */}\n            <div className=\"flex justify-center items-center py-5 my-2 bg-sky-50/70 dark:bg-sky-950/20 rounded-2xl border-2 border-sky-200 dark:border-sky-900/40 shadow-inner\">\n              <div className=\"text-center\">\n                <span className=\"block text-slate-500 dark:text-slate-400 font-label-caps text-xs uppercase tracking-widest font-black mb-1\">\n                  PUNTOS\n                </span>\n                <span\n                  id=\"score-display-b\"\n                  className=\"font-headline font-black text-6xl md:text-8xl text-[#0284C7] dark:text-[#38bdf8] leading-none drop-shadow-sm tracking-tighter inline-block\"\n                >\n                  {currentMatch.scoreB}\n                </span>\n              </div>\n            </div>\n\n            {/* Tactical Scoring Controls */}\n            <div className=\"space-y-2.5 mt-4\">\n              {/* Xtreme Finish (3 PTS) */}\n              <button\n                id=\"btn-blue-xtreme-finish\"\n                onClick={() => handlePointClick(\'B\', \'xtreme\', config.victoryConditions.xtremeDashPts)}\n                className=\"w-full bg-[#0284C7] hover:bg-[#0369A1] text-white py-3 px-4 rounded-xl flex items-center justify-between font-label-caps uppercase tracking-wider font-black shadow-md shadow-sky-500/20 hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-sky-900\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-lg\">bolt</span>\n                  <span>XTREME FINISH</span>\n                </div>\n                <span className=\"bg-black/25 px-2.5 py-0.5 rounded-lg text-xs font-mono\">\n                  +{config.victoryConditions.xtremeDashPts} PTS\n                </span>\n              </button>\n\n              {/* Burst Finish & Over Finish (2 PTS each) */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-blue-burst-finish\"\n                  onClick={() => handlePointClick(\'B\', \'burst\', config.victoryConditions.burstFinishPts)}\n                  className=\"bg-[#D97706] hover:bg-[#B45309] text-white py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-amber-900\"\n                >\n                  <span>BURST FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.burstFinishPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-blue-over-finish\"\n                  onClick={() => handlePointClick(\'B\', \'over\', config.victoryConditions.overFinishPts)}\n                  className=\"bg-[#16A34A] hover:bg-[#15803D] text-white py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-green-900\"\n                >\n                  <span>OVER FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.overFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n\n              {/* Stadium Out & Spin Finish */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-blue-stadium-out\"\n                  onClick={() => handlePointClick(\'B\', \'stadium\', config.victoryConditions.stadiumOutPts)}\n                  className=\"bg-slate-600 hover:bg-slate-700 text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-slate-900\"\n                >\n                  <span>STADIUM OUT</span>\n                  <span className=\"text-[10px] bg-black/25 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.stadiumOutPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-blue-spin-finish\"\n                  onClick={() => handlePointClick(\'B\', \'spin\', config.victoryConditions.spinFinishPts)}\n                  className=\"bg-[#0284C7] hover:bg-[#0369A1] text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-sky-900\"\n                >\n                  <span>SPIN FINISH</span>\n                  <span className=\"text-[10px] bg-black/25 px-2 py-0.5 rounded mt-0.5 font-mono\">\n                    +{config.victoryConditions.spinFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>"
