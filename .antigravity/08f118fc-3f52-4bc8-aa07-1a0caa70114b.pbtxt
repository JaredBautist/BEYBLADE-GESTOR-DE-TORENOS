    wait_ms_before_async: 10000
    combined_output {
      full: "jackson.png (Beyblade X - Ekusu Kurosu.png) -> https://static.wikia.nocookie.net/beyblade/images/e/ee/Beyblade_X_-_Ekusu_Kurosu.png/revision/latest?cb=20230907013357Successfully saved public/avatars/jackson.png (181856 bytes)volt.png (Beyblade Burst - Valt Aoi.png) -> https://static.wikia.nocookie.net/beyblade/images/b/b5/Beyblade_Burst_-_Valt_Aoi.png/revision/latest?cb=20191110014027Successfully saved public/avatars/volt.png (149304 bytes)gingka.png (GingaHaganeMetalFusion.jpg) -> https://static.wikia.nocookie.net/beyblade/images/e/e5/GingaHaganeMetalFusion.jpg/revision/latest?cb=20230824175306Successfully saved public/avatars/gingka.png (90646 bytes)tyson.png (Takao Kinomiya.png) -> None"
    }
    command_line: "python3 -c \"\nimport urllib.request\nimport json\n\ndef get_file_url(filename):\n    url = f\'https://beyblade.fandom.com/api.php?action=query&titles=File:{urllib.parse.quote(filename)}&prop=imageinfo&iiprop=url&format=json\'\n    req = urllib.request.Request(url, headers={\'User-Agent\': \'Mozilla/5.0\'})\n    with urllib.request.urlopen(req, timeout=10) as r:\n        data = json.loads(r.read().decode())\n        pages = data[\'query\'][\'pages\']\n        for pid, pdata in pages.items():\n            if \'imageinfo\' in pdata and len(pdata[\'imageinfo\']) > 0:\n                return pdata[\'imageinfo\'][0][\'url\']\n    return None\n\ntargets = {\n    \'jackson.png\': \'Beyblade X - Ekusu Kurosu.png\',\n    \'volt.png\': \'Beyblade Burst - Valt Aoi.png\',\n    \'gingka.png\': \'GingaHaganeMetalFusion.jpg\',\n    \'tyson.png\': \'Takao Kinomiya.png\'\n}\n\nfor local_name, wiki_name in targets.items():\n    u = get_file_url(wiki_name)\n    print(f\'{local_name} ({wiki_name}) -> {u}\')\n    if u:\n        try:\n            req = urllib.request.Request(u, headers={\'User-Agent\': \'Mozilla/5.0\'})\n            with urllib.request.urlopen(req, timeout=10) as r:\n                data = r.read()\n                with open(f\'public/avatars/{local_name}\', \'wb\') as f:\n                    f.write(data)\n                print(f\'Successfully saved public/avatars/{local_name} ({len(data)} bytes)\')\n        except Exception as e:\n            print(f\'Failed to download {local_name}: {e}\')\n\""
    proposed_command_line: "python3 -c \"\nimport urllib.request\nimport json\n\ndef get_file_url(filename):\n    url = f\'https://beyblade.fandom.com/api.php?action=query&titles=File:{urllib.parse.quote(filename)}&prop=imageinfo&iiprop=url&format=json\'\n    req = urllib.request.Request(url, headers={\'User-Agent\': \'Mozilla/5.0\'})\n    with urllib.request.urlopen(req, timeout=10) as r:\n        data = json.loads(r.read().decode())\n        pages = data[\'query\'][\'pages\']\n        for pid, pdata in pages.items():\n            if \'imageinfo\' in pdata and len(pdata[\'imageinfo\']) > 0:\n                return pdata[\'imageinfo\'][0][\'url\']\n    return None\n\ntargets = {\n    \'jackson.png\': \'Beyblade X - Ekusu Kurosu.png\',\n    \'volt.png\': \'Beyblade Burst - Valt Aoi.png\',\n    \'gingka.png\': \'GingaHaganeMetalFusion.jpg\',\n    \'tyson.png\': \'Takao Kinomiya.png\'\n}\n\nfor local_name, wiki_name in targets.items():\n    u = get_file_url(wiki_name)\n    print(f\'{local_name} ({wiki_name}) -> {u}\')\n    if u:\n        try:\n            req = urllib.request.Request(u, headers={\'User-Agent\': \'Mozilla/5.0\'})\n            with urllib.request.urlopen(req, timeout=10) as r:\n                data = r.read()\n                with open(f\'public/avatars/{local_name}\', \'wb\') as f:\n                    f.write(data)\n                print(f\'Successfully saved public/avatars/{local_name} ({len(data)} bytes)\')\n        except Exception as e:\n            print(f\'Failed to download {local_name}: {e}\')\n\""
    shell_name: "bash"
  }
}
