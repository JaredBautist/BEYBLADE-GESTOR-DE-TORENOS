    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Blader, BladerCombo } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\nimport { BladerAvatar } from \'../BladerAvatar\';\n\ninterface BladersScreenProps {\n  bladers: Blader[];\n  onAddBlader: (blader: Blader) => void;\n  onToggleVerified: (id: string) => void;\n  onDeleteBlader: (id: string) => void;\n}\n\nconst EMBLEMS = [\n  { id: \'dran\', label: \'Dragon Flame\', icon: \'local_fire_department\', color: \'from-blue-600 to-cyan-500\' },\n  { id: \'scythe\', label: \'Hells Reaver\', icon: \'bolt\', color: \'from-red-600 to-rose-500\' },\n  { id: \'wizard\', label: \'Wizard Arc\', icon: \'flare\', color: \'from-amber-500 to-yellow-400\' },\n  { id: \'knight\', label: \'Aegis Knight\', icon: \'shield_moon\', color: \'from-purple-600 to-indigo-500\' },\n  { id: \'shark\', label: \'Shark Hunter\', icon: \'cyclone\', color: \'from-emerald-600 to-teal-500\' },\n  { id: \'viper\', label: \'Viper Fang\', icon: \'security\', color: \'from-orange-600 to-amber-500\' },\n  { id: \'phoenix\', label: \'Phoenix Wing\', icon: \'sports_kabaddi\', color: \'from-sky-600 to-blue-700\' },\n  { id: \'drake\', label: \'Cobalt Tyrant\', icon: \'military_tech\', color: \'from-slate-700 to-slate-900\' }\n];\n\nexport const BladersScreen: React.FC<BladersScreenProps> = ({\n  bladers,\n  onAddBlader,\n  onToggleVerified,\n  onDeleteBlader\n}) => {\n  const [name, setName] = useState<string>(\'\');\n  const [alias, setAlias] = useState<string>(\'\');\n  const [team, setTeam] = useState<string>(\'\');\n  const [selectedEmblemIndex, setSelectedEmblemIndex] = useState<number>(0);\n  const [customAvatar, setCustomAvatar] = useState<string>(\'\');\n  const [selectedBlader, setSelectedBlader] = useState<Blader | null>(null);\n\n  // 3 Combos state\n  const [combo1, setCombo1] = useState<string>(\'Dransword 3-60F\');\n  const [combo2, setCombo2] = useState<string>(\'Hellscythe 4-60T\');\n  const [combo3, setCombo3] = useState<string>(\'Wizardarrow 4-80B\');\n\n  const handleClear = () => {\n    setName(\'\');\n    setAlias(\'\');\n    setTeam(\'\');\n    setCustomAvatar(\'\');\n    setCombo1(\'Dransword 3-60F\');\n    setCombo2(\'Hellscythe 4-60T\');\n    setCombo3(\'Wizardarrow 4-80B\');\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const reader = new FileReader();\n      reader.onload = (uploadEvent) => {\n        if (uploadEvent.target?.result) {\n          setCustomAvatar(uploadEvent.target.result as string);\n        }\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim()) return;\n\n    soundManager.playClick();\n\n    const combos: BladerCombo[] = [\n      {\n        slot: 1,\n        blade: combo1.split(\' \')[0] || \'Dransword\',\n        ratchet: combo1.split(\' \')[1] || \'3-60\',\n        bit: \'F\',\n        name: combo1\n      },\n      {\n        slot: 2,\n        blade: combo2.split(\' \')[0] || \'Hellscythe\',\n        ratchet: combo2.split(\' \')[1] || \'4-60\',\n        bit: \'T\',\n        name: combo2\n      },\n      {\n        slot: 3,\n        blade: combo3.split(\' \')[0] || \'Wizardarrow\',\n        ratchet: combo3.split(\' \')[1] || \'4-80\',\n        bit: \'B\',\n        name: combo3\n      }\n    ];\n\n    const newBlader: Blader = {\n      id: `blader-${Date.now()}`,\n      name: name.trim(),\n      alias: alias.trim() || name.trim(),\n      team: team.trim() || \'Solo\',\n      avatarUrl: customAvatar || \'\',\n      verified: true,\n      registeredAt: new Date().toISOString().split(\'T\')[0],\n      combos,\n      stats: {\n        matchesPlayed: 0,\n        wins: 0,\n        losses: 0,\n        pointsScored: 0,\n        xtremeFinishes: 0,\n        burstFinishes: 0,\n        overFinishes: 0,\n        spinFinishes: 0\n      }\n    };\n\n    onAddBlader(newBlader);\n    handleClear();\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n          BLADER REGISTRATION\n        </h1>\n        <p className=\"font-body-text text-base md:text-lg text-gray-600 dark:text-gray-400\">\n          Administraci\303\263n de participantes activos, insignias de combate y verificaci\303\263n de combos 3on3.\n        </p>\n      </div>\n\n      {/* Main Grid: Form (Col 8) + Active Roster (Col 4) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Form Container */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          <div className=\"glass-panel p-6 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm relative overflow-hidden group\">\n            <div className=\"absolute top-0 right-0 w-32 h-32 bg-[#04A8FC]/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110\"></div>\n\n            <h3 className=\"font-headline font-bold text-xl text-[#04A8FC] uppercase mb-6 flex items-center gap-2\">\n              <span className=\"material-symbols-outlined\">person_add</span>\n              <span>Nuevo Perfil de Blader</span>\n            </h3>\n\n            <form onSubmit={handleSubmit} className=\"space-y-6\">\n              {/* Name & Team Fields */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                    Nombre / Alias del Blader *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={name}\n                    onChange={(e) => setName(e.target.value)}\n                    placeholder=\"Ej. Kamen X, Ryuga...\"\n                    className=\"w-full bg-black/5 dark:bg-white/5 border-b-2 border-[#04A8FC] rounded-t-lg px-3 py-2 text-[#1a1c1e] dark:text-white font-headline text-base focus:outline-none focus:bg-black/10 transition-colors\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                    Equipo / Afiliaci\303\263n (Opcional)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={team}\n                    onChange={(e) => setTeam(e.target.value)}\n                    placeholder=\"Ej. Team Persona, Solo...\"\n                    className=\"w-full bg-black/5 dark:bg-white/5 border-b-2 border-gray-400 dark:border-gray-600 rounded-t-lg px-3 py-2 text-[#1a1c1e] dark:text-white font-headline text-base focus:border-[#04A8FC] focus:outline-none transition-colors\"\n                  />\n                </div>\n              </div>\n\n              {/* Insignia / Avatar Selector */}\n              <div>\n                <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                  Insignia T\303\241ctica de Combate\n                </label>\n                <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n                  {EMBLEMS.map((emb, idx) => (\n                    <button\n                      key={emb.id}\n                      type=\"button\"\n                      onClick={() => {\n                        setSelectedEmblemIndex(idx);\n                        setCustomAvatar(\'\');\n                      }}\n                      className={`p-3 rounded-xl border flex items-center gap-2.5 transition-all text-left ${\n                        selectedEmblemIndex === idx && !customAvatar\n                          ? \'border-[#04A8FC] bg-[#04A8FC]/10 ring-2 ring-[#04A8FC]/30 shadow-sm\'\n                          : \'border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5\'\n                      }`}\n                    >\n                      <div className={`w-8 h-8 rounded-lg bg-gradient-to-tr ${emb.color} flex items-center justify-center text-white shadow-xs`}>\n                        <span className=\"material-symbols-outlined text-base\">{emb.icon}</span>\n                      </div>\n                      <div className=\"min-w-0\">\n                        <span className=\"block font-headline font-bold text-xs uppercase text-[#1a1c1e] dark:text-white truncate\">\n                          {emb.label}\n                        </span>\n                      </div>\n                    </button>\n                  ))}\n                </div>\n\n                {/* Optional local file upload */}\n                <div className=\"mt-3 flex items-center gap-3\">\n                  <label className=\"cursor-pointer bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 border border-[#bec7d3]/40 dark:border-white/10 px-3 py-1.5 rounded-lg text-xs font-label-caps uppercase flex items-center gap-1.5 text-gray-700 dark:text-gray-300 transition-all\">\n                    <span className=\"material-symbols-outlined text-sm\">upload</span>\n                    <span>Subir Foto Personalizada</span>\n                    <input type=\"file\" accept=\"image/*\" onChange={handleFileUpload} className=\"hidden\" />\n                  </label>\n                  {customAvatar && (\n                    <span className=\"text-[11px] text-green-500 font-bold flex items-center gap-1\">\n                      <span className=\"material-symbols-outlined text-sm\">check_circle</span>\n                      Foto cargada\n                    </span>\n                  )}\n                </div>\n              </div>\n\n              {/* 3on3 Deck Configuration */}\n              <div className=\"space-y-4 pt-2 border-t border-[#bec7d3]/30 dark:border-white/10\">\n                <h4 className=\"font-headline font-bold text-sm uppercase text-[#1a1c1e] dark:text-white flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-base text-[#04A8FC]\">settings_suggest</span>\n                  <span>Deck Oficial 3on3</span>\n                </h4>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[11px] font-label-caps uppercase text-gray-500 font-bold\">\n                      Combo Slot 1 (Ataque)\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={combo1}\n                      onChange={(e) => setCombo1(e.target.value)}\n                      className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-1.5 text-xs font-headline uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[11px] font-label-caps uppercase text-gray-500 font-bold\">\n                      Combo Slot 2 (Balance)\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={combo2}\n                      onChange={(e) => setCombo2(e.target.value)}\n                      className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-1.5 text-xs font-headline uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[11px] font-label-caps uppercase text-gray-500 font-bold\">\n                      Combo Slot 3 (Stamina / Def)\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={combo3}\n                      onChange={(e) => setCombo3(e.target.value)}\n                      className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-1.5 text-xs font-headline uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Form Buttons */}\n              <div className=\"flex items-center justify-end gap-3 pt-4 border-t border-[#bec7d3]/30 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={handleClear}\n                  className=\"px-4 py-2 rounded-xl text-xs font-label-caps uppercase text-gray-500 hover:text-black dark:hover:text-white\"\n                >\n                  Limpiar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-6 py-2.5 rounded-xl font-headline font-bold text-xs uppercase shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02]\"\n                >\n                  Registrar Blader\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n\n        {/* Right Roster Summary & Blader Details */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          <div className=\"glass-panel p-5 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm\">\n            <div className=\"flex items-center justify-between mb-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-3\">\n              <h3 className=\"font-headline font-black text-lg uppercase text-[#1a1c1e] dark:text-white flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-[#04A8FC]\">groups</span>\n                <span>Roster Oficial</span>\n              </h3>\n              <span className=\"bg-[#04A8FC]/15 text-[#006398] dark:text-[#93ccff] font-bold text-xs px-2.5 py-0.5 rounded-full font-mono\">\n                {bladers.length} Bladers\n              </span>\n            </div>\n\n            <div className=\"space-y-3 max-h-[520px] overflow-y-auto pr-1\">\n              {bladers.map((b) => (\n                <div\n                  key={b.id}\n                  onClick={() => setSelectedBlader(b)}\n                  className={`p-3 rounded-xl border transition-all cursor-pointer flex items-center gap-3 ${\n                    selectedBlader?.id === b.id\n                      ? \'border-[#04A8FC] bg-[#04A8FC]/10 shadow-sm\'\n                      : \'border-black/5 dark:border-white/5 bg-white/50 dark:bg-white/5 hover:border-gray-400\'\n                  }`}\n                >\n                  <BladerAvatar blader={b} size=\"sm\" />\n                  <div className=\"min-w-0 flex-1\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <h4 className=\"font-headline font-bold text-sm uppercase text-[#1a1c1e] dark:text-white truncate\">\n                        {b.name}\n                      </h4>\n                      {b.verified && (\n                        <span className=\"material-symbols-outlined text-[#04A8FC] text-sm\" title=\"Combo Verificado\">\n                          verified\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-[10px] font-label-caps text-gray-500 truncate uppercase\">\n                      {b.team} \342\200\242 {b.combos[0]?.blade || \'Dransword\'}\n                    </p>\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"font-headline font-bold text-xs text-[#04A8FC] block\">\n                      {b.stats.wins}W - {b.stats.losses}L\n                    </span>\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onDeleteBlader(b.id);\n                      }}\n                      className=\"text-gray-400 hover:text-red-500 text-[10px] uppercase font-bold\"\n                    >\n                      Eliminar\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
