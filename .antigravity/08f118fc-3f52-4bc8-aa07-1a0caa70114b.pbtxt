  file_change {
    absolute_path_uri: "file:///src/components/screens/BladersScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Blader, BladerCombo } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\nimport { BladerAvatar } from \'../BladerAvatar\';\nimport { OFFICIAL_BADGES, BladerBadge } from \'../../data/badges\';\n\ninterface BladersScreenProps {\n  bladers: Blader[];\n  onAddBlader: (blader: Blader) => void;\n  onToggleVerified: (id: string) => void;\n  onDeleteBlader: (id: string) => void;\n  onToggleBadge?: (bladerId: string, badgeId: string) => void;\n}\n\nconst EMBLEMS = [\n  { id: \'dran\', label: \'Dragon Flame\', icon: \'local_fire_department\', color: \'from-blue-600 to-cyan-500\' },\n  { id: \'scythe\', label: \'Hells Reaver\', icon: \'bolt\', color: \'from-red-600 to-rose-500\' },\n  { id: \'wizard\', label: \'Wizard Arc\', icon: \'flare\', color: \'from-amber-500 to-yellow-400\' },\n  { id: \'knight\', label: \'Aegis Knight\', icon: \'shield_moon\', color: \'from-purple-600 to-indigo-500\' },\n  { id: \'shark\', label: \'Shark Hunter\', icon: \'cyclone\', color: \'from-emerald-600 to-teal-500\' },\n  { id: \'viper\', label: \'Viper Fang\', icon: \'security\', color: \'from-orange-600 to-amber-500\' },\n  { id: \'phoenix\', label: \'Phoenix Wing\', icon: \'sports_kabaddi\', color: \'from-sky-600 to-blue-700\' },\n  { id: \'drake\', label: \'Cobalt Tyrant\', icon: \'military_tech\', color: \'from-slate-700 to-slate-900\' }\n];\n\nexport const BladersScreen: React.FC<BladersScreenProps> = ({\n  bladers,\n  onAddBlader,\n  onToggleVerified,\n  onDeleteBlader,\n  onToggleBadge\n}) => {\n  const [name, setName] = useState<string>(\'\');\n  const [alias, setAlias] = useState<string>(\'\');\n  const [team, setTeam] = useState<string>(\'\');\n  const [selectedEmblemIndex, setSelectedEmblemIndex] = useState<number>(0);\n  const [customAvatar, setCustomAvatar] = useState<string>(\'\');\n  const [selectedBlader, setSelectedBlader] = useState<Blader | null>(bladers[0] || null);\n\n  // Selected initial badges\n  const [selectedBadgeIds, setSelectedBadgeIds] = useState<string[]>([\'badge-official-member\']);\n\n  // 3 Combos state\n  const [combo1, setCombo1] = useState<string>(\'Dransword 3-60F\');\n  const [combo2, setCombo2] = useState<string>(\'Hellscythe 4-60T\');\n  const [combo3, setCombo3] = useState<string>(\'Wizardarrow 4-80B\');\n\n  const handleClear = () => {\n    setName(\'\');\n    setAlias(\'\');\n    setTeam(\'\');\n    setCustomAvatar(\'\');\n    setSelectedBadgeIds([\'badge-official-member\']);\n    setCombo1(\'Dransword 3-60F\');\n    setCombo2(\'Hellscythe 4-60T\');\n    setCombo3(\'Wizardarrow 4-80B\');\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const reader = new FileReader();\n      reader.onload = (uploadEvent) => {\n        if (uploadEvent.target?.result) {\n          setCustomAvatar(uploadEvent.target.result as string);\n        }\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const toggleInitialBadge = (badgeId: string) => {\n    soundManager.playClick();\n    setSelectedBadgeIds((prev) =>\n      prev.includes(badgeId) ? prev.filter((id) => id !== badgeId) : [...prev, badgeId]\n    );\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim()) return;\n\n    soundManager.playScore();\n\n    const combos: BladerCombo[] = [\n      {\n        slot: 1,\n        blade: combo1.split(\' \')[0] || \'Dransword\',\n        ratchet: combo1.split(\' \')[1] || \'3-60\',\n        bit: \'F\',\n        name: combo1\n      },\n      {\n        slot: 2,\n        blade: combo2.split(\' \')[0] || \'Hellscythe\',\n        ratchet: combo2.split(\' \')[1] || \'4-60\',\n        bit: \'T\',\n        name: combo2\n      },\n      {\n        slot: 3,\n        blade: combo3.split(\' \')[0] || \'Wizardarrow\',\n        ratchet: combo3.split(\' \')[1] || \'4-80\',\n        bit: \'B\',\n        name: combo3\n      }\n    ];\n\n    const newBlader: Blader = {\n      id: `blader-${Date.now()}`,\n      name: name.trim(),\n      alias: alias.trim() || name.trim(),\n      team: team.trim() || \'Solo\',\n      avatarUrl: customAvatar || \'\',\n      verified: true,\n      registeredAt: new Date().toISOString().split(\'T\')[0],\n      combos,\n      badges: selectedBadgeIds,\n      stats: {\n        matchesPlayed: 0,\n        wins: 0,\n        losses: 0,\n        pointsScored: 0,\n        xtremeFinishes: 0,\n        burstFinishes: 0,\n        overFinishes: 0,\n        spinFinishes: 0\n      }\n    };\n\n    onAddBlader(newBlader);\n    setSelectedBlader(newBlader);\n    handleClear();\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n          REGISTRO DE BLADERS & INSIGNIAS\n        </h1>\n        <p className=\"font-body-text text-base md:text-lg text-gray-600 dark:text-gray-400\">\n          Administraci\303\263n de participantes activos, medallas de honor Xtreme y verificaci\303\263n de combos 3on3.\n        </p>\n      </div>\n\n      {/* Main Grid: Form (Col 7) + Active Roster & Badges (Col 5) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Form Container */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          <div className=\"glass-panel p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm relative overflow-hidden bg-white dark:bg-[#15151c]\">\n            <h3 className=\"font-headline font-black text-xl text-[#04A8FC] uppercase mb-6 flex items-center gap-2\">\n              <span className=\"material-symbols-outlined\">person_add</span>\n              <span>Inscribir Nuevo Blader</span>\n            </h3>\n\n            <form onSubmit={handleSubmit} className=\"space-y-6\">\n              {/* Name & Team Fields */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                    Nombre Oficial del Blader *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={name}\n                    onChange={(e) => setName(e.target.value)}\n                    placeholder=\"Ej. Dylan Bautista, Kamen X...\"\n                    className=\"w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3.5 py-2.5 text-[#1a1c1e] dark:text-white font-headline text-sm focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm transition-all\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                    Equipo / Team (Opcional)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={team}\n                    onChange={(e) => setTeam(e.target.value)}\n                    placeholder=\"Ej. Team C\303\272cuta X, Persona, Solo...\"\n                    className=\"w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3.5 py-2.5 text-[#1a1c1e] dark:text-white font-headline text-sm focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Avatar / Photo Upload */}\n              <div>\n                <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                  Foto de Perfil o Avatar\n                </label>\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"w-16 h-16 rounded-2xl bg-slate-100 dark:bg-white/5 border border-slate-300 dark:border-white/10 flex items-center justify-center overflow-hidden flex-shrink-0\">\n                    {customAvatar ? (\n                      <img src={customAvatar} alt=\"Preview\" className=\"w-full h-full object-cover\" />\n                    ) : (\n                      <span className=\"material-symbols-outlined text-slate-400 text-2xl\">account_circle</span>\n                    )}\n                  </div>\n                  <div className=\"flex-1\">\n                    <input\n                      type=\"file\"\n                      id=\"blader-avatar-upload\"\n                      onChange={handleFileUpload}\n                      accept=\"image/*\"\n                      className=\"hidden\"\n                    />\n                    <label\n                      htmlFor=\"blader-avatar-upload\"\n                      className=\"inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 text-slate-700 dark:text-slate-300 rounded-xl font-headline font-bold text-xs uppercase cursor-pointer transition-all\"\n                    >\n                      <span className=\"material-symbols-outlined text-base\">photo_camera</span>\n                      <span>Subir Foto del Blader</span>\n                    </label>\n                  </div>\n                </div>\n              </div>\n\n              {/* Insignias Asignables */}\n              <div>\n                <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                  Insignias Iniciales de Honor\n                </label>\n                <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-2\">\n                  {OFFICIAL_BADGES.slice(0, 6).map((badge) => {\n                    const isSelected = selectedBadgeIds.includes(badge.id);\n                    return (\n                      <button\n                        key={badge.id}\n                        type=\"button\"\n                        onClick={() => toggleInitialBadge(badge.id)}\n                        className={`p-2.5 rounded-xl border text-left flex items-center gap-2 transition-all ${\n                          isSelected\n                            ? `${badge.bgColor} ${badge.borderColor} ring-1 ring-[#04A8FC]`\n                            : \'border-slate-200 dark:border-white/5 bg-slate-50 dark:bg-white/5 opacity-60 hover:opacity-100\'\n                        }`}\n                      >\n                        <span className={`material-symbols-outlined text-lg ${badge.color}`}>\n                          {badge.icon}\n                        </span>\n                        <div className=\"min-w-0\">\n                          <span className=\"font-headline font-bold text-[11px] uppercase block text-slate-900 dark:text-white truncate\">\n                            {badge.name}\n                          </span>\n                        </div>\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* 3on3 Deck Configuration */}\n              <div className=\"space-y-3 pt-2\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 uppercase font-bold\">\n                    Deck Reglamentario 3on3 (3 Beyblades)\n                  </label>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[11px] font-label-caps uppercase text-slate-600 dark:text-slate-400 font-bold\">\n                      Combo Slot 1 (Principal)\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={combo1}\n                      onChange={(e) => setCombo1(e.target.value)}\n                      placeholder=\"Ej. Dransword 3-60F\"\n                      className=\"w-full bg-slate-50 dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[11px] font-label-caps uppercase text-slate-600 dark:text-slate-400 font-bold\">\n                      Combo Slot 2\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={combo2}\n                      onChange={(e) => setCombo2(e.target.value)}\n                      placeholder=\"Ej. Hellscythe 4-60T\"\n                      className=\"w-full bg-slate-50 dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[11px] font-label-caps uppercase text-slate-600 dark:text-slate-400 font-bold\">\n                      Combo Slot 3\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={combo3}\n                      onChange={(e) => setCombo3(e.target.value)}\n                      placeholder=\"Ej. Wizardarrow 4-80B\"\n                      className=\"w-full bg-slate-50 dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Form Buttons */}\n              <div className=\"flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={handleClear}\n                  className=\"px-4 py-2 rounded-xl text-xs font-label-caps uppercase text-gray-500 hover:text-black dark:hover:text-white\"\n                >\n                  Limpiar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-6 py-2.5 rounded-xl font-headline font-black text-xs uppercase shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02] active:scale-95\"\n                >\n                  Registrar Blader\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n\n        {/* Right Roster Summary & Blader Details */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          {/* Selected Blader Detail & Badges */}\n          {selectedBlader && (\n            <div className=\"glass-panel p-6 rounded-3xl border border-[#04A8FC]/40 bg-white dark:bg-[#15151c] shadow-lg shadow-[#04A8FC]/10 space-y-5\">\n              <div className=\"flex items-center justify-between border-b border-slate-100 dark:border-white/5 pb-4\">\n                <div className=\"flex items-center gap-3\">\n                  <BladerAvatar blader={selectedBlader} size=\"md\" />\n                  <div>\n                    <div className=\"flex items-center gap-1.5\">\n                      <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                        {selectedBlader.name}\n                      </h4>\n                      {selectedBlader.verified && (\n                        <span className=\"material-symbols-outlined text-[#04A8FC] text-base\" title=\"Blader Verificado\">\n                          verified\n                        </span>\n                      )}\n                    </div>\n                    <span className=\"text-xs font-label-caps uppercase text-slate-500 font-bold\">\n                      {selectedBlader.team} \342\200\242 {selectedBlader.stats.wins}W / {selectedBlader.stats.losses}L\n                    </span>\n                  </div>\n                </div>\n\n                <button\n                  onClick={() => onToggleVerified(selectedBlader.id)}\n                  className=\"text-xs font-headline font-bold text-[#04A8FC] uppercase hover:underline\"\n                >\n                  {selectedBlader.verified ? \'Verificado\' : \'Verificar\'}\n                </button>\n              </div>\n\n              {/* Insignias del Blader */}\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <h5 className=\"font-headline font-bold text-xs uppercase text-slate-500 dark:text-slate-400 tracking-wider\">\n                    Insignias de Honor ({selectedBlader.badges?.length || 0})\n                  </h5>\n                </div>\n                <div className=\"grid grid-cols-2 gap-2\">\n                  {OFFICIAL_BADGES.map((b) => {\n                    const hasBadge = selectedBlader.badges?.includes(b.id);\n                    return (\n                      <div\n                        key={b.id}\n                        onClick={() => onToggleBadge && onToggleBadge(selectedBlader.id, b.id)}\n                        className={`p-2 rounded-xl border flex items-center gap-2 cursor-pointer transition-all ${\n                          hasBadge\n                            ? `${b.bgColor} ${b.borderColor} opacity-100`\n                            : \'border-dashed border-slate-200 dark:border-white/10 opacity-40 hover:opacity-80\'\n                        }`}\n                        title={b.description}\n                      >\n                        <span className={`material-symbols-outlined text-base ${b.color}`}>\n                          {b.icon}\n                        </span>\n                        <div className=\"min-w-0 flex-1\">\n                          <span className=\"font-headline font-bold text-[10px] uppercase block text-slate-900 dark:text-white truncate\">\n                            {b.name}\n                          </span>\n                        </div>\n                        {hasBadge && (\n                          <span className=\"material-symbols-outlined text-xs text-emerald-500\">check</span>\n                        )}\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Combos 3on3 del Blader */}\n              <div className=\"space-y-2 pt-2 border-t border-slate-100 dark:border-white/5\">\n                <h5 className=\"font-headline font-bold text-xs uppercase text-slate-500 dark:text-slate-400 tracking-wider\">\n                  Deck 3on3 Configurado\n                </h5>\n                <div className=\"space-y-1.5\">\n                  {selectedBlader.combos.map((c, i) => (\n                    <div\n                      key={i}\n                      className=\"p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/5 flex items-center justify-between text-xs font-mono\"\n                    >\n                      <span className=\"font-headline font-bold uppercase text-slate-900 dark:text-white\">\n                        #{c.slot} {c.name || `${c.blade} ${c.ratchet}${c.bit}`}\n                      </span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Roster List */}\n          <div className=\"glass-panel p-5 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm bg-white dark:bg-[#15151c]\">\n            <div className=\"flex items-center justify-between mb-4 border-b border-slate-100 dark:border-white/5 pb-3\">\n              <h3 className=\"font-headline font-black text-base uppercase text-slate-900 dark:text-white flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-[#04A8FC]\">groups</span>\n                <span>Padr\303\263n de Bladers ({bladers.length})</span>\n              </h3>\n            </div>\n\n            <div className=\"space-y-2.5 max-h-[380px] overflow-y-auto pr-1\">\n              {bladers.map((b) => (\n                <div\n                  key={b.id}\n                  onClick={() => {\n                    soundManager.playClick();\n                    setSelectedBlader(b);\n                  }}\n                  className={`p-3 rounded-2xl border transition-all cursor-pointer flex items-center gap-3 ${\n                    selectedBlader?.id === b.id\n                      ? \'border-[#04A8FC] bg-[#04A8FC]/10 shadow-sm\'\n                      : \'border-slate-200 dark:border-white/5 bg-slate-50 dark:bg-white/5 hover:border-[#04A8FC]/40\'\n                  }`}\n                >\n                  <BladerAvatar blader={b} size=\"sm\" />\n                  <div className=\"min-w-0 flex-1\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <h4 className=\"font-headline font-bold text-sm uppercase text-slate-900 dark:text-white truncate\">\n                        {b.name}\n                      </h4>\n                      {b.verified && (\n                        <span className=\"material-symbols-outlined text-[#04A8FC] text-sm\" title=\"Combo Verificado\">\n                          verified\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-[10px] font-label-caps text-slate-500 truncate uppercase\">\n                      {b.team} \342\200\242 {b.badges?.length || 0} Insignias\n                    </p>\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"font-headline font-bold text-xs text-[#04A8FC] block\">\n                      {b.stats.wins}W - {b.stats.losses}L\n                    </span>\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        soundManager.playClick();\n                        onDeleteBlader(b.id);\n                      }}\n                      className=\"text-slate-400 hover:text-red-500 text-[10px] uppercase font-bold\"\n                    >\n                      Eliminar\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
