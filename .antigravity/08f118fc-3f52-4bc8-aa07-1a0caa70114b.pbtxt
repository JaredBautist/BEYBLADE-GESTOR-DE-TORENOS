    instruction: "Update Header props and render dynamic community branding and tagline"
    replacement_infos {
      original_chunk {
        target_content: "interface HeaderProps {\n  activeScreen: ActiveScreen;\n  setActiveScreen: (screen: ActiveScreen) => void;\n  isDark: boolean;\n  setIsDark: (dark: boolean) => void;\n  isMuted: boolean;\n  setIsMuted: (muted: boolean) => void;\n  onOpenNewBladerModal: () => void;\n  logoUrl?: string;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeScreen,\n  setActiveScreen,\n  isDark,\n  setIsDark,\n  isMuted,\n  setIsMuted,\n  onOpenNewBladerModal,\n  logoUrl\n}) => {\n  return (\n    <header className=\"bg-white/95 dark:bg-[#131318]/95 border-b border-slate-200 dark:border-white/10 backdrop-blur-xl fixed top-0 left-0 right-0 md:left-64 z-40 h-16 flex items-center justify-between px-3 sm:px-4 md:px-8 transition-colors duration-200 shadow-sm\">\n      {/* Left branding / navigation */}\n      <div className=\"flex items-center gap-2 sm:gap-4 md:gap-8 min-w-0\">\n        <div className=\"flex items-center gap-2.5 sm:gap-3 min-w-0\">\n          <div className=\"w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-white border border-slate-200 dark:border-white/10 p-0.5 flex items-center justify-center shadow-sm flex-shrink-0\">\n            <CommunityLogo size=\"sm\" customImageUrl={logoUrl} className=\"w-full h-full object-contain\" />\n          </div>\n          <div className=\"min-w-0\">\n            <h1 className=\"font-headline font-black text-sm sm:text-base md:text-xl text-slate-900 dark:text-white tracking-tight uppercase leading-none truncate\">\n              BEYBLADE X <span className=\"hidden xs:inline\">TOURNAMENT</span>\n            </h1>\n            <span className=\"text-[9px] sm:text-[10px] font-label-caps uppercase tracking-wider text-[#0284c7] dark:text-[#04A8FC] font-black truncate block\">\n              C\303\232CUTA \342\200\242 OFICIAL\n            </span>\n          </div>\n        </div>"
        replacement_content: "interface HeaderProps {\n  activeScreen: ActiveScreen;\n  setActiveScreen: (screen: ActiveScreen) => void;\n  isDark: boolean;\n  setIsDark: (dark: boolean) => void;\n  isMuted: boolean;\n  setIsMuted: (muted: boolean) => void;\n  onOpenNewBladerModal: () => void;\n  logoUrl?: string;\n  leagueName?: string;\n  communityTagline?: string;\n  communityCity?: string;\n  tournamentName?: string;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeScreen,\n  setActiveScreen,\n  isDark,\n  setIsDark,\n  isMuted,\n  setIsMuted,\n  onOpenNewBladerModal,\n  logoUrl,\n  leagueName = \'Comunidad Beyblade C\303\272cuta\',\n  communityTagline = \'C\303\232CUTA \342\200\242 OFICIAL\',\n  communityCity = \'C\303\272cuta\',\n  tournamentName = \'BEYBLADE X TOURNAMENT\'\n}) => {\n  return (\n    <header className=\"bg-white/95 dark:bg-[#131318]/95 border-b border-slate-200 dark:border-white/10 backdrop-blur-xl fixed top-0 left-0 right-0 md:left-64 z-40 h-16 flex items-center justify-between px-3 sm:px-4 md:px-8 transition-colors duration-200 shadow-sm\">\n      {/* Left branding / navigation */}\n      <div className=\"flex items-center gap-2 sm:gap-4 md:gap-8 min-w-0\">\n        <div className=\"flex items-center gap-2.5 sm:gap-3 min-w-0\">\n          <div className=\"w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-white border border-slate-200 dark:border-white/10 p-0.5 flex items-center justify-center shadow-sm flex-shrink-0\">\n            <CommunityLogo size=\"sm\" customImageUrl={logoUrl} communityText={communityCity || leagueName} className=\"w-full h-full object-contain\" />\n          </div>\n          <div className=\"min-w-0\">\n            <h1 className=\"font-headline font-black text-sm sm:text-base md:text-xl text-slate-900 dark:text-white tracking-tight uppercase leading-none truncate\" title={tournamentName}>\n              {tournamentName.includes(\'BEYBLADE\') ? tournamentName : `BEYBLADE X \342\200\242 ${tournamentName}`}\n            </h1>\n            <span className=\"text-[9px] sm:text-[10px] font-label-caps uppercase tracking-wider text-[#0284c7] dark:text-[#04A8FC] font-black truncate block\" title={communityTagline}>\n              {communityTagline || \'OFICIAL\'}\n            </span>\n          </div>\n        </div>"
      }
      num_matches: 1
    }
  }
}
