    instruction: "Add custom font families, utility classes and tactical styling to index.css"
    replacement_infos {
      original_chunk {
        target_content: "@import \"tailwindcss\";\n"
        replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-anybody: \'Anybody\', sans-serif;\n    --font-space: \'Space Grotesk\', monospace;\n    --font-hanken: \'Hanken Grotesk\', sans-serif;\n  }\n\n  body {\n    font-family: var(--font-hanken);\n    color: #1a1c1e;\n    background-color: #f9f9fe;\n    background-image: \n      radial-gradient(circle at 15% 50%, rgba(4, 168, 252, 0.04) 0%, transparent 50%),\n      radial-gradient(circle at 85% 30%, rgba(172, 25, 31, 0.03) 0%, transparent 50%);\n    background-attachment: fixed;\n  }\n\n  .dark body {\n    color: #e4e1e9;\n    background-color: #0e0e13;\n    background-image: \n      radial-gradient(circle at 50% 50%, rgba(4, 168, 252, 0.08) 0%, transparent 60%),\n      radial-gradient(circle at 10% 90%, rgba(172, 25, 31, 0.08) 0%, transparent 50%);\n  }\n}\n\n.font-headline {\n  font-family: \'Anybody\', sans-serif;\n}\n\n.font-code-data, .font-label-caps, .font-hud {\n  font-family: \'Space Grotesk\', monospace;\n}\n\n.font-body-text {\n  font-family: \'Hanken Grotesk\', sans-serif;\n}\n\n/* Tactical Clip Paths */\n.clip-tactical {\n  clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 0 100%);\n}\n\n.clip-corner-diagonal {\n  clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);\n}\n\n.clip-badge {\n  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));\n}\n\n.clip-bracket-node {\n  clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);\n}\n\n/* Starfield texture */\n.stars-bg {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 0;\n  pointer-events: none;\n  background-image: \n    radial-gradient(1px 1px at 25px 35px, #006398, rgba(0,0,0,0)),\n    radial-gradient(1.5px 1.5px at 70px 90px, #04A8FC, rgba(0,0,0,0)),\n    radial-gradient(1px 1px at 120px 180px, #006398, rgba(0,0,0,0)),\n    radial-gradient(1.5px 1.5px at 190px 60px, #AC191F, rgba(0,0,0,0)),\n    radial-gradient(1px 1px at 240px 140px, #04A8FC, rgba(0,0,0,0)),\n    radial-gradient(1.5px 1.5px at 290px 220px, #FCEE21, rgba(0,0,0,0));\n  background-repeat: repeat;\n  background-size: 320px 320px;\n  opacity: 0.2;\n}\n\n.dark .stars-bg {\n  opacity: 0.45;\n}\n\n/* Glass Panels */\n.glass-panel {\n  background: rgba(255, 255, 255, 0.88);\n  backdrop-filter: blur(12px);\n  border: 1px solid rgba(0, 0, 0, 0.08);\n}\n\n.dark .glass-panel {\n  background: rgba(20, 20, 30, 0.75);\n  backdrop-filter: blur(14px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n/* Action button with skew effect */\n.btn-action {\n  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n  transform: skewX(-8deg);\n}\n\n.btn-action-content {\n  transform: skewX(8deg);\n}\n\n.btn-action:active {\n  transform: skewX(-8deg) scale(0.97);\n}\n\n/* Shimmer Animation */\n@keyframes shimmer {\n  0% { transform: translateX(-100%); }\n  100% { transform: translateX(200%); }\n}\n\n.animate-shimmer {\n  animation: shimmer 2s infinite;\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 7px;\n  height: 7px;\n}\n::-webkit-scrollbar-track {\n  background: rgba(0, 0, 0, 0.04);\n}\n::-webkit-scrollbar-thumb {\n  background: #bec7d3;\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #04A8FC;\n}\n"
      }
      num_matches: 1
    }
  }
}
