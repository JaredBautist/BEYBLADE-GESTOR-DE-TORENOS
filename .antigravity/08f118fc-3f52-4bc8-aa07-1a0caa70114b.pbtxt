    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { COMMUNITY_ASSETS } from \'../data/initialData\';\n\ninterface SupportModalProps {\n  onClose: () => void;\n}\n\nexport const SupportModal: React.FC<SupportModalProps> = ({ onClose }) => {\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150\">\n      <div className=\"bg-white dark:bg-[#15151c] border border-[#bec7d3]/40 dark:border-white/10 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-6 text-left\">\n        <div className=\"flex justify-between items-center border-b border-[#bec7d3]/30 dark:border-white/10 pb-3\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl overflow-hidden bg-white p-1 border border-black/10\">\n              <img src={COMMUNITY_ASSETS.logoCucuta} alt=\"Logo\" className=\"w-full h-full object-contain\" />\n            </div>\n            <div>\n              <h3 className=\"font-headline font-black text-lg uppercase text-[#1a1c1e] dark:text-white\">\n                Comunidad Beyblade C\303\272cuta\n              </h3>\n              <p className=\"font-label-caps text-[10px] text-[#04A8FC] uppercase font-bold\">\n                Xtreme Series Tournament Manager\n              </p>\n            </div>\n          </div>\n          <button onClick={onClose} className=\"text-gray-400 hover:text-black dark:hover:text-white text-lg\">\n            \342\234\225\n          </button>\n        </div>\n\n        <div className=\"space-y-4 text-xs font-body-text text-gray-600 dark:text-gray-400 leading-relaxed\">\n          <div className=\"p-3 bg-black/5 dark:bg-white/5 rounded-xl space-y-1\">\n            <h4 className=\"font-headline font-bold text-sm text-[#1a1c1e] dark:text-white uppercase\">\n              \342\232\241 \302\277C\303\263mo usar la Consola de Batalla?\n            </h4>\n            <p>\n              Haz clic en los botones de puntuaci\303\263n t\303\241ctica (<strong>Xtreme Finish +3</strong>, <strong>Burst Finish +2</strong>, <strong>Over Finish +2</strong>, <strong>Spin Finish +1</strong>) para sumar puntos al Blader en tiempo real. Cuando un Blader alcance el puntaje objetivo (ej. 5 PTS), se activar\303\241 la celebraci\303\263n y se registrar\303\241 en el bracket.\n            </p>\n          </div>\n\n          <div className=\"p-3 bg-black/5 dark:bg-white/5 rounded-xl space-y-1\">\n            <h4 className=\"font-headline font-bold text-sm text-[#1a1c1e] dark:text-white uppercase\">\n              \360\237\221\245 Registro de Bladers & Decks 3on3\n            </h4>\n            <p>\n              Ve a la secci\303\263n <strong>Bladers & Roster</strong> para dar de alta nuevos jugadores con sus 3 combos de combate. Puedes verificar su equipo con un solo clic.\n            </p>\n          </div>\n\n          <div className=\"p-3 bg-black/5 dark:bg-white/5 rounded-xl space-y-1\">\n            <h4 className=\"font-headline font-bold text-sm text-[#1a1c1e] dark:text-white uppercase\">\n              \360\237\217\206 \303\201rbol de Torneo & Exportaci\303\263n\n            </h4>\n            <p>\n              En la pantalla <strong>Bracket</strong> tienes la vista completa de la eliminaci\303\263n directa. Puedes hacer zoom, copiar el link en vivo para compartir con los asistentes o imprimir la tabla.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex justify-end pt-3 border-t border-[#bec7d3]/30 dark:border-white/10\">\n          <button\n            onClick={onClose}\n            className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-6 py-2 rounded-xl text-xs font-headline font-bold uppercase\"\n          >\n            Entendido\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
