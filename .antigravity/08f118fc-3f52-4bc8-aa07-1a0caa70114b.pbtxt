          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { text: editSlotsCount >= 2 ? editCombo2 : \'\', slot: 2 },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { text: editSlotsCount >= 3 ? editCombo3 : \'\', slot: 3 }"
