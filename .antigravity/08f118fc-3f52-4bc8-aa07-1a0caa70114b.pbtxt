    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Blader } from \'../../types\';\n\ninterface HistoryScreenProps {\n  bladers: Blader[];\n}\n\nexport const HistoryScreen: React.FC<HistoryScreenProps> = ({ bladers }) => {\n  const sortedByWins = [...bladers].sort((a, b) => b.stats.wins - a.stats.wins);\n  const sortedByXtreme = [...bladers].sort((a, b) => b.stats.xtremeFinishes - a.stats.xtremeFinishes);\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n          HISTORIAL & HALL OF FAME\n        </h1>\n        <p className=\"font-body-text text-base text-gray-600 dark:text-gray-400\">\n          Registros hist\303\263ricos de torneos, campeones pasados y estad\303\255sticas acumuladas en C\303\272cuta.\n        </p>\n      </div>\n\n      {/* Hall of Fame Leaders Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {/* Most Wins */}\n        <div className=\"glass-panel p-5 rounded-2xl border border-amber-500/40 bg-gradient-to-b from-amber-500/10 to-transparent\">\n          <div className=\"flex items-center gap-3 mb-4\">\n            <div className=\"w-10 h-10 rounded-xl bg-amber-500 text-black flex items-center justify-center font-bold\">\n              <span className=\"material-symbols-outlined\">emoji_events</span>\n            </div>\n            <div>\n              <h4 className=\"font-headline font-black text-sm uppercase text-[#1a1c1e] dark:text-white\">\n                R\303\251cord de Victorias\n              </h4>\n              <p className=\"text-[11px] font-label-caps text-gray-500 uppercase\">\n                L\303\255deres en duelos ganados\n              </p>\n            </div>\n          </div>\n          <div className=\"space-y-2\">\n            {sortedByWins.slice(0, 3).map((b, i) => (\n              <div key={b.id} className=\"flex items-center justify-between p-2 rounded-lg bg-black/5 dark:bg-white/5 text-xs font-label-caps uppercase\">\n                <span className=\"font-bold text-[#1a1c1e] dark:text-white\">\n                  #{i + 1} {b.name}\n                </span>\n                <span className=\"font-headline font-bold text-amber-500\">\n                  {b.stats.wins} Victorias\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Most Xtreme Finishes */}\n        <div className=\"glass-panel p-5 rounded-2xl border border-[#AC191F]/40 bg-gradient-to-b from-[#AC191F]/10 to-transparent\">\n          <div className=\"flex items-center gap-3 mb-4\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#AC191F] text-white flex items-center justify-center font-bold\">\n              <span className=\"material-symbols-outlined\">bolt</span>\n            </div>\n            <div>\n              <h4 className=\"font-headline font-black text-sm uppercase text-[#1a1c1e] dark:text-white\">\n                Reyes del Xtreme Dash\n              </h4>\n              <p className=\"text-[11px] font-label-caps text-gray-500 uppercase\">\n                Mayor n\303\272mero de Xtreme Finishes (+3)\n              </p>\n            </div>\n          </div>\n          <div className=\"space-y-2\">\n            {sortedByXtreme.slice(0, 3).map((b, i) => (\n              <div key={b.id} className=\"flex items-center justify-between p-2 rounded-lg bg-black/5 dark:bg-white/5 text-xs font-label-caps uppercase\">\n                <span className=\"font-bold text-[#1a1c1e] dark:text-white\">\n                  #{i + 1} {b.name}\n                </span>\n                <span className=\"font-headline font-bold text-[#AC191F]\">\n                  {b.stats.xtremeFinishes} X-Finishes\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Most Points Scored */}\n        <div className=\"glass-panel p-5 rounded-2xl border border-[#04A8FC]/40 bg-gradient-to-b from-[#04A8FC]/10 to-transparent\">\n          <div className=\"flex items-center gap-3 mb-4\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#04A8FC] text-white flex items-center justify-center font-bold\">\n              <span className=\"material-symbols-outlined\">military_tech</span>\n            </div>\n            <div>\n              <h4 className=\"font-headline font-black text-sm uppercase text-[#1a1c1e] dark:text-white\">\n                Puntuaci\303\263n Acumulada\n              </h4>\n              <p className=\"text-[11px] font-label-caps text-gray-500 uppercase\">\n                Total de puntos en la temporada\n              </p>\n            </div>\n          </div>\n          <div className=\"space-y-2\">\n            {[...bladers].sort((a, b) => b.stats.pointsScored - a.stats.pointsScored).slice(0, 3).map((b, i) => (\n              <div key={b.id} className=\"flex items-center justify-between p-2 rounded-lg bg-black/5 dark:bg-white/5 text-xs font-label-caps uppercase\">\n                <span className=\"font-bold text-[#1a1c1e] dark:text-white\">\n                  #{i + 1} {b.name}\n                </span>\n                <span className=\"font-headline font-bold text-[#04A8FC]\">\n                  {b.stats.pointsScored} Pts\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Past Championships Record */}\n      <div className=\"glass-panel p-6 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 space-y-4\">\n        <h3 className=\"font-headline font-black text-xl uppercase text-[#1a1c1e] dark:text-white\">\n          Torneos Anteriores Concluidos\n        </h3>\n\n        <div className=\"space-y-3\">\n          <div className=\"p-4 rounded-xl bg-black/5 dark:bg-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-l-4 border-l-amber-500\">\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-headline font-bold text-base text-[#1a1c1e] dark:text-white\">\n                  Copa Frontera Beyblade X 2026\n                </span>\n                <span className=\"bg-green-500/20 text-green-600 dark:text-green-400 text-[10px] font-label-caps font-bold px-2 py-0.5 rounded\">\n                  Completado\n                </span>\n              </div>\n              <p className=\"font-label-caps text-xs text-gray-500\">\n                16 Bladers \342\200\242 Estadio Oficial C\303\272cuta \342\200\242 Campe\303\263n: Jaxon Storm (Kamen X)\n              </p>\n            </div>\n            <div className=\"font-headline font-bold text-xs text-[#04A8FC] uppercase\">\n              Final: 5 - 2 vs Ryuga T.\n            </div>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-black/5 dark:bg-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-l-4 border-l-blue-500\">\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-headline font-bold text-base text-[#1a1c1e] dark:text-white\">\n                  Torneo Apertura Dran Buster Clash\n                </span>\n                <span className=\"bg-green-500/20 text-green-600 dark:text-green-400 text-[10px] font-label-caps font-bold px-2 py-0.5 rounded\">\n                  Completado\n                </span>\n              </div>\n              <p className=\"font-label-caps text-xs text-gray-500\">\n                12 Bladers \342\200\242 Estadio Xtreme B \342\200\242 Campe\303\263n: Ryuga T.\n              </p>\n            </div>\n            <div className=\"font-headline font-bold text-xs text-[#04A8FC] uppercase\">\n              Final: 5 - 4 vs Gingka H.\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
