    replacement_chunks {
      target_content: "export const BladersScreen: React.FC<BladersScreenProps> = ({\n  bladers,\n  onAddBlader,\n  onUpdateBlader,\n  onToggleVerified,\n  onDeleteBlader,\n  onToggleBadge\n}) => {\n  const [name, setName] = useState<string>(\'\');\n  const [alias, setAlias] = useState<string>(\'\');\n  const [team, setTeam] = useState<string>(\'\');\n  const [customAvatar, setCustomAvatar] = useState<string>(\'\');\n  const [avatarUrlInput, setAvatarUrlInput] = useState<string>(\'\');\n  const [showUrlInput, setShowUrlInput] = useState<boolean>(false);\n  const [selectedBlader, setSelectedBlader] = useState<Blader | null>(bladers[0] || null);\n  const [isSyncing, setIsSyncing] = useState<boolean>(false);\n  const [syncFeedback, setSyncFeedback] = useState<{ message: string; isError?: boolean } | null>(null);"
      replacement_content: "export const BladersScreen: React.FC<BladersScreenProps> = ({\n  bladers,\n  onAddBlader,\n  onUpdateBlader,\n  onToggleVerified,\n  onDeleteBlader,\n  onToggleBadge,\n  onLoadOfficialRoster\n}) => {\n  const [name, setName] = useState<string>(\'\');\n  const [alias, setAlias] = useState<string>(\'\');\n  const [team, setTeam] = useState<string>(\'\');\n  const [customAvatar, setCustomAvatar] = useState<string>(\'\');\n  const [avatarUrlInput, setAvatarUrlInput] = useState<string>(\'\');\n  const [showUrlInput, setShowUrlInput] = useState<boolean>(false);\n  const [selectedBlader, setSelectedBlader] = useState<Blader | null>(bladers[0] || null);\n  const [isSyncing, setIsSyncing] = useState<boolean>(false);\n  const [syncFeedback, setSyncFeedback] = useState<{ message: string; isError?: boolean } | null>(null);\n\n  const handleLoadRoster = async (roster: Blader[]) => {\n    soundManager.playVictory();\n    if (onLoadOfficialRoster) {\n      onLoadOfficialRoster(roster);\n    } else {\n      roster.forEach((b) => onAddBlader(b));\n    }\n    if (roster[0]) {\n      setSelectedBlader(roster[0]);\n    }\n    showToast(`\342\232\241 ${roster.length} Bladers cargados al padr\303\263n oficial`);\n    setIsSyncing(true);\n    await syncAllBladersToSupabase(roster);\n    setIsSyncing(false);\n  };"
    }
