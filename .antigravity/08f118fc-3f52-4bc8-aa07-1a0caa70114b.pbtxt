  file_change {
    absolute_path_uri: "file:///src/components/screens/BracketScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export const BracketScreen: React.FC<BracketScreenProps> = ({\n  bladers,\n  matches,\n  onSelectMatchForConsole,\n  onSetMatchWinner,\n  onGenerateBracket\n}) => {\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [zoomLevel, setZoomLevel] = useState<number>(1);\n\n  const handleCopyLink = () => {\n    soundManager.playClick();\n    if (typeof navigator !== \'undefined\' && navigator.clipboard) {\n      navigator.clipboard.writeText(window.location.href);\n    }\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 2500);\n  };\n\n  // Identify finished matches & potential champion\n  const finalMatch = matches.find((m) => m.roundName?.toLowerCase().includes(\'final\') && !m.roundName?.toLowerCase().includes(\'quarter\') && !m.roundName?.toLowerCase().includes(\'semi\'));\n  const champion = finalMatch?.winnerId\n    ? bladers.find((b) => b.id === finalMatch.winnerId)\n    : matches.filter((m) => m.status === \'finished\' && m.winnerId).map((m) => bladers.find((b) => b.id === m.winnerId))[0];\n\n  const renderMatchNode = (match: Match) => {\n    const isLive = match.status === \'live\';\n    const isFinished = match.status === \'finished\';\n    const bladerA = match.bladerA;\n    const bladerB = match.bladerB;\n\n    return (\n      <div\n        key={match.id}\n        className=\"glass-panel p-3.5 rounded-xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm relative group hover:border-[#04A8FC] transition-all bg-white/90 dark:bg-[#15151c]/90 w-full min-w-[240px]\"\n      >\n        {/* Node Header */}\n        <div className=\"flex items-center justify-between text-[10px] font-label-caps uppercase font-bold text-gray-500 dark:text-gray-400 mb-2 border-b border-[#bec7d3]/30 dark:border-white/10 pb-1\">\n          <span>{match.roundName || `Enfrentamiento #${match.matchNumber}`}</span>\n          <span\n            className={`px-1.5 py-0.5 rounded text-[9px] font-black ${\n              isLive\n                ? \'bg-[#39FF14] text-black animate-pulse\'\n                : isFinished\n                ? \'bg-blue-600 text-white\'\n                : \'bg-black/10 dark:bg-white/10 text-gray-500\'\n            }`}\n          >\n            {isLive ? \'EN VIVO\' : isFinished ? \'FINAL\' : \'PROGRAMADO\'}\n          </span>\n        </div>\n\n        {/* Blader A Slot */}\n        <div\n          onClick={() => {\n            if (bladerA) {\n              onSetMatchWinner(match.id, bladerA.id);\n            }\n          }}\n          className={`flex items-center justify-between p-1.5 rounded-lg mb-1 cursor-pointer transition-all ${\n            match.winnerId === bladerA?.id\n              ? \'bg-[#AC191F]/20 font-black text-[#AC191F]\'\n              : \'hover:bg-black/5 dark:hover:bg-white/5\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <BladerAvatar blader={bladerA} size=\"xs\" cornerColor=\"red\" />\n            <span className=\"font-headline font-bold text-xs uppercase text-[#1a1c1e] dark:text-white truncate\">\n              {bladerA?.name || \'Por Definir (TBD)\'}\n            </span>\n          </div>\n          <span className=\"font-headline font-black text-xs text-[#AC191F] px-1.5\">\n            {match.scoreA}\n          </span>\n        </div>\n\n        {/* Blader B Slot */}\n        <div\n          onClick={() => {\n            if (bladerB) {\n              onSetMatchWinner(match.id, bladerB.id);\n            }\n          }}\n          className={`flex items-center justify-between p-1.5 rounded-lg cursor-pointer transition-all ${\n            match.winnerId === bladerB?.id\n              ? \'bg-[#04A8FC]/20 font-black text-[#04A8FC]\'\n              : \'hover:bg-black/5 dark:hover:bg-white/5\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <BladerAvatar blader={bladerB} size=\"xs\" cornerColor=\"blue\" />\n            <span className=\"font-headline font-bold text-xs uppercase text-[#1a1c1e] dark:text-white truncate\">\n              {bladerB?.name || \'Por Definir (TBD)\'}\n            </span>\n          </div>\n          <span className=\"font-headline font-black text-xs text-[#04A8FC] px-1.5\">\n            {match.scoreB}\n          </span>\n        </div>\n\n        {/* Quick action: Load in console */}\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            onSelectMatchForConsole(match);\n          }}\n          className=\"w-full mt-2 pt-1 border-t border-[#bec7d3]/20 dark:border-white/5 text-[10px] font-label-caps uppercase text-[#04A8FC] hover:underline flex items-center justify-center gap-1 font-bold\"\n        >\n          <span className=\"material-symbols-outlined text-xs\">sports_kabaddi</span>\n          <span>Cargar en Battle Console</span>\n        </button>\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <div>\n          <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n            TOURNAMENT BRACKET\n          </h1>\n          <p className=\"font-body-text text-base text-gray-600 dark:text-gray-400\">\n            \303\201rbol de eliminaci\303\263n directa oficial Comunidad Beyblade C\303\272cuta.\n          </p>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2\">\n          {bladers.length >= 2 && (\n            <button\n              onClick={() => {\n                soundManager.playClick();\n                onGenerateBracket();\n              }}\n              className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-3.5 py-2 rounded-xl text-xs font-headline font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-md shadow-[#04A8FC]/20 transition-all\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">account_tree</span>\n              <span>Generar Fixture Autom\303\241tico</span>\n            </button>\n          )}\n\n          <div className=\"glass-panel px-2 py-1 rounded-xl flex items-center gap-1 border-[#bec7d3]/30\">\n            <button\n              onClick={() => setZoomLevel((z) => Math.max(0.7, z - 0.1))}\n              className=\"p-1 text-gray-500 hover:text-black dark:hover:text-white\"\n              title=\"Reducir Zoom\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">remove</span>\n            </button>\n            <span className=\"text-[10px] font-mono text-gray-500 px-1 font-bold\">\n              {Math.round(zoomLevel * 100)}%\n            </span>\n            <button\n              onClick={() => setZoomLevel((z) => Math.min(1.3, z + 0.1))}\n              className=\"p-1 text-gray-500 hover:text-black dark:hover:text-white\"\n              title=\"Aumentar Zoom\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">add</span>\n            </button>\n          </div>\n\n          <button\n            onClick={handleCopyLink}\n            className=\"bg-white dark:bg-[#1f1f25] border border-[#04A8FC] text-[#04A8FC] dark:text-white px-3.5 py-2 rounded-xl text-xs font-label-caps uppercase tracking-wider flex items-center gap-1.5 hover:bg-[#04A8FC]/10 transition-all shadow-sm\"\n          >"
      replacement_content: "export const BracketScreen: React.FC<BracketScreenProps> = ({\n  bladers,\n  matches,\n  onSelectMatchForConsole,\n  onSetMatchWinner,\n  onGenerateBracket\n}) => {\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [zoomLevel, setZoomLevel] = useState<number>(1);\n  const [viewMode, setViewMode] = useState<\'rounds\' | \'tree\'>(\'rounds\');\n\n  const handleCopyLink = () => {\n    soundManager.playClick();\n    if (typeof navigator !== \'undefined\' && navigator.clipboard) {\n      navigator.clipboard.writeText(window.location.href);\n    }\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 2500);\n  };\n\n  // Identify finished matches & potential champion\n  const finalMatch = matches.find((m) => m.roundName?.toLowerCase().includes(\'final\') && !m.roundName?.toLowerCase().includes(\'quarter\') && !m.roundName?.toLowerCase().includes(\'semi\'));\n  const champion = finalMatch?.winnerId\n    ? bladers.find((b) => b.id === finalMatch.winnerId)\n    : matches.filter((m) => m.status === \'finished\' && m.winnerId).map((m) => bladers.find((b) => b.id === m.winnerId))[0];\n\n  const renderMatchNode = (match: Match) => {\n    const isLive = match.status === \'live\';\n    const isFinished = match.status === \'finished\';\n    const bladerA = match.bladerA;\n    const bladerB = match.bladerB;\n\n    return (\n      <div\n        key={match.id}\n        className=\"glass-panel p-3.5 rounded-2xl border border-slate-200 dark:border-white/10 shadow-sm relative group hover:border-[#04A8FC] transition-all bg-white dark:bg-[#15151c] w-full\"\n      >\n        {/* Node Header */}\n        <div className=\"flex items-center justify-between text-[10px] font-label-caps uppercase font-bold text-slate-500 dark:text-slate-400 mb-2 border-b border-slate-100 dark:border-white/5 pb-1.5\">\n          <span className=\"truncate pr-2\">{match.roundName || `Duelo #${match.matchNumber}`}</span>\n          <span\n            className={`px-2 py-0.5 rounded-full text-[9px] font-black uppercase flex-shrink-0 ${\n              isLive\n                ? \'bg-[#39FF14] text-black animate-pulse\'\n                : isFinished\n                ? \'bg-blue-600 text-white\'\n                : \'bg-slate-200 dark:bg-white/10 text-slate-600 dark:text-slate-300\'\n            }`}\n          >\n            {isLive ? \'EN VIVO\' : isFinished ? \'FINAL\' : \'PROGRAMADO\'}\n          </span>\n        </div>\n\n        {/* Blader A Slot */}\n        <div\n          onClick={() => {\n            if (bladerA) {\n              onSetMatchWinner(match.id, bladerA.id);\n            }\n          }}\n          className={`flex items-center justify-between p-2 rounded-xl mb-1.5 cursor-pointer transition-all ${\n            match.winnerId === bladerA?.id\n              ? \'bg-red-500/20 font-black text-[#DC2626] border border-red-500/30\'\n              : \'hover:bg-slate-100 dark:hover:bg-white/5\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <BladerAvatar blader={bladerA} size=\"xs\" cornerColor=\"red\" />\n            <span className=\"font-headline font-bold text-xs uppercase text-slate-900 dark:text-white truncate\">\n              {bladerA?.name || \'Por Definir\'}\n            </span>\n          </div>\n          <span className=\"font-headline font-black text-xs text-[#DC2626] px-1.5\">\n            {match.scoreA}\n          </span>\n        </div>\n\n        {/* Blader B Slot */}\n        <div\n          onClick={() => {\n            if (bladerB) {\n              onSetMatchWinner(match.id, bladerB.id);\n            }\n          }}\n          className={`flex items-center justify-between p-2 rounded-xl cursor-pointer transition-all ${\n            match.winnerId === bladerB?.id\n              ? \'bg-sky-500/20 font-black text-[#0284C7] dark:text-[#38bdf8] border border-sky-500/30\'\n              : \'hover:bg-slate-100 dark:hover:bg-white/5\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <BladerAvatar blader={bladerB} size=\"xs\" cornerColor=\"blue\" />\n            <span className=\"font-headline font-bold text-xs uppercase text-slate-900 dark:text-white truncate\">\n              {bladerB?.name || \'Por Definir\'}\n            </span>\n          </div>\n          <span className=\"font-headline font-black text-xs text-[#0284C7] dark:text-[#38bdf8] px-1.5\">\n            {match.scoreB}\n          </span>\n        </div>\n\n        {/* Quick action: Load in console */}\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            onSelectMatchForConsole(match);\n          }}\n          className=\"w-full mt-2.5 pt-2 border-t border-slate-100 dark:border-white/5 text-[11px] font-label-caps uppercase text-[#0284c7] dark:text-[#04A8FC] hover:underline flex items-center justify-center gap-1 font-bold min-h-[36px]\"\n        >\n          <span className=\"material-symbols-outlined text-sm\">sports_kabaddi</span>\n          <span>Cargar en Battle Console</span>\n        </button>\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-6 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <div>\n          <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-1\">\n            TOURNAMENT BRACKET\n          </h1>\n          <p className=\"font-body-text text-sm sm:text-base text-gray-600 dark:text-gray-400\">\n            \303\201rbol de eliminaci\303\263n directa oficial Comunidad Beyblade C\303\272cuta.\n          </p>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex flex-wrap items-center gap-2 w-full sm:w-auto\">\n          {/* View mode switcher */}\n          <div className=\"flex bg-slate-100 dark:bg-white/5 p-1 rounded-xl border border-slate-200 dark:border-white/10 text-xs font-headline font-bold uppercase\">\n            <button\n              onClick={() => {\n                soundManager.playClick();\n                setViewMode(\'rounds\');\n              }}\n              className={`px-3 py-1.5 rounded-lg flex items-center gap-1 transition-all ${\n                viewMode === \'rounds\'\n                  ? \'bg-white dark:bg-[#1a1a24] text-[#0284c7] dark:text-[#04A8FC] shadow-sm font-black\'\n                  : \'text-slate-500 hover:text-slate-800 dark:hover:text-white\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-sm\">view_agenda</span>\n              <span>Rondas</span>\n            </button>\n            <button\n              onClick={() => {\n                soundManager.playClick();\n                setViewMode(\'tree\');\n              }}\n              className={`px-3 py-1.5 rounded-lg flex items-center gap-1 transition-all ${\n                viewMode === \'tree\'\n                  ? \'bg-white dark:bg-[#1a1a24] text-[#0284c7] dark:text-[#04A8FC] shadow-sm font-black\'\n                  : \'text-slate-500 hover:text-slate-800 dark:hover:text-white\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-sm\">account_tree</span>\n              <span>\303\201rbol</span>\n            </button>\n          </div>\n\n          {bladers.length >= 2 && (\n            <button\n              onClick={() => {\n                soundManager.playClick();\n                onGenerateBracket();\n              }}\n              className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-3.5 py-2 rounded-xl text-xs font-headline font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-md shadow-[#04A8FC]/20 transition-all\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">auto_mode</span>\n              <span>Generar Fixture</span>\n            </button>\n          )}\n\n          {viewMode === \'tree\' && (\n            <div className=\"glass-panel px-2 py-1 rounded-xl flex items-center gap-1 border-[#bec7d3]/30\">\n              <button\n                onClick={() => setZoomLevel((z) => Math.max(0.7, z - 0.1))}\n                className=\"p-1 text-gray-500 hover:text-black dark:hover:text-white\"\n                title=\"Reducir Zoom\"\n              >\n                <span className=\"material-symbols-outlined text-sm\">remove</span>\n              </button>\n              <span className=\"text-[10px] font-mono text-gray-500 px-1 font-bold\">\n                {Math.round(zoomLevel * 100)}%\n              </span>\n              <button\n                onClick={() => setZoomLevel((z) => Math.min(1.3, z + 0.1))}\n                className=\"p-1 text-gray-500 hover:text-black dark:hover:text-white\"\n                title=\"Aumentar Zoom\"\n              >\n                <span className=\"material-symbols-outlined text-sm\">add</span>\n              </button>\n            </div>\n          )}\n\n          <button\n            onClick={handleCopyLink}\n            className=\"bg-white dark:bg-[#1f1f25] border border-[#04A8FC] text-[#04A8FC] dark:text-white px-3 py-2 rounded-xl text-xs font-label-caps uppercase tracking-wider flex items-center gap-1.5 hover:bg-[#04A8FC]/10 transition-all shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">\n              {copiedLink ? \'check\' : \'share\'}\n            </span>\n            <span className=\"hidden xs:inline\">{copiedLink ? \'\302\241Copiado!\' : \'Compartir\'}</span>\n          </button>\n        </div>\n      </div>"
    }
