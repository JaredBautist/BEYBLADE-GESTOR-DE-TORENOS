        target_content: "  // Core Tournament State\n  const [config, setConfig] = useState<TournamentConfig>(INITIAL_CONFIG);\n  const [bladers, setBladers] = useState<Blader[]>(INITIAL_BLADERS);\n  const [matches, setMatches] = useState<Match[]>(INITIAL_MATCHES);\n  const [parts, setParts] = useState<BeybladePart[]>(INITIAL_BEYBLADE_PARTS);\n  const [currentMatch, setCurrentMatch] = useState<Match | null>(INITIAL_MATCHES[0] || null);"
        replacement_content: "  // Core Tournament State with localStorage persistence\n  const [config, setConfig] = useState<TournamentConfig>(() => {\n    try {\n      const saved = localStorage.getItem(\'bbx_config\');\n      if (saved) return JSON.parse(saved);\n    } catch (e) {\n      console.error(e);\n    }\n    return INITIAL_CONFIG;\n  });\n\n  const [bladers, setBladers] = useState<Blader[]>(INITIAL_BLADERS);\n  const [matches, setMatches] = useState<Match[]>(INITIAL_MATCHES);\n  const [parts, setParts] = useState<BeybladePart[]>(INITIAL_BEYBLADE_PARTS);\n  const [currentMatch, setCurrentMatch] = useState<Match | null>(INITIAL_MATCHES[0] || null);\n\n  useEffect(() => {\n    try {\n      localStorage.setItem(\'bbx_config\', JSON.stringify(config));\n    } catch (e) {\n      console.error(e);\n    }\n  }, [config]);"
      }
      num_matches: 1
    }
