  file_change {
    absolute_path_uri: "file:///src/components/screens/EquipmentScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { BeybladePart, Blader, RegisteredCombo } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\nimport { BeybladeVisualizer } from \'../BeybladeVisualizer\';\nimport { BladerAvatar } from \'../BladerAvatar\';\n\ninterface EquipmentScreenProps {\n  parts: BeybladePart[];\n  bladers: Blader[];\n  registeredCombos: RegisteredCombo[];\n  onAddPart: (part: BeybladePart) => void;\n  onDeletePart: (name: string) => void;\n  onAddCombo: (combo: RegisteredCombo) => void;\n  onDeleteCombo: (id: string) => void;\n}\n\nexport const EquipmentScreen: React.FC<EquipmentScreenProps> = ({\n  parts,\n  bladers,\n  registeredCombos,\n  onAddPart,\n  onDeletePart,\n  onAddCombo,\n  onDeleteCombo\n}) => {\n  const [activeTab, setActiveTab] = useState<\'combos\' | \'parts\'>(\'combos\');\n  const [selectedCategory, setSelectedCategory] = useState<\'All\' | \'Blade\' | \'Ratchet\' | \'Bit\'>(\'All\');\n  const [comboFilterType, setComboFilterType] = useState<string>(\'All\');\n  const [comboFilterBlader, setComboFilterBlader] = useState<string>(\'All\');\n\n  const [showAddPartModal, setShowAddPartModal] = useState<boolean>(false);\n  const [showAddComboModal, setShowAddComboModal] = useState<boolean>(false);\n\n  // New part form state\n  const [newName, setNewName] = useState<string>(\'\');\n  const [newType, setNewType] = useState<\'Blade\' | \'Ratchet\' | \'Bit\'>(\'Blade\');\n  const [newCategory, setNewCategory] = useState<\'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\'>(\'Attack\');\n  const [newWeight, setNewWeight] = useState<string>(\'\');\n  const [newDescription, setNewDescription] = useState<string>(\'\');\n\n  // Active builder pieces\n  const blades = parts.filter((p) => p.type === \'Blade\');\n  const ratchets = parts.filter((p) => p.type === \'Ratchet\');\n  const bits = parts.filter((p) => p.type === \'Bit\');\n\n  const [activeBlade, setActiveBlade] = useState<string>(blades[0]?.name || \'\');\n  const [activeRatchet, setActiveRatchet] = useState<string>(ratchets[0]?.name || \'\');\n  const [activeBit, setActiveBit] = useState<string>(bits[0]?.name || \'\');\n\n  // Save Combo Form State\n  const [selectedOwnerId, setSelectedOwnerId] = useState<string>(bladers[0]?.id || \'custom\');\n  const [customOwnerName, setCustomOwnerName] = useState<string>(\'\');\n  const [comboNotes, setComboNotes] = useState<string>(\'\');\n  const [comboType, setComboType] = useState<\'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\'>(\'Attack\');\n\n  const currentBlade = blades.find((b) => b.name === activeBlade) || blades[0];\n  const currentRatchet = ratchets.find((r) => r.name === activeRatchet) || ratchets[0];\n  const currentBit = bits.find((bt) => bt.name === activeBit) || bits[0];\n\n  const filteredParts = parts.filter((p) => {\n    if (selectedCategory === \'All\') return true;\n    return p.type === selectedCategory;\n  });\n\n  const filteredCombos = registeredCombos.filter((c) => {\n    const matchesType = comboFilterType === \'All\' || c.type === comboFilterType;\n    const matchesBlader =\n      comboFilterBlader === \'All\' ||\n      c.bladerId === comboFilterBlader ||\n      c.bladerName.toLowerCase() === comboFilterBlader.toLowerCase();\n    return matchesType && matchesBlader;\n  });\n\n  // Calculate dynamic stats if parts are configured\n  const getStats = () => {\n    if (!currentBlade && !currentRatchet && !currentBit) {\n      return { attack: 0, defense: 0, stamina: 0, dash: 0, weightTotal: \'0.0\' };\n    }\n\n    const bName = currentBlade?.name || \'\';\n    const btName = currentBit?.name || \'\';\n\n    const isAttack =\n      currentBlade?.category === \'Attack\' ||\n      bName.toLowerCase().includes(\'dran\') ||\n      bName.toLowerCase().includes(\'shark\') ||\n      bName.toLowerCase().includes(\'phoenix\') ||\n      bName.toLowerCase().includes(\'drake\');\n\n    const isDefense =\n      currentBlade?.category === \'Defense\' ||\n      bName.toLowerCase().includes(\'knight\') ||\n      btName.toLowerCase().includes(\'needle\') ||\n      btName.toLowerCase().includes(\'hexa\');\n\n    const isStamina =\n      currentBlade?.category === \'Stamina\' ||\n      bName.toLowerCase().includes(\'wizard\') ||\n      btName.toLowerCase().includes(\'ball\');\n\n    const attack = isAttack ? 95 : isDefense ? 40 : isStamina ? 30 : 65;\n    const defense = isDefense ? 90 : isAttack ? 35 : isStamina ? 50 : 60;\n    const stamina = isStamina ? 92 : isDefense ? 65 : isAttack ? 30 : 60;\n    const dash = btName.toLowerCase().includes(\'flat\') ? 98 : btName.toLowerCase().includes(\'taper\') ? 75 : 50;\n\n    const parseW = (wStr?: string) => parseFloat(wStr?.replace(\'g\', \'\') || \'0\') || 0;\n    const weightTotal = (\n      (currentBlade ? parseW(currentBlade.weight) || 35.0 : 0) +\n      (currentRatchet ? parseW(currentRatchet.weight) || 6.5 : 0) +\n      (currentBit ? parseW(currentBit.weight) || 2.3 : 0)\n    ).toFixed(1);\n\n    return { attack, defense, stamina, dash, weightTotal };\n  };\n\n  const stats = getStats();\n\n  const handleCreatePart = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newName.trim()) return;\n\n    soundManager.playClick();\n    const newPart: BeybladePart = {\n      name: newName.trim(),\n      type: newType,\n      category: newCategory,\n      weight: newWeight.trim() ? `${newWeight.trim()}${newWeight.includes(\'g\') ? \'\' : \'g\'}` : undefined,\n      description: newDescription.trim() || undefined\n    };\n\n    onAddPart(newPart);\n\n    if (newType === \'Blade\') setActiveBlade(newPart.name);\n    if (newType === \'Ratchet\') setActiveRatchet(newPart.name);\n    if (newType === \'Bit\') setActiveBit(newPart.name);\n\n    setNewName(\'\');\n    setNewWeight(\'\');\n    setNewDescription(\'\');\n    setShowAddPartModal(false);\n  };\n\n  const handleSaveCurrentCombo = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!currentBlade || !currentRatchet || !currentBit) return;\n\n    soundManager.playScore();\n\n    let bladerName = \'\';\n    let bladerId: string | undefined = undefined;\n\n    if (selectedOwnerId === \'custom\' || !selectedOwnerId) {\n      bladerName = customOwnerName.trim() || \'Blader C\303\272cuta\';\n    } else {\n      const found = bladers.find((b) => b.id === selectedOwnerId);\n      bladerName = found?.name || \'Blader C\303\272cuta\';\n      bladerId = found?.id;\n    }\n\n    const newCombo: RegisteredCombo = {\n      id: `combo-${Date.now()}`,\n      bladerId,\n      bladerName,\n      blade: currentBlade.name,\n      ratchet: currentRatchet.name,\n      bit: currentBit.name,\n      type: comboType,\n      weight: `${stats.weightTotal}g`,\n      notes: comboNotes.trim() || undefined,\n      createdAt: new Date().toISOString()\n    };\n\n    onAddCombo(newCombo);\n    setShowAddComboModal(false);\n    setComboNotes(\'\');\n    setCustomOwnerName(\'\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-slate-200 dark:border-white/10 pb-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <h1 className=\"font-headline font-black text-3xl md:text-5xl text-slate-900 dark:text-white uppercase tracking-tight\">\n              EQUIPAMIENTO & COMBOS X\n            </h1>\n            <span className=\"hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#04A8FC]/10 text-[#04A8FC] text-[10px] font-headline font-bold uppercase border border-[#04A8FC]/20\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#04A8FC] animate-pulse\"></span>\n              Supabase DB\n            </span>\n          </div>\n          <p className=\"font-body-text text-base text-slate-600 dark:text-slate-400\">\n            Armero oficial de piezas Takara Tomy / Hasbro y registro de combos personalizados por Blader.\n          </p>\n        </div>\n\n        {/* Action Buttons */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <button\n            onClick={() => {\n              soundManager.playClick();\n              setShowAddComboModal(true);\n            }}\n            className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-4 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02] active:scale-95\"\n          >\n            <span className=\"material-symbols-outlined text-base\">save</span>\n            <span>Registrar Combo de Blader</span>\n          </button>\n\n          <button\n            onClick={() => {\n              soundManager.playClick();\n              setShowAddPartModal(true);\n            }}\n            className=\"bg-slate-800 hover:bg-slate-700 text-white dark:bg-white/10 dark:hover:bg-white/20 px-4 py-2.5 rounded-xl font-headline font-bold text-xs uppercase flex items-center gap-1.5 transition-all\"\n          >\n            <span className=\"material-symbols-outlined text-base\">add_circle</span>\n            <span>Nueva Pieza</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Tabs Navigation */}\n      <div className=\"flex items-center gap-2 p-1.5 bg-slate-200/80 dark:bg-white/5 rounded-2xl w-fit\">\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'combos\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 transition-all ${\n            activeTab === \'combos\'\n              ? \'bg-[#04A8FC] text-white shadow-md\'\n              : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm\">view_in_ar</span>\n          <span>Combos de la Comunidad ({registeredCombos.length})</span>\n        </button>\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'parts\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 transition-all ${\n            activeTab === \'parts\'\n              ? \'bg-[#04A8FC] text-white shadow-md\'\n              : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm\">precision_manufacturing</span>\n          <span>Cat\303\241logo de Piezas ({parts.length})</span>\n        </button>\n      </div>\n\n      {/* TAB 1: COMBOS & BUILDER */}\n      {activeTab === \'combos\' && (\n        <div className=\"space-y-8\">\n          {/* Combo Builder Studio (Top Bento) */}\n          <div className=\"glass-panel p-6 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm relative overflow-hidden bg-white dark:bg-[#15151c]\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n              {/* Visual Combo Display */}\n              <div className=\"lg:col-span-5 flex flex-col items-center text-center\">\n                <div className=\"w-52 h-52 rounded-2xl bg-slate-50 dark:bg-[#161620] border-2 border-[#04A8FC] p-4 flex items-center justify-center shadow-lg shadow-[#04A8FC]/20 relative\">\n                  <BeybladeVisualizer\n                    bladeName={currentBlade?.name || \'Custom Blade\'}\n                    ratchetName={currentRatchet?.name || \'3-60\'}\n                    bitName={currentBit?.name || \'F\'}\n                    size=\"lg\"\n                  />\n                  <div className=\"absolute -bottom-3 bg-[#04A8FC] text-white text-[10px] font-label-caps uppercase px-3 py-1 rounded-full font-black tracking-widest shadow\">\n                    SIMULADOR XTREME\n                  </div>\n                </div>\n                <h3 className=\"font-headline font-black text-2xl uppercase text-slate-900 dark:text-white mt-5\">\n                  {currentBlade?.name || \'Blade\'} {currentRatchet?.name || \'Ratchet\'} {currentBit?.name?.split(\' \')[0] || \'Bit\'}\n                </h3>\n                <p className=\"font-label-caps text-xs text-slate-500 dark:text-slate-400 uppercase font-bold\">\n                  Peso Estimado Total: <span className=\"text-[#0284c7] dark:text-[#04A8FC] font-black\">{stats.weightTotal}g</span>\n                </p>\n                <button\n                  onClick={() => setShowAddComboModal(true)}\n                  className=\"mt-3 px-4 py-1.5 bg-[#04A8FC]/15 hover:bg-[#04A8FC]/25 text-[#04A8FC] font-headline font-bold text-xs uppercase rounded-lg border border-[#04A8FC]/30 transition-all flex items-center gap-1\"\n                >\n                  <span className=\"material-symbols-outlined text-sm\">person_add</span>\n                  <span>Asignar este combo a un Blader</span>\n                </button>\n              </div>\n\n              {/* Selectors & Performance Radar */}\n              <div className=\"lg:col-span-7 space-y-6\">\n                {/* Parts Selectors */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div>\n                    <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                      1. Blade (Capa de Metal)\n                    </label>\n                    <select\n                      value={currentBlade?.name || \'\'}\n                      onChange={(e) => {\n                        soundManager.playClick();\n                        setActiveBlade(e.target.value);\n                      }}\n                      className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                    >\n                      {blades.map((b) => (\n                        <option key={b.name} value={b.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                          {b.name} {b.weight ? `(${b.weight})` : \'\'}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                      2. Ratchet (Trinquete)\n                    </label>\n                    <select\n                      value={currentRatchet?.name || \'\'}\n                      onChange={(e) => {\n                        soundManager.playClick();\n                        setActiveRatchet(e.target.value);\n                      }}\n                      className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                    >\n                      {ratchets.map((r) => (\n                        <option key={r.name} value={r.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                          {r.name} {r.weight ? `(${r.weight})` : \'\'}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                      3. Bit (Punta de Engranaje)\n                    </label>\n                    <select\n                      value={currentBit?.name || \'\'}\n                      onChange={(e) => {\n                        soundManager.playClick();\n                        setActiveBit(e.target.value);\n                      }}\n                      className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                    >\n                      {bits.map((bt) => (\n                        <option key={bt.name} value={bt.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                          {bt.name}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n                </div>\n\n                {/* Performance Stats Bars */}\n                <div className=\"space-y-3 pt-2\">\n                  <h4 className=\"font-headline font-bold text-xs uppercase text-slate-500 dark:text-slate-400 tracking-wider\">\n                    M\303\251tricas de Rendimiento en Estadio\n                  </h4>\n\n                  {/* Attack */}\n                  <div>\n                    <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                      <span className=\"font-bold text-[#DC2626] dark:text-[#f87171]\">Poder de Ataque</span>\n                      <span className=\"font-bold text-[#DC2626] dark:text-[#f87171]\">{stats.attack} / 100</span>\n                    </div>\n                    <div className=\"h-2 w-full bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                      <div\n                        className=\"h-full bg-[#DC2626] dark:bg-[#f87171] transition-all duration-300\"\n                        style={{ width: `${stats.attack}%` }}\n                      ></div>\n                    </div>\n                  </div>\n\n                  {/* Defense */}\n                  <div>\n                    <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                      <span className=\"font-bold text-emerald-600 dark:text-emerald-400\">Defensa & Retenci\303\263n</span>\n                      <span className=\"font-bold text-emerald-600 dark:text-emerald-400\">{stats.defense} / 100</span>\n                    </div>\n                    <div className=\"h-2 w-full bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                      <div\n                        className=\"h-full bg-emerald-500 transition-all duration-300\"\n                        style={{ width: `${stats.defense}%` }}\n                      ></div>\n                    </div>\n                  </div>\n\n                  {/* Stamina */}\n                  <div>\n                    <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                      <span className=\"font-bold text-[#0284c7] dark:text-[#04A8FC]\">Resistencia Centr\303\255fuga</span>\n                      <span className=\"font-bold text-[#0284c7] dark:text-[#04A8FC]\">{stats.stamina} / 100</span>\n                    </div>\n                    <div className=\"h-2 w-full bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                      <div\n                        className=\"h-full bg-[#04A8FC] transition-all duration-300\"\n                        style={{ width: `${stats.stamina}%` }}\n                      ></div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Registered Community Combos Section */}\n          <div className=\"space-y-4\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div>\n                <h3 className=\"font-headline font-black text-xl md:text-2xl uppercase text-slate-900 dark:text-white\">\n                  COMBOS REGISTRADOS DE LA COMUNIDAD\n                </h3>\n                <p className=\"font-body-text text-xs text-slate-500 dark:text-slate-400\">\n                  Armamento y combinaciones oficiales vinculadas a cada Blader.\n                </p>\n              </div>\n\n              {/* Filters */}\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <select\n                  value={comboFilterType}\n                  onChange={(e) => setComboFilterType(e.target.value)}\n                  className=\"bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold uppercase text-slate-700 dark:text-slate-300 shadow-sm\"\n                >\n                  <option value=\"All\">Todos los Tipos</option>\n                  <option value=\"Attack\">Ataque</option>\n                  <option value=\"Defense\">Defensa</option>\n                  <option value=\"Stamina\">Resistencia</option>\n                  <option value=\"Balance\">Equilibrio</option>\n                </select>\n\n                <select\n                  value={comboFilterBlader}\n                  onChange={(e) => setComboFilterBlader(e.target.value)}\n                  className=\"bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold uppercase text-slate-700 dark:text-slate-300 shadow-sm\"\n                >\n                  <option value=\"All\">Todos los Bladers</option>\n                  {bladers.map((b) => (\n                    <option key={b.id} value={b.id}>\n                      {b.name}\n                    </option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {filteredCombos.length === 0 ? (\n              <div className=\"glass-panel p-10 rounded-2xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-3 bg-white dark:bg-[#15151c]\">\n                <div className=\"w-12 h-12 rounded-xl bg-[#04A8FC]/10 text-[#04A8FC] flex items-center justify-center mx-auto\">\n                  <span className=\"material-symbols-outlined text-2xl\">style</span>\n                </div>\n                <h4 className=\"font-headline font-bold text-sm uppercase text-slate-900 dark:text-white\">\n                  No hay combos guardados con estos filtros\n                </h4>\n                <p className=\"text-xs text-slate-500 max-w-sm mx-auto\">\n                  Usa el simulador superior para armar un combo y presiona &ldquo;Registrar Combo de Blader&rdquo;.\n                </p>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                {filteredCombos.map((combo) => {\n                  const ownerBlader = bladers.find((b) => b.id === combo.bladerId);\n                  return (\n                    <div\n                      key={combo.id}\n                      className=\"glass-panel p-5 rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#15151c] shadow-sm hover:border-[#04A8FC] transition-all space-y-4 group relative\"\n                    >\n                      {/* Owner Header */}\n                      <div className=\"flex items-center justify-between border-b border-slate-100 dark:border-white/5 pb-3\">\n                        <div className=\"flex items-center gap-2.5\">\n                          <BladerAvatar blader={ownerBlader} size=\"sm\" />\n                          <div>\n                            <span className=\"text-[10px] font-label-caps uppercase text-slate-500 block font-bold\">\n                              Due\303\261o del Combo\n                            </span>\n                            <h5 className=\"font-headline font-black text-sm uppercase text-slate-900 dark:text-white\">\n                              {combo.bladerName}\n                            </h5>\n                          </div>\n                        </div>\n\n                        <div className=\"flex items-center gap-1.5\">\n                          <span\n                            className={`px-2 py-0.5 rounded-md text-[10px] font-headline font-black uppercase ${\n                              combo.type === \'Attack\'\n                                ? \'bg-red-500/10 text-red-600 dark:text-red-400\'\n                                : combo.type === \'Defense\'\n                                ? \'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400\'\n                                : combo.type === \'Stamina\'\n                                ? \'bg-blue-500/10 text-blue-600 dark:text-blue-400\'\n                                : \'bg-purple-500/10 text-purple-600 dark:text-purple-400\'\n                            }`}\n                          >\n                            {combo.type}\n                          </span>\n                          <button\n                            onClick={() => {\n                              soundManager.playClick();\n                              onDeleteCombo(combo.id);\n                            }}\n                            className=\"text-slate-400 hover:text-red-500 p-1 rounded transition-colors opacity-0 group-hover:opacity-100\"\n                            title=\"Eliminar combo\"\n                          >\n                            <span className=\"material-symbols-outlined text-sm\">delete</span>\n                          </button>\n                        </div>\n                      </div>\n\n                      {/* Visual & Specs */}\n                      <div className=\"flex items-center gap-4\">\n                        <div className=\"w-16 h-16 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center flex-shrink-0\">\n                          <BeybladeVisualizer\n                            bladeName={combo.blade}\n                            ratchetName={combo.ratchet}\n                            bitName={combo.bit}\n                            size=\"sm\"\n                          />\n                        </div>\n                        <div className=\"space-y-1 min-w-0\">\n                          <h4 className=\"font-headline font-black text-base uppercase text-slate-900 dark:text-white truncate\">\n                            {combo.blade}\n                          </h4>\n                          <div className=\"flex items-center gap-2 text-xs font-mono font-bold text-slate-600 dark:text-slate-300\">\n                            <span className=\"bg-slate-100 dark:bg-white/10 px-1.5 py-0.5 rounded\">\n                              {combo.ratchet}\n                            </span>\n                            <span className=\"bg-slate-100 dark:bg-white/10 px-1.5 py-0.5 rounded\">\n                              {combo.bit}\n                            </span>\n                            {combo.weight && (\n                              <span className=\"text-[#04A8FC] font-black\">{combo.weight}</span>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* Notes if any */}\n                      {combo.notes && (\n                        <p className=\"text-xs text-slate-500 dark:text-slate-400 font-body-text italic border-t border-slate-100 dark:border-white/5 pt-2\">\n                          &ldquo;{combo.notes}&rdquo;\n                        </p>\n                      )}\n                    </div>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: PIECES CATALOG */}\n      {activeTab === \'parts\' && (\n        <div className=\"space-y-6\">\n          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-200 dark:border-white/10 pb-4\">\n            <h3 className=\"font-headline font-black text-xl uppercase text-slate-900 dark:text-white\">\n              ARMERO DE PIEZAS HOMOLOGADAS\n            </h3>\n\n            {/* Category Filter Pills */}\n            <div className=\"flex flex-wrap gap-2\">\n              {([\'All\', \'Blade\', \'Ratchet\', \'Bit\'] as const).map((cat) => (\n                <button\n                  key={cat}\n                  onClick={() => {\n                    soundManager.playClick();\n                    setSelectedCategory(cat);\n                  }}\n                  className={`px-3.5 py-1.5 rounded-xl text-xs font-headline font-bold uppercase transition-all ${\n                    selectedCategory === cat\n                      ? \'bg-[#04A8FC] text-white shadow-sm font-black\'\n                      : \'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-gray-400 hover:text-slate-900 dark:hover:text-white\'\n                  }`}\n                >\n                  {cat === \'All\' ? \'Todas\' : cat}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Parts Grid */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {filteredParts.map((part) => (\n              <div\n                key={part.name}\n                className=\"p-4 rounded-2xl border border-slate-200 dark:border-white/5 bg-white dark:bg-[#15151c] hover:border-[#04A8FC] transition-all space-y-2 relative group shadow-sm\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span\n                    className={`text-[10px] font-label-caps font-black px-2 py-0.5 rounded-lg uppercase ${\n                      part.type === \'Blade\'\n                        ? \'bg-red-500/10 text-red-600 dark:text-red-400\'\n                        : part.type === \'Ratchet\'\n                        ? \'bg-amber-500/10 text-amber-600 dark:text-amber-400\'\n                        : \'bg-blue-500/10 text-blue-600 dark:text-blue-400\'\n                    }`}\n                  >\n                    {part.type} {part.category ? `\342\200\242 ${part.category}` : \'\'}\n                  </span>\n                  <div className=\"flex items-center gap-2\">\n                    {part.weight && (\n                      <span className=\"font-mono text-xs font-bold text-slate-500 dark:text-slate-400\">\n                        {part.weight}\n                      </span>\n                    )}\n                    <button\n                      onClick={() => {\n                        soundManager.playClick();\n                        onDeletePart(part.name);\n                      }}\n                      className=\"opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 p-0.5 rounded transition-opacity\"\n                      title=\"Eliminar pieza\"\n                    >\n                      <span className=\"material-symbols-outlined text-sm\">delete</span>\n                    </button>\n                  </div>\n                </div>\n\n                <h4 className=\"font-headline font-bold text-base uppercase text-slate-900 dark:text-white\">\n                  {part.name}\n                </h4>\n                {part.description && (\n                  <p className=\"text-xs text-slate-600 dark:text-gray-400 font-body-text leading-relaxed\">\n                    {part.description}\n                  </p>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Modal to Save/Register Combo by Blader */}\n      {showAddComboModal && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl space-y-5\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 dark:border-white/10 pb-3\">\n              <div>\n                <h3 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                  REGISTRAR COMBO PARA BLADER\n                </h3>\n                <p className=\"text-xs text-slate-500\">\n                  Asigna esta configuraci\303\263n de Beyblade al arsenal del Blader en Supabase.\n                </p>\n              </div>\n              <button\n                onClick={() => setShowAddComboModal(false)}\n                className=\"w-8 h-8 rounded-full bg-slate-100 dark:bg-white/10 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleSaveCurrentCombo} className=\"space-y-4\">\n              {/* Combo Summary */}\n              <div className=\"p-3.5 rounded-2xl bg-[#04A8FC]/10 border border-[#04A8FC]/30 flex items-center justify-between\">\n                <div>\n                  <span className=\"text-[10px] font-label-caps uppercase text-[#04A8FC] font-bold block\">\n                    Configuraci\303\263n Seleccionada\n                  </span>\n                  <span className=\"font-headline font-black text-sm uppercase text-slate-900 dark:text-white\">\n                    {currentBlade?.name} {currentRatchet?.name} {currentBit?.name}\n                  </span>\n                </div>\n                <span className=\"font-mono text-xs font-black text-[#04A8FC]\">\n                  {stats.weightTotal}g\n                </span>\n              </div>\n\n              {/* Select Blader Owner */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Blader Propietario / Due\303\261o del Combo *\n                </label>\n                <select\n                  value={selectedOwnerId}\n                  onChange={(e) => setSelectedOwnerId(e.target.value)}\n                  className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm font-headline font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                >\n                  {bladers.map((b) => (\n                    <option key={b.id} value={b.id}>\n                      {b.name} ({b.team})\n                    </option>\n                  ))}\n                  <option value=\"custom\">+ Escribir otro nombre de Blader</option>\n                </select>\n              </div>\n\n              {selectedOwnerId === \'custom\' && (\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                    Nombre del Blader\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={customOwnerName}\n                    onChange={(e) => setCustomOwnerName(e.target.value)}\n                    placeholder=\"Ej. Dylan Bautista\"\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                  />\n                </div>\n              )}\n\n              {/* Combo Archetype */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Tipo de Estrategia\n                </label>\n                <div className=\"grid grid-cols-4 gap-2\">\n                  {([\'Attack\', \'Defense\', \'Stamina\', \'Balance\'] as const).map((t) => (\n                    <button\n                      key={t}\n                      type=\"button\"\n                      onClick={() => setComboType(t)}\n                      className={`py-2 rounded-xl text-xs font-headline font-bold uppercase transition-all ${\n                        comboType === t\n                          ? \'bg-[#04A8FC] text-white shadow-sm font-black\'\n                          : \'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400 hover:bg-slate-200\'\n                      }`}\n                    >\n                      {t === \'Attack\'\n                        ? \'Ataque\'\n                        : t === \'Defense\'\n                        ? \'Defensa\'\n                        : t === \'Stamina\'\n                        ? \'Resistencia\'\n                        : \'Equilibrio\'}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Notes */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Notas de Lanzamiento / Rendimiento (Opcional)\n                </label>\n                <textarea\n                  rows={2}\n                  value={comboNotes}\n                  onChange={(e) => setComboNotes(e.target.value)}\n                  placeholder=\"Ej. Lanzamiento en \303\241ngulo plano para enganche agresivo al X-Celerator Rail.\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-body-text focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddComboModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase font-bold text-slate-600 hover:text-slate-900 dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-black uppercase shadow-md transition-all active:scale-95\"\n                >\n                  Guardar en Base de Datos\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* Modal to register new piece */}\n      {showAddPartModal && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 dark:border-white/10 pb-3\">\n              <h3 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                Registrar Nueva Pieza\n              </h3>\n              <button\n                onClick={() => setShowAddPartModal(false)}\n                className=\"text-slate-400 hover:text-slate-900 dark:hover:text-white font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleCreatePart} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                  Nombre de la Pieza *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={newName}\n                  onChange={(e) => setNewName(e.target.value)}\n                  placeholder=\"Ej. Cobalt Dragoon, 7-60, Cyclone\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Tipo de Componente\n                  </label>\n                  <select\n                    value={newType}\n                    onChange={(e) => setNewType(e.target.value as \'Blade\' | \'Ratchet\' | \'Bit\')}\n                    className=\"w-full bg-white dark:bg-[#15151c] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                  >\n                    <option value=\"Blade\">Blade (Capa Metal)</option>\n                    <option value=\"Ratchet\">Ratchet (Trinquete)</option>\n                    <option value=\"Bit\">Bit (Punta)</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Arquetipo / Categor\303\255a\n                  </label>\n                  <select\n                    value={newCategory}\n                    onChange={(e) => setNewCategory(e.target.value as \'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\')}\n                    className=\"w-full bg-white dark:bg-[#15151c] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                  >\n                    <option value=\"Attack\">Ataque (Attack)</option>\n                    <option value=\"Defense\">Defensa (Defense)</option>\n                    <option value=\"Stamina\">Resistencia (Stamina)</option>\n                    <option value=\"Balance\">Equilibrio (Balance)</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                  Peso (g)\n                </label>\n                <input\n                  type=\"text\"\n                  value={newWeight}\n                  onChange={(e) => setNewWeight(e.target.value)}\n                  placeholder=\"Ej. 35.0g\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                  Descripci\303\263n o Funci\303\263n\n                </label>\n                <textarea\n                  rows={2}\n                  value={newDescription}\n                  onChange={(e) => setNewDescription(e.target.value)}\n                  placeholder=\"Detalles sobre el dise\303\261o, agarre al riel Xtreme o comportamiento.\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-body-text focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddPartModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase font-bold text-slate-600 hover:text-slate-900 dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-black uppercase shadow-sm\"\n                >\n                  Guardar Pieza\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
