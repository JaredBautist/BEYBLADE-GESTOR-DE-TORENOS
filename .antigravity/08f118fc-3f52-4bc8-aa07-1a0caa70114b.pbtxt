          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    onClick={() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      const sql = `-- SCRIPT SUPABASE BEYBLADE SAAS"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS community_config ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id TEXT PRIMARY KEY DEFAULT \'main_config\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  league_name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  community_tagline TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  community_city TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  organizer_name TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  tournament_name TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  season TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  logo_url TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  type TEXT DEFAULT \'elimination\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  battle_scale TEXT DEFAULT \'3v3\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  victory_conditions JSONB,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  max_participants INTEGER DEFAULT 32,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  arena_status TEXT DEFAULT \'Xtreme Stadium A\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  is_started BOOLEAN DEFAULT FALSE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  updated_at TIMESTAMPTZ DEFAULT NOW()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "ALTER TABLE community_config DISABLE ROW LEVEL SECURITY;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "GRANT ALL ON TABLE community_config TO anon, authenticated, service_role;`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      navigator.clipboard.writeText(sql);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      soundManager.playClick();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      triggerSave(formData, \'\302\241SQL copiado al portapapeles!\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    }}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    className=\"px-2.5 py-1 bg-[#04A8FC] hover:bg-[#0096e6] text-white text-[11px] font-headline font-bold rounded-lg transition-all\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  >"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    Copiar SQL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
