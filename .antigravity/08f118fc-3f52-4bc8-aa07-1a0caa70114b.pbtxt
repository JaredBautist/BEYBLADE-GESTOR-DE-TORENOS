    replacement_infos {
      original_chunk {
        target_content: "import { Blader, BeybladePart, TournamentConfig, Match } from \'../types\';\n\nexport const INITIAL_BEYBLADE_PARTS: BeybladePart[] = [\n  // Blades\n  { name: \'Dransword\', type: \'Blade\', category: \'Attack\', weight: \'35.0g\', description: \'Tres hojas gruesas para ataques superiores directos y lanzamiento de retroceso.\' },\n  { name: \'Dran Dagger\', type: \'Blade\', category: \'Attack\', weight: \'35.5g\', description: \'Seis hojas afiladas con aceleraci\303\263n m\303\241xima en la l\303\255nea Xtreme.\' },\n  { name: \'Dran Buster\', type: \'Blade\', category: \'Attack\', weight: \'38.0g\', description: \'Poder de un solo golpe masivo enfocado en una espada gigante.\' },\n  { name: \'Hellscythe\', type: \'Blade\', category: \'Balance\', weight: \'33.5g\', description: \'Forma sim\303\251trica para contraataques letales y conservaci\303\263n de giro.\' },\n  { name: \'Hells Chain\', type: \'Blade\', category: \'Balance\', weight: \'34.8g\', description: \'Estructura de cadenas entrelazadas para absorci\303\263n de impactos.\' },\n  { name: \'Hells Hammer\', type: \'Blade\', category: \'Balance\', weight: \'36.0g\', description: \'Golpes descendentes implacables para desestabilizar al oponente.\' },\n  { name: \'Wizardarrow\', type: \'Blade\', category: \'Stamina\', weight: \'32.0g\', description: \'Dise\303\261o aerodin\303\241mico circular con m\303\241xima resistencia centr\303\255fuga.\' },\n  { name: \'Wizard Rod\', type: \'Blade\', category: \'Stamina\', weight: \'35.2g\', description: \'Distribuci\303\263n de masa perimetral superior que domina el centro del estadio.\' },\n  { name: \'Knight Shield\', type: \'Blade\', category: \'Defense\', weight: \'33.0g\', description: \'Escudo defensivo que desv\303\255a ataques frontales a gran velocidad.\' },\n  { name: \'Knight Lance\', type: \'Blade\', category: \'Defense\', weight: \'34.5g\', description: \'Puntas defensivas ascendentes que frenan el impulso rival.\' },\n  { name: \'Phoenix Wing\', type: \'Blade\', category: \'Attack\', weight: \'38.5g\', description: \'Hoja de metal pesada con tres alas dise\303\261adas para impacto destructor.\' },\n  { name: \'Shark Edge\', type: \'Blade\', category: \'Attack\', weight: \'34.0g\', description: \'Dos aletas dentadas dise\303\261adas para levantar al oponente fuera del estadio.\' },\n  { name: \'Cobalt Drake\', type: \'Blade\', category: \'Attack\', weight: \'38.2g\', description: \'Aleaci\303\263n especial pesada con dise\303\261o de drag\303\263n de combate.\' },\n  { name: \'Unicorn Sting\', type: \'Blade\', category: \'Balance\', weight: \'34.0g\', description: \'Combinaci\303\263n de ataque con cuerno y defensa de crin.\' },\n  { name: \'Viper Tail\', type: \'Blade\', category: \'Stamina\', weight: \'34.4g\', description: \'Giro descendente que agota la energ\303\255a del rival.\' },\n\n  // Ratchets\n  { name: \'3-60\', type: \'Ratchet\', weight: \'6.4g\', description: \'3 protuberancias bajas a 6.0mm de altura.\' },\n  { name: \'4-60\', type: \'Ratchet\', weight: \'6.5g\', description: \'4 protuberancias bajas equilibradas.\' },\n  { name: \'5-60\', type: \'Ratchet\', weight: \'6.8g\', description: \'5 protuberancias de peso distribuido.\' },\n  { name: \'1-60\', type: \'Ratchet\', weight: \'6.2g\', description: \'1 protuberancia asim\303\251trica con potencia exc\303\251ntrica.\' },\n  { name: \'3-80\', type: \'Ratchet\', weight: \'7.1g\', description: \'3 protuberancias altas a 8.0mm para ataque superior.\' },\n  { name: \'4-80\', type: \'Ratchet\', weight: \'7.2g\', description: \'4 protuberancias de altura elevada.\' },\n  { name: \'5-80\', type: \'Ratchet\', weight: \'7.4g\', description: \'5 protuberancias de m\303\241xima inercia.\' },\n  { name: \'7-60\', type: \'Ratchet\', weight: \'7.3g\', description: \'7 protuberancias ultra balanceadas.\' },\n  { name: \'9-60\', type: \'Ratchet\', weight: \'7.5g\', description: \'9 protuberancias con m\303\255nima resistencia.\' },\n\n  // Bits\n  { name: \'F (Flat)\', type: \'Bit\', category: \'Attack\', weight: \'2.2g\', description: \'Punta plana con agarre agresivo al engranaje Xtreme.\' },\n  { name: \'T (Taper)\', type: \'Bit\', category: \'Balance\', weight: \'2.3g\', description: \'Punta c\303\263nica con aceleraci\303\263n en el riel y calma en el centro.\' },\n  { name: \'B (Ball)\', type: \'Bit\', category: \'Stamina\', weight: \'2.4g\', description: \'Esfera lisa para un giro suave y ultra prolongado.\' },\n  { name: \'N (Needle)\', type: \'Bit\', category: \'Defense\', weight: \'2.1g\', description: \'Punta de aguja fija en el centro del estadio para absorci\303\263n de impactos.\' },\n  { name: \'P (Point)\', type: \'Bit\', category: \'Balance\', weight: \'2.3g\', description: \'Centro de aguja rodeado de borde plano para contraataques reactivos.\' },\n  { name: \'GF (Gear Flat)\', type: \'Bit\', category: \'Attack\', weight: \'2.5g\', description: \'Engranaje extendido para s\303\272per aceleraci\303\263n X-Dash.\' },\n  { name: \'GB (Gear Ball)\', type: \'Bit\', category: \'Stamina\', weight: \'2.5g\', description: \'Esfera con engranajes para reenganche continuo al riel.\' },\n  { name: \'HN (High Needle)\', type: \'Bit\', category: \'Defense\', weight: \'2.4g\', description: \'Aguja alta para evitar contacto con el suelo del estadio.\' },\n  { name: \'R (Rush)\', type: \'Bit\', category: \'Attack\', weight: \'2.3g\', description: \'Punta con muescas que generan patrones de ataque el\303\255pticos.\' },\n  { name: \'H (Hexa)\', type: \'Bit\', category: \'Defense\', weight: \'2.4g\', description: \'Punta hexagonal con gran estabilidad en impactos fuertes.\' }\n];"
