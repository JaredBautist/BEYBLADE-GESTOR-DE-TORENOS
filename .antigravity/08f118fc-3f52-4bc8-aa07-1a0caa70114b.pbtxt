*/}\n                  <div className=\"col-span-1 text-center\">\n                    <div className=\"font-headline font-black text-2xl text-[#1a1c1e] dark:text-white leading-none\">\n                      {match.scoreA} - {match.scoreB}\n                    </div>\n                    <span className=\"font-label-caps text-[9px] text-gray-400 uppercase\">\n                      VS\n                    </span>\n                  </div>\n\n                  {/* Blader B */}\n                  <div className=\"col-span-2 flex items-center justify-end gap-3 min-w-0 text-right flex-row-reverse\">\n                    <BladerAvatar blader={match.bladerB} size=\"sm\" cornerColor=\"blue\" />\n                    <div className=\"min-w-0\">\n                      <p className=\"font-headline font-bold text-sm uppercase text-[#1a1c1e] dark:text-white truncate\">\n                        {match.bladerB?.name || \'Esquina Azul\'}\n                      </p>\n                      <p className=\"font-label-caps text-[10px] text-gray-500 uppercase truncate\">\n                        {match.bladerB?.team || \'Solo\'}\n                      </p>\n                    </div>\n                  </div>\n                </div>"
