        target_content: "export async function deleteHistoryRecordFromSupabase(id: string) {\n  try {\n    await supabase.from(\'tournament_history\').delete().eq(\'id\', id);\n  } catch (e) {\n    console.warn(\'Supabase delete history warning:\', e);\n  }\n}"
        replacement_content: "export async function deleteHistoryRecordFromSupabase(id: string) {\n  try {\n    await supabase.from(\'tournament_history\').delete().eq(\'id\', id);\n  } catch (e) {\n    console.warn(\'Supabase delete history warning:\', e);\n  }\n}\n\n// -------------------------------------------------------------\n// COMMUNITY & TOURNAMENT CONFIG API (Multi-Comunidad SaaS)\n// -------------------------------------------------------------\nexport async function syncConfigToSupabase(config: TournamentConfig) {\n  try {\n    await supabase.from(\'community_config\').upsert({\n      id: \'main_config\',\n      league_name: config.leagueName,\n      community_tagline: config.communityTagline || \'C\303\232CUTA \342\200\242 OFICIAL\',\n      community_city: config.communityCity || \'C\303\272cuta\',\n      organizer_name: config.organizerName || \'Juez Oficial\',\n      tournament_name: config.name,\n      season: config.season,\n      logo_url: config.logoUrl || null,\n      type: config.type,\n      battle_scale: config.battleScale,\n      victory_conditions: config.victoryConditions,\n      max_participants: config.maxParticipants,\n      arena_status: config.arenaStatus,\n      is_started: config.isStarted,\n      updated_at: new Date().toISOString()\n    });\n  } catch (e) {\n    console.warn(\'Supabase sync config warning:\', e);\n  }\n}\n\nexport async function fetchConfigFromSupabase(): Promise<Partial<TournamentConfig> | null> {\n  try {\n    const { data, error } = await supabase\n      .from(\'community_config\')\n      .select(\'*\')\n      .eq(\'id\', \'main_config\')\n      .single();\n    if (error || !data) return null;\n    return {\n      name: data.tournament_name || data.name,\n      season: data.season,\n      leagueName: data.league_name,\n      communityTagline: data.community_tagline,\n      communityCity: data.community_city,\n      organizerName: data.organizer_name,\n      logoUrl: data.logo_url || undefined,\n      type: data.type,\n      battleScale: data.battle_scale,\n      victoryConditions: data.victory_conditions,\n      maxParticipants: data.max_participants,\n      arenaStatus: data.arena_status,\n      isStarted: data.is_started\n    };\n  } catch (e) {\n    console.warn(\'Supabase fetch config error:\', e);\n    return null;\n  }\n}\n"
      }
