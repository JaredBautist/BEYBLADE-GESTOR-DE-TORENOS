  file_change {
    absolute_path_uri: "file:///src/components/screens/BracketScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Blader, Match } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\nimport { BladerAvatar } from \'../BladerAvatar\';\n\ninterface BracketScreenProps {\n  bladers: Blader[];\n  matches: Match[];\n  onSelectMatchForConsole: (match: Match) => void;\n  onSetMatchWinner: (matchId: string, winnerId: string) => void;\n}\n\nexport const BracketScreen: React.FC<BracketScreenProps> = ({\n  bladers,\n  matches,\n  onSelectMatchForConsole,\n  onSetMatchWinner\n}) => {\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [zoomLevel, setZoomLevel] = useState<number>(1);\n\n  const qf1 = matches.find((m) => m.id === \'match-live\') || matches[0];\n  const qf2 = matches.find((m) => m.id === \'match-2\') || matches[1];\n  const qf3 = matches.find((m) => m.id === \'match-3\') || matches[2];\n  const qf4 = matches.find((m) => m.id === \'match-4\') || matches[3];\n\n  const getWinner = (match?: Match): Blader | null => {\n    if (!match || !match.winnerId) return null;\n    return bladers.find((b) => b.id === match.winnerId) || null;\n  };\n\n  const winnerQF1 = getWinner(qf1);\n  const winnerQF2 = getWinner(qf2);\n  const winnerQF3 = getWinner(qf3);\n  const winnerQF4 = getWinner(qf4);\n\n  // Virtual Semifinals\n  const sf1BladerA = winnerQF1 || qf1?.bladerA || bladers[1];\n  const sf1BladerB = winnerQF2 || qf2?.bladerA || bladers[0];\n  const sf2BladerA = winnerQF3 || qf3?.bladerA || bladers[4];\n  const sf2BladerB = winnerQF4 || qf4?.bladerA || bladers[6];\n\n  // Finalists\n  const finalBladerA = sf1BladerA;\n  const finalBladerB = sf2BladerA;\n\n  // Champion\n  const champion = winnerQF2 || bladers[0];\n\n  const handleCopyLink = () => {\n    soundManager.playClick();\n    if (typeof navigator !== \'undefined\' && navigator.clipboard) {\n      navigator.clipboard.writeText(window.location.href);\n    }\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 2500);\n  };\n\n  const renderMatchNode = (\n    matchTitle: string,\n    bladerA: Blader | null,\n    bladerB: Blader | null,\n    scoreA: number,\n    scoreB: number,\n    status: \'upcoming\' | \'live\' | \'finished\',\n    winnerId: string | null,\n    originalMatch?: Match\n  ) => {\n    const isLive = status === \'live\';\n    const isFinished = status === \'finished\';\n\n    return (\n      <div className=\"glass-panel p-3.5 rounded-xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm relative group hover:border-[#04A8FC] transition-all bg-white/90 dark:bg-[#15151c]/90 w-full min-w-[240px]\">\n        {/* Node Header */}\n        <div className=\"flex items-center justify-between text-[10px] font-label-caps uppercase font-bold text-gray-500 dark:text-gray-400 mb-2 border-b border-[#bec7d3]/30 dark:border-white/10 pb-1\">\n          <span>{matchTitle}</span>\n          <span\n            className={`px-1.5 py-0.5 rounded text-[9px] font-black ${\n              isLive\n                ? \'bg-[#39FF14] text-black animate-pulse\'\n                : isFinished\n                ? \'bg-blue-600 text-white\'\n                : \'bg-black/10 dark:bg-white/10 text-gray-500\'\n            }`}\n          >\n            {isLive ? \'EN VIVO\' : isFinished ? \'FINAL\' : \'PROGRAMADO\'}\n          </span>\n        </div>\n\n        {/* Blader A Slot */}\n        <div\n          onClick={() => {\n            if (originalMatch && bladerA) {\n              onSetMatchWinner(originalMatch.id, bladerA.id);\n            }\n          }}\n          className={`flex items-center justify-between p-1.5 rounded-lg mb-1 cursor-pointer transition-all ${\n            winnerId === bladerA?.id\n              ? \'bg-[#04A8FC]/20 font-black text-[#04A8FC]\'\n              : \'hover:bg-black/5 dark:hover:bg-white/5\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <BladerAvatar blader={bladerA} size=\"xs\" cornerColor=\"red\" />\n            <span className=\"font-headline font-bold text-xs uppercase text-[#1a1c1e] dark:text-white truncate\">\n              {bladerA?.name || \'TBD\'}\n            </span>\n          </div>\n          <span className=\"font-headline font-black text-xs text-[#AC191F] px-1.5\">\n            {scoreA}\n          </span>\n        </div>\n\n        {/* Blader B Slot */}\n        <div\n          onClick={() => {\n            if (originalMatch && bladerB) {\n              onSetMatchWinner(originalMatch.id, bladerB.id);\n            }\n          }}\n          className={`flex items-center justify-between p-1.5 rounded-lg cursor-pointer transition-all ${\n            winnerId === bladerB?.id\n              ? \'bg-[#04A8FC]/20 font-black text-[#04A8FC]\'\n              : \'hover:bg-black/5 dark:hover:bg-white/5\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <BladerAvatar blader={bladerB} size=\"xs\" cornerColor=\"blue\" />\n            <span className=\"font-headline font-bold text-xs uppercase text-[#1a1c1e] dark:text-white truncate\">\n              {bladerB?.name || \'TBD\'}\n            </span>\n          </div>\n          <span className=\"font-headline font-black text-xs text-[#04A8FC] px-1.5\">\n            {scoreB}\n          </span>\n        </div>\n\n        {/* Quick action: Load in console */}\n        {originalMatch && (\n          <button\n            onClick={() => {\n              soundManager.playClick();\n              onSelectMatchForConsole(originalMatch);\n            }}\n            className=\"w-full mt-2 pt-1 border-t border-[#bec7d3]/20 dark:border-white/5 text-[10px] font-label-caps uppercase text-[#04A8FC] hover:underline flex items-center justify-center gap-1\"\n          >\n            <span className=\"material-symbols-outlined text-xs\">sports_kabaddi</span>\n            <span>Cargar en Consola</span>\n          </button>\n        )}\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <div>\n          <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n            TOURNAMENT BRACKET\n          </h1>\n          <p className=\"font-body-text text-base text-gray-600 dark:text-gray-400\">\n            Eliminaci\303\263n directa oficial Takara Tomy / Hasbro WBO Standard.\n          </p>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"glass-panel px-2 py-1 rounded-xl flex items-center gap-1 border-[#bec7d3]/30\">\n            <button\n              onClick={() => setZoomLevel((z) => Math.max(0.7, z - 0.1))}\n              className=\"p-1 text-gray-500 hover:text-black dark:hover:text-white\"\n              title=\"Reducir Zoom\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">remove</span>\n            </button>\n            <span className=\"text-[10px] font-mono text-gray-500 px-1 font-bold\">\n              {Math.round(zoomLevel * 100)}%\n            </span>\n            <button\n              onClick={() => setZoomLevel((z) => Math.min(1.3, z + 0.1))}\n              className=\"p-1 text-gray-500 hover:text-black dark:hover:text-white\"\n              title=\"Aumentar Zoom\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">add</span>\n            </button>\n          </div>\n\n          <button\n            onClick={handleCopyLink}\n            className=\"bg-white dark:bg-[#1f1f25] border border-[#04A8FC] text-[#04A8FC] dark:text-white px-3.5 py-2 rounded-xl text-xs font-label-caps uppercase tracking-wider flex items-center gap-1.5 hover:bg-[#04A8FC]/10 transition-all shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">\n              {copiedLink ? \'check\' : \'share\'}\n            </span>\n            <span>{copiedLink ? \'\302\241Enlace Copiado!\' : \'Compartir Bracket\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Podium Champion Card */}\n      <div className=\"glass-panel p-6 rounded-2xl border border-amber-400/40 dark:border-amber-400/20 bg-gradient-to-r from-amber-500/10 via-yellow-500/5 to-transparent shadow-md\">\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-6\">\n          <div className=\"flex items-center gap-4 text-center sm:text-left\">\n            <BladerAvatar blader={champion} size=\"xl\" cornerColor=\"gold\" />\n            <div>\n              <div className=\"flex items-center justify-center sm:justify-start gap-1.5 text-amber-500 font-black font-label-caps text-xs uppercase tracking-widest\">\n                <span className=\"material-symbols-outlined text-base\">military_tech</span>\n                <span>L\303\215DER DEL BRACKET</span>\n              </div>\n              <h2 className=\"font-headline font-black text-2xl md:text-3xl uppercase text-[#1a1c1e] dark:text-white\">\n                {champion?.name || \'Jaxon Storm\'}\n              </h2>\n              <p className=\"font-label-caps text-xs text-gray-500 dark:text-gray-400 uppercase\">\n                {champion?.combos[0]?.name || \'Dransword 3-60F\'} \342\200\242 {champion?.team}\n              </p>\n            </div>\n          </div>\n\n          {/* Podium Badges */}\n          <div className=\"flex items-center gap-3 font-label-caps text-xs uppercase\">\n            <div className=\"text-center p-2.5 rounded-xl bg-white dark:bg-[#1a1a24] border border-amber-400 shadow-sm min-w-[90px]\">\n              <span className=\"text-amber-500 font-black block text-sm\">\360\237\245\207 1\302\272 LUGAR</span>\n              <span className=\"font-bold text-[#1a1c1e] dark:text-white text-[11px] truncate block max-w-[85px]\">\n                {champion?.name}\n              </span>\n            </div>\n            <div className=\"text-center p-2.5 rounded-xl bg-white dark:bg-[#1a1a24] border border-gray-300 dark:border-gray-700 shadow-sm min-w-[90px]\">\n              <span className=\"text-gray-400 font-black block text-sm\">\360\237\245\210 2\302\272 LUGAR</span>\n              <span className=\"font-bold text-[#1a1c1e] dark:text-white text-[11px] truncate block max-w-[85px]\">\n                {finalBladerB?.name || \'Gingka H.\'}\n              </span>\n            </div>\n            <div className=\"text-center p-2.5 rounded-xl bg-white dark:bg-[#1a1a24] border border-amber-700/50 shadow-sm min-w-[90px]\">\n              <span className=\"text-amber-700 font-black block text-sm\">\360\237\245\211 3\302\272 LUGAR</span>\n              <span className=\"font-bold text-[#1a1c1e] dark:text-white text-[11px] truncate block max-w-[85px]\">\n                {bladers[3]?.name || \'Mia Ember\'}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Interactive Bracket Stage */}\n      <div\n        className=\"overflow-x-auto pb-8 pt-4 transition-transform duration-200 origin-top-left\"\n        style={{ transform: `scale(${zoomLevel})` }}\n      >\n        <div className=\"min-w-[960px] grid grid-cols-5 gap-6 items-center\">\n          {/* Col 1: Quarterfinals Left */}\n          <div className=\"space-y-8\">\n            <h3 className=\"font-headline font-black text-sm uppercase text-[#04A8FC] text-center border-b border-[#04A8FC]/30 pb-2\">\n              Cuartos (Lado A)\n            </h3>\n            {renderMatchNode(\n              \'Match 1\',\n              qf1?.bladerA || bladers[1],\n              qf1?.bladerB || bladers[2],\n              qf1?.scoreA ?? 2,\n              qf1?.scoreB ?? 3,\n              qf1?.status || \'live\',\n              qf1?.winnerId,\n              qf1\n            )}\n            {renderMatchNode(\n              \'Match 2\',\n              qf2?.bladerA || bladers[0],\n              qf2?.bladerB || bladers[3],\n              qf2?.scoreA ?? 5,\n              qf2?.scoreB ?? 2,\n              qf2?.status || \'finished\',\n              qf2?.winnerId,\n              qf2\n            )}\n          </div>\n\n          {/* Col 2: Semifinals Left */}\n          <div className=\"space-y-6\">\n            <h3 className=\"font-headline font-black text-sm uppercase text-amber-500 text-center border-b border-amber-500/30 pb-2\">\n              Semifinal 1\n            </h3>\n            {renderMatchNode(\n              \'Semifinal A\',\n              sf1BladerA,\n              sf1BladerB,\n              4,\n              5,\n              \'finished\',\n              sf1BladerB.id\n            )}\n          </div>\n\n          {/* Col 3: Grand Final Center */}\n          <div className=\"space-y-4\">\n            <div className=\"text-center mb-2\">\n              <span className=\"material-symbols-outlined text-3xl text-[#FCEE21] animate-bounce\">\n                emoji_events\n              </span>\n              <h3 className=\"font-headline font-black text-base uppercase text-[#FCEE21] border-b-2 border-[#FCEE21] pb-1\">\n                GRAND FINAL\n              </h3>\n            </div>\n            {renderMatchNode(\n              \'Gran Final X\',\n              finalBladerA,\n              finalBladerB,\n              5,\n              3,\n              \'finished\',\n              champion.id\n            )}\n            <div className=\"p-3 bg-black/5 dark:bg-white/5 rounded-xl border border-gray-300 dark:border-white/10 text-center\">\n              <span className=\"text-[10px] font-label-caps uppercase text-gray-500 block\">\n                3rd Place Match\n              </span>\n              <span className=\"font-headline font-bold text-xs uppercase text-[#04A8FC]\">\n                {bladers[3]?.name} vs {bladers[4]?.name}\n              </span>\n            </div>\n          </div>\n\n          {/* Col 4: Semifinals Right */}\n          <div className=\"space-y-6\">\n            <h3 className=\"font-headline font-black text-sm uppercase text-amber-500 text-center border-b border-amber-500/30 pb-2\">\n              Semifinal 2\n            </h3>\n            {renderMatchNode(\n              \'Semifinal B\',\n              sf2BladerA,\n              sf2BladerB,\n              2,\n              5,\n              \'finished\',\n              sf2BladerA.id\n            )}\n          </div>\n\n          {/* Col 5: Quarterfinals Right */}\n          <div className=\"space-y-8\">\n            <h3 className=\"font-headline font-black text-sm uppercase text-[#04A8FC] text-center border-b border-[#04A8FC]/30 pb-2\">\n              Cuartos (Lado B)\n            </h3>\n            {renderMatchNode(\n              \'Match 3\',\n              qf3?.bladerA || bladers[4],\n              qf3?.bladerB || bladers[5],\n              qf3?.scoreA ?? 0,\n              qf3?.scoreB ?? 0,\n              qf3?.status || \'upcoming\',\n              qf3?.winnerId,\n              qf3\n            )}\n            {renderMatchNode(\n              \'Match 4\',\n              qf4?.bladerA || bladers[6],\n              qf4?.bladerB || bladers[7],\n              qf4?.scoreA ?? 0,\n              qf4?.scoreB ?? 0,\n              qf4?.status || \'upcoming\',\n              qf4?.winnerId,\n              qf4\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
