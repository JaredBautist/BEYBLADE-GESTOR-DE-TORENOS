    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { ActiveScreen } from \'../types\';\nimport { soundManager } from \'../utils/audio\';\n\ninterface HeaderProps {\n  activeScreen: ActiveScreen;\n  setActiveScreen: (screen: ActiveScreen) => void;\n  isDark: boolean;\n  setIsDark: (dark: boolean) => void;\n  isMuted: boolean;\n  setIsMuted: (muted: boolean) => void;\n  onOpenNewBladerModal: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeScreen,\n  setActiveScreen,\n  isDark,\n  setIsDark,\n  isMuted,\n  setIsMuted,\n  onOpenNewBladerModal\n}) => {\n  return (\n    <header className=\"bg-white/95 dark:bg-[#131318]/95 border-b border-slate-200 dark:border-white/10 backdrop-blur-xl fixed top-0 left-0 right-0 md:left-64 z-40 h-16 flex items-center justify-between px-4 md:px-8 transition-colors duration-200 shadow-sm\">\n      {/* Left branding / navigation */}\n      <div className=\"flex items-center gap-4 md:gap-8\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-8 h-8 rounded-lg bg-[#04A8FC] text-white flex items-center justify-center font-black font-headline text-lg shadow-sm shadow-[#04A8FC]/30\">\n            X\n          </div>\n          <div>\n            <h1 className=\"font-headline font-black text-lg md:text-xl text-slate-900 dark:text-white tracking-tight uppercase leading-none\">\n              BEYBLADE X TOURNAMENT\n            </h1>\n            <span className=\"text-[10px] font-label-caps uppercase tracking-wider text-[#0284c7] dark:text-[#04A8FC] font-black\">\n              COMUNIDAD C\303\232CUTA \342\200\242 XTREME SERIES\n            </span>\n          </div>\n        </div>"
        replacement_content: "import React from \'react\';\nimport { ActiveScreen } from \'../types\';\nimport { soundManager } from \'../utils/audio\';\nimport { CommunityLogo } from \'./CommunityLogo\';\n\ninterface HeaderProps {\n  activeScreen: ActiveScreen;\n  setActiveScreen: (screen: ActiveScreen) => void;\n  isDark: boolean;\n  setIsDark: (dark: boolean) => void;\n  isMuted: boolean;\n  setIsMuted: (muted: boolean) => void;\n  onOpenNewBladerModal: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeScreen,\n  setActiveScreen,\n  isDark,\n  setIsDark,\n  isMuted,\n  setIsMuted,\n  onOpenNewBladerModal\n}) => {\n  return (\n    <header className=\"bg-white/95 dark:bg-[#131318]/95 border-b border-slate-200 dark:border-white/10 backdrop-blur-xl fixed top-0 left-0 right-0 md:left-64 z-40 h-16 flex items-center justify-between px-4 md:px-8 transition-colors duration-200 shadow-sm\">\n      {/* Left branding / navigation */}\n      <div className=\"flex items-center gap-4 md:gap-8\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-xl bg-white border border-slate-200 dark:border-white/10 p-0.5 flex items-center justify-center shadow-sm\">\n            <CommunityLogo size=\"sm\" className=\"w-full h-full object-contain\" />\n          </div>\n          <div>\n            <h1 className=\"font-headline font-black text-lg md:text-xl text-slate-900 dark:text-white tracking-tight uppercase leading-none\">\n              BEYBLADE X TOURNAMENT\n            </h1>\n            <span className=\"text-[10px] font-label-caps uppercase tracking-wider text-[#0284c7] dark:text-[#04A8FC] font-black\">\n              COMUNIDAD C\303\232CUTA \342\200\242 XTREME SERIES\n            </span>\n          </div>\n        </div>"
