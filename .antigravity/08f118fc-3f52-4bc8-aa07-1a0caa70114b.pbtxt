  file_change {
    absolute_path_uri: "file:///src/components/screens/DashboardScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Blader, Match, TournamentConfig } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\n\ninterface DashboardScreenProps {\n  currentMatch: Match;\n  config: TournamentConfig;\n  allBladers: Blader[];\n  onUpdateScore: (corner: \'A\' | \'B\', pointType: \'xtreme\' | \'burst\' | \'over\' | \'spin\' | \'stadium\', points: number) => void;\n  onResetMatch: () => void;\n  onSelectOnDeckMatch: (bladerAId: string, bladerBId: string) => void;\n  onRandomizeOnDeck: () => void;\n  onSwapCorners: () => void;\n}\n\nexport const DashboardScreen: React.FC<DashboardScreenProps> = ({\n  currentMatch,\n  config,\n  allBladers,\n  onUpdateScore,\n  onResetMatch,\n  onSelectOnDeckMatch,\n  onRandomizeOnDeck,\n  onSwapCorners\n}) => {\n  const [selectedComboSlotA, setSelectedComboSlotA] = useState<number>(1);\n  const [selectedComboSlotB, setSelectedComboSlotB] = useState<number>(1);\n  const [showEventLog, setShowEventLog] = useState<boolean>(true);\n\n  const bladerA = currentMatch.bladerA;\n  const bladerB = currentMatch.bladerB;\n\n  const currentComboA = bladerA?.combos.find((c) => c.slot === selectedComboSlotA) || bladerA?.combos[0];\n  const currentComboB = bladerB?.combos.find((c) => c.slot === selectedComboSlotB) || bladerB?.combos[0];\n\n  // Candidates for on-deck\n  const remainingBladers = allBladers.filter(\n    (b) => b.id !== bladerA?.id && b.id !== bladerB?.id\n  );\n  const onDeckA = remainingBladers[0] || allBladers[0];\n  const onDeckB = remainingBladers[1] || allBladers[1];\n\n  const handlePointClick = (\n    corner: \'A\' | \'B\',\n    type: \'xtreme\' | \'burst\' | \'over\' | \'spin\' | \'stadium\',\n    pts: number\n  ) => {\n    soundManager.playPoint(type);\n    onUpdateScore(corner, type, pts);\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-7xl mx-auto pb-12\">\n      {/* Top Banner Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-[#39FF14] animate-pulse\"></span>\n            <span className=\"font-label-caps text-xs text-[#04A8FC] uppercase tracking-widest font-bold\">\n              ENGAGEMENT ACTIVO \342\200\242 {currentMatch.roundName}\n            </span>\n          </div>\n          <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight italic\">\n            BATTLE CONSOLE\n          </h1>\n        </div>\n\n        {/* Quick stadium stats & controls */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => {\n              soundManager.playClick();\n              onSwapCorners();\n            }}\n            title=\"Intercambiar Esquinas Roja/Azul\"\n            className=\"glass-panel px-3 py-1.5 rounded-lg text-xs font-label-caps uppercase flex items-center gap-1.5 hover:border-[#04A8FC] text-gray-700 dark:text-gray-300 transition-all\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">swap_horiz</span>\n            <span className=\"hidden sm:inline\">Invertir Esquinas</span>\n          </button>\n          <div className=\"glass-panel px-3 py-1.5 rounded-lg flex items-center gap-2 border-[#04A8FC]/30\">\n            <span className=\"material-symbols-outlined text-[#04A8FC] text-sm\">stadium</span>\n            <span className=\"font-label-caps text-xs text-gray-600 dark:text-gray-300 uppercase\">\n              {config.arenaStatus}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Battle Arena 12-Column Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\">\n        {/* RED CORNER (Blader A) */}\n        <div className=\"lg:col-span-5 flex flex-col\">\n          <div className=\"glass-panel p-5 rounded-2xl relative overflow-hidden group border-l-4 border-l-[#AC191F] border-t border-r border-b border-[#bec7d3]/40 dark:border-white/10 shadow-sm flex flex-col justify-between h-full bg-gradient-to-b from-white/90 to-red-50/20 dark:from-[#16161d]/90 dark:to-red-950/10\">\n            {/* Tactical background glow */}\n            <div className=\"absolute top-0 right-0 w-36 h-36 bg-[#AC191F]/10 rounded-full blur-3xl pointer-events-none -mr-10 -mt-10\"></div>\n\n            {/* Profile Info */}\n            <div className=\"flex items-center gap-4 mb-4 relative z-10\">\n              <div className=\"relative\">\n                <img\n                  src={bladerA?.avatarUrl}\n                  alt={bladerA?.name || \'Blader Red\'}\n                  className=\"w-20 h-20 rounded-xl object-cover border-2 border-[#AC191F] shadow-md bg-[#0e0e13]\"\n                  onError={(e) => {\n                    (e.target as HTMLImageElement).src =\n                      \'https://images.unsplash.com/photo-1566492031773-4f4e44671857?w=150&auto=format&fit=crop&q=80\';\n                  }}\n                />\n                <div className=\"absolute -bottom-2 -left-1 bg-[#AC191F] text-white text-[9px] font-label-caps uppercase px-1.5 py-0.5 rounded font-black\">\n                  RED\n                </div>\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"font-label-caps text-xs text-[#AC191F] uppercase font-bold tracking-wider\">\n                  Corner: Red \342\200\242 {bladerA?.team}\n                </p>\n                <h3 className=\"font-headline font-black text-2xl md:text-3xl text-[#1a1c1e] dark:text-white uppercase truncate\">\n                  {bladerA?.name || \'Blader 1\'}\n                </h3>\n                <p className=\"text-gray-500 dark:text-gray-400 text-xs font-label-caps uppercase truncate\">\n                  {currentComboA?.name || \'Custom Combo\'}\n                </p>\n              </div>\n            </div>\n\n            {/* Combo selector chips */}\n            {bladerA && bladerA.combos.length > 0 && (\n              <div className=\"flex items-center gap-1.5 mb-4 p-1.5 bg-black/5 dark:bg-white/5 rounded-lg\">\n                <span className=\"text-[10px] font-label-caps text-gray-500 uppercase px-1 font-bold\">\n                  Deck:\n                </span>\n                {bladerA.combos.map((combo) => (\n                  <button\n                    key={combo.slot}\n                    onClick={() => setSelectedComboSlotA(combo.slot)}\n                    className={`flex-1 py-1 px-2 rounded text-[11px] font-label-caps uppercase truncate transition-all ${\n                      selectedComboSlotA === combo.slot\n                        ? \'bg-[#AC191F] text-white font-bold shadow-sm\'\n                        : \'text-gray-600 dark:text-gray-400 hover:bg-black/10 dark:hover:bg-white/10\'\n                    }`}\n                  >\n                    {combo.blade.substring(0, 8)}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* Large Score Display */}\n            <div className=\"flex justify-center items-center py-4 my-2 bg-black/5 dark:bg-black/20 rounded-2xl border border-[#AC191F]/20\">\n              <div className=\"text-center\">\n                <span className=\"block text-gray-500 dark:text-gray-400 font-label-caps text-xs uppercase tracking-widest font-semibold mb-1\">\n                  PUNTOS\n                </span>\n                <span\n                  id=\"score-display-a\"\n                  className=\"font-headline font-black text-6xl md:text-8xl text-[#AC191F] leading-none drop-shadow-sm tracking-tighter inline-block\"\n                >\n                  {currentMatch.scoreA}\n                </span>\n              </div>\n            </div>\n\n            {/* Tactical Scoring Controls */}\n            <div className=\"space-y-2.5 mt-4\">\n              {/* Xtreme Finish (3 PTS) */}\n              <button\n                id=\"btn-red-xtreme-finish\"\n                onClick={() => handlePointClick(\'A\', \'xtreme\', config.victoryConditions.xtremeDashPts)}\n                className=\"w-full bg-[#AC191F] hover:bg-[#c91d24] text-white py-3 px-4 rounded-xl flex items-center justify-between font-label-caps uppercase tracking-wider font-bold shadow-md shadow-[#AC191F]/20 hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-red-950\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-lg\">bolt</span>\n                  <span>XTREME FINISH</span>\n                </div>\n                <span className=\"bg-black/30 px-2.5 py-0.5 rounded-lg text-xs\">\n                  +{config.victoryConditions.xtremeDashPts} PTS\n                </span>\n              </button>\n\n              {/* Burst Finish & Over Finish (2 PTS each) */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-red-burst-finish\"\n                  onClick={() => handlePointClick(\'A\', \'burst\', config.victoryConditions.burstFinishPts)}\n                  className=\"bg-[#FFA500] hover:bg-[#ff9500] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-amber-800\"\n                >\n                  <span>BURST FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.burstFinishPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-red-over-finish\"\n                  onClick={() => handlePointClick(\'A\', \'over\', config.victoryConditions.overFinishPts)}\n                  className=\"bg-[#39FF14] hover:bg-[#32e610] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-green-800\"\n                >\n                  <span>OVER FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.overFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n\n              {/* Stadium Out & Spin Finish */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-red-stadium-out\"\n                  onClick={() => handlePointClick(\'A\', \'stadium\', config.victoryConditions.stadiumOutPts)}\n                  className=\"bg-gray-600 hover:bg-gray-500 text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-gray-900\"\n                >\n                  <span>STADIUM OUT</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.stadiumOutPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-red-spin-finish\"\n                  onClick={() => handlePointClick(\'A\', \'spin\', config.victoryConditions.spinFinishPts)}\n                  className=\"bg-[#04A8FC] hover:bg-[#0096e6] text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-blue-900\"\n                >\n                  <span>SPIN FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.spinFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* CENTER VS & TARGET MODULE */}\n        <div className=\"lg:col-span-2 flex flex-col justify-center items-center gap-5 py-4 lg:py-0\">\n          {/* Circular VS badge */}\n          <div className=\"relative flex justify-center items-center w-full\">\n            <div className=\"w-16 h-16 rounded-full bg-white dark:bg-[#1f1f25] border-2 border-[#04A8FC] shadow-lg flex items-center justify-center rotate-12 transform hover:rotate-0 transition-transform\">\n              <span className=\"font-headline font-black text-2xl text-[#1a1c1e] dark:text-white italic -rotate-12\">\n                VS\n              </span>\n            </div>\n          </div>\n\n          {/* Target Score Chip */}\n          <div className=\"glass-panel p-4 rounded-2xl flex flex-col items-center gap-1 w-full text-center border-2 border-[#FCEE21]/60 bg-[#FCEE21]/10 dark:bg-yellow-950/20 shadow-sm\">\n            <span className=\"font-label-caps text-[11px] text-amber-700 dark:text-amber-300 uppercase font-black tracking-wider\">\n              OBJETIVO\n            </span>\n            <span className=\"font-headline font-black text-3xl text-amber-600 dark:text-yellow-400 leading-none\">\n              {currentMatch.targetScore} PTS\n            </span>\n            <span className=\"text-[10px] font-label-caps text-gray-500 uppercase\">\n              Para Ganar\n            </span>\n          </div>\n\n          {/* Reset button */}\n          <button\n            id=\"btn-reset-match\"\n            onClick={() => {\n              soundManager.playClick();\n              onResetMatch();\n            }}\n            className=\"w-full glass-panel py-2 px-3 rounded-xl font-label-caps text-xs uppercase tracking-wider text-gray-600 dark:text-gray-300 hover:text-black dark:hover:text-white hover:border-[#AC191F] flex items-center justify-center gap-1.5 transition-all shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">restart_alt</span>\n            <span>Reiniciar Marcador</span>\n          </button>\n\n          {/* Toggle Point Log view */}\n          <button\n            onClick={() => setShowEventLog(!showEventLog)}\n            className=\"text-[11px] font-label-caps uppercase text-[#04A8FC] hover:underline flex items-center gap-1\"\n          >\n            <span className=\"material-symbols-outlined text-sm\">\n              {showEventLog ? \'expand_less\' : \'history\'}\n            </span>\n            <span>{showEventLog ? \'Ocultar Registro\' : \'Ver Registro\'}</span>\n          </button>\n        </div>\n\n        {/* BLUE CORNER (Blader B) */}\n        <div className=\"lg:col-span-5 flex flex-col\">\n          <div className=\"glass-panel p-5 rounded-2xl relative overflow-hidden group border-r-4 border-r-[#04A8FC] border-t border-l border-b border-[#bec7d3]/40 dark:border-white/10 shadow-sm flex flex-col justify-between h-full bg-gradient-to-b from-white/90 to-blue-50/20 dark:from-[#16161d]/90 dark:to-blue-950/10\">\n            {/* Tactical background glow */}\n            <div className=\"absolute top-0 left-0 w-36 h-36 bg-[#04A8FC]/10 rounded-full blur-3xl pointer-events-none -ml-10 -mt-10\"></div>\n\n            {/* Profile Info */}\n            <div className=\"flex flex-row-reverse items-center gap-4 mb-4 relative z-10 text-right\">\n              <div className=\"relative\">\n                <img\n                  src={bladerB?.avatarUrl}\n                  alt={bladerB?.name || \'Blader Blue\'}\n                  className=\"w-20 h-20 rounded-xl object-cover border-2 border-[#04A8FC] shadow-md bg-[#0e0e13]\"\n                  onError={(e) => {\n                    (e.target as HTMLImageElement).src =\n                      \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80\';\n                  }}\n                />\n                <div className=\"absolute -bottom-2 -right-1 bg-[#04A8FC] text-white text-[9px] font-label-caps uppercase px-1.5 py-0.5 rounded font-black\">\n                  BLUE\n                </div>\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"font-label-caps text-xs text-[#04A8FC] uppercase font-bold tracking-wider\">\n                  Corner: Blue \342\200\242 {bladerB?.team}\n                </p>\n                <h3 className=\"font-headline font-black text-2xl md:text-3xl text-[#1a1c1e] dark:text-white uppercase truncate\">\n                  {bladerB?.name || \'Blader 2\'}\n                </h3>\n                <p className=\"text-gray-500 dark:text-gray-400 text-xs font-label-caps uppercase truncate\">\n                  {currentComboB?.name || \'Custom Combo\'}\n                </p>\n              </div>\n            </div>\n\n            {/* Combo selector chips */}\n            {bladerB && bladerB.combos.length > 0 && (\n              <div className=\"flex items-center gap-1.5 mb-4 p-1.5 bg-black/5 dark:bg-white/5 rounded-lg flex-row-reverse\">\n                <span className=\"text-[10px] font-label-caps text-gray-500 uppercase px-1 font-bold\">\n                  Deck:\n                </span>\n                {bladerB.combos.map((combo) => (\n                  <button\n                    key={combo.slot}\n                    onClick={() => setSelectedComboSlotB(combo.slot)}\n                    className={`flex-1 py-1 px-2 rounded text-[11px] font-label-caps uppercase truncate transition-all ${\n                      selectedComboSlotB === combo.slot\n                        ? \'bg-[#04A8FC] text-white font-bold shadow-sm\'\n                        : \'text-gray-600 dark:text-gray-400 hover:bg-black/10 dark:hover:bg-white/10\'\n                    }`}\n                  >\n                    {combo.blade.substring(0, 8)}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* Large Score Display */}\n            <div className=\"flex justify-center items-center py-4 my-2 bg-black/5 dark:bg-black/20 rounded-2xl border border-[#04A8FC]/20\">\n              <div className=\"text-center\">\n                <span className=\"block text-gray-500 dark:text-gray-400 font-label-caps text-xs uppercase tracking-widest font-semibold mb-1\">\n                  PUNTOS\n                </span>\n                <span\n                  id=\"score-display-b\"\n                  className=\"font-headline font-black text-6xl md:text-8xl text-[#04A8FC] leading-none drop-shadow-sm tracking-tighter inline-block\"\n                >\n                  {currentMatch.scoreB}\n                </span>\n              </div>\n            </div>\n\n            {/* Tactical Scoring Controls */}\n            <div className=\"space-y-2.5 mt-4\">\n              {/* Xtreme Finish (3 PTS) */}\n              <button\n                id=\"btn-blue-xtreme-finish\"\n                onClick={() => handlePointClick(\'B\', \'xtreme\', config.victoryConditions.xtremeDashPts)}\n                className=\"w-full bg-[#04A8FC] hover:bg-[#008fe0] text-white py-3 px-4 rounded-xl flex items-center justify-between font-label-caps uppercase tracking-wider font-bold shadow-md shadow-[#04A8FC]/20 hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-blue-950\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-lg\">bolt</span>\n                  <span>XTREME FINISH</span>\n                </div>\n                <span className=\"bg-black/30 px-2.5 py-0.5 rounded-lg text-xs\">\n                  +{config.victoryConditions.xtremeDashPts} PTS\n                </span>\n              </button>\n\n              {/* Burst Finish & Over Finish (2 PTS each) */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-blue-burst-finish\"\n                  onClick={() => handlePointClick(\'B\', \'burst\', config.victoryConditions.burstFinishPts)}\n                  className=\"bg-[#FFA500] hover:bg-[#ff9500] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-amber-800\"\n                >\n                  <span>BURST FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.burstFinishPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-blue-over-finish\"\n                  onClick={() => handlePointClick(\'B\', \'over\', config.victoryConditions.overFinishPts)}\n                  className=\"bg-[#39FF14] hover:bg-[#32e610] text-black py-2.5 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm hover:scale-[1.01] active:scale-[0.98] transition-all border-b-4 border-green-800\"\n                >\n                  <span>OVER FINISH</span>\n                  <span className=\"text-[10px] bg-black/15 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.overFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n\n              {/* Stadium Out & Spin Finish */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  id=\"btn-blue-stadium-out\"\n                  onClick={() => handlePointClick(\'B\', \'stadium\', config.victoryConditions.stadiumOutPts)}\n                  className=\"bg-gray-600 hover:bg-gray-500 text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-gray-900\"\n                >\n                  <span>STADIUM OUT</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.stadiumOutPts} PTS\n                  </span>\n                </button>\n\n                <button\n                  id=\"btn-blue-spin-finish\"\n                  onClick={() => handlePointClick(\'B\', \'spin\', config.victoryConditions.spinFinishPts)}\n                  className=\"bg-[#04A8FC] hover:bg-[#0096e6] text-white py-2 px-3 rounded-xl flex flex-col items-center justify-center font-label-caps uppercase font-bold text-xs shadow-sm transition-all border-b-4 border-blue-900\"\n                >\n                  <span>SPIN FINISH</span>\n                  <span className=\"text-[10px] bg-black/20 px-2 py-0.5 rounded mt-0.5\">\n                    +{config.victoryConditions.spinFinishPts} PTS\n                  </span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Live Event Point Logs Stream */}\n      {showEventLog && currentMatch.events && currentMatch.events.length > 0 && (\n        <div className=\"glass-panel p-5 rounded-2xl border border-[#bec7d3]/30 dark:border-white/10\">\n          <div className=\"flex items-center justify-between mb-3 border-b border-[#bec7d3]/30 dark:border-white/10 pb-2\">\n            <h4 className=\"font-headline font-black text-sm uppercase text-[#1a1c1e] dark:text-white flex items-center gap-2\">\n              <span className=\"material-symbols-outlined text-base text-[#04A8FC]\">history</span>\n              <span>Historial de Puntos del Combate</span>\n            </h4>\n            <span className=\"text-xs font-label-caps text-gray-500\">\n              {currentMatch.events.length} Eventos Registrados\n            </span>\n          </div>\n\n          <div className=\"space-y-2 max-h-48 overflow-y-auto pr-1\">\n            {currentMatch.events.slice().reverse().map((ev) => (\n              <div\n                key={ev.id}\n                className=\"flex items-center justify-between p-2.5 rounded-xl bg-black/5 dark:bg-white/5 text-xs font-label-caps\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <span className=\"text-gray-400 font-mono text-[10px]\">{ev.timestamp}</span>\n                  <span\n                    className={`px-2 py-0.5 rounded font-black text-[10px] uppercase ${\n                      ev.bladerCorner === \'A\' ? \'bg-[#AC191F] text-white\' : \'bg-[#04A8FC] text-white\'\n                    }`}\n                  >\n                    {ev.bladerCorner === \'A\' ? \'ESQUINA ROJA\' : \'ESQUINA AZUL\'}\n                  </span>\n                  <span className=\"font-bold text-[#1a1c1e] dark:text-white\">{ev.bladerName}</span>\n                  <span className=\"text-gray-600 dark:text-gray-300\">{ev.description}</span>\n                </div>\n                <div className=\"font-headline font-bold text-sm text-[#04A8FC]\">\n                  {ev.scoreAAfter} - {ev.scoreBAfter}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* ON DECK (Siguiente Enfrentamiento) Section */}\n      <div className=\"glass-panel p-5 rounded-2xl border border-[#bec7d3]/30 dark:border-white/10 relative overflow-hidden bg-gradient-to-r from-transparent via-[#04A8FC]/5 to-transparent\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4\">\n          <div>\n            <span className=\"text-[10px] font-label-caps text-[#04A8FC] uppercase tracking-widest font-bold\">\n              LISTO EN BANQUILLO\n            </span>\n            <h3 className=\"font-headline font-black text-xl text-[#1a1c1e] dark:text-white uppercase italic\">\n              ON DECK (Siguiente Duelo)\n            </h3>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              id=\"btn-randomize-on-deck\"\n              onClick={() => {\n                soundManager.playClick();\n                onRandomizeOnDeck();\n              }}\n              className=\"bg-white dark:bg-white/10 border border-[#04A8FC] text-[#04A8FC] dark:text-white px-3.5 py-1.5 rounded-xl font-label-caps text-xs uppercase tracking-wider hover:bg-[#04A8FC]/10 flex items-center gap-1.5 transition-all shadow-sm\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">casino</span>\n              <span>Aleatorizar</span>\n            </button>\n            <button\n              id=\"btn-load-on-deck\"\n              onClick={() => {\n                if (onDeckA && onDeckB) {\n                  soundManager.playClick();\n                  onSelectOnDeckMatch(onDeckA.id, onDeckB.id);\n                }\n              }}\n              className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-4 py-1.5 rounded-xl font-label-caps text-xs uppercase tracking-wider font-bold shadow-md shadow-[#04A8FC]/20 transition-all flex items-center gap-1.5\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">play_arrow</span>\n              <span>Cargar en Consola</span>\n            </button>\n          </div>\n        </div>\n\n        {/* On Deck Match Cards */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 items-center\">\n          {/* Blader Left */}\n          <div className=\"bg-white dark:bg-[#191922] p-4 rounded-xl flex items-center gap-4 border-l-4 border-[#AC191F] shadow-sm\">\n            <img\n              src={onDeckA?.avatarUrl}\n              alt={onDeckA?.name}\n              className=\"w-12 h-12 rounded-lg object-cover bg-gray-100 dark:bg-gray-800\"\n            />\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"font-label-caps text-[10px] text-gray-500 uppercase\">\n                {onDeckA?.team || \'Team Persona\'}\n              </p>\n              <h4 className=\"font-headline font-bold text-base text-[#1a1c1e] dark:text-white truncate\">\n                {onDeckA?.name || \'Kyoya T.\'}\n              </h4>\n              <p className=\"text-[11px] text-gray-500 dark:text-gray-400 font-label-caps truncate\">\n                {onDeckA?.combos[0]?.name || \'Leon Claw 5-60P\'}\n              </p>\n            </div>\n          </div>\n\n          {/* VS Divider */}\n          <div className=\"text-center font-headline font-black text-xl text-gray-400 dark:text-gray-600 italic\">\n            VS\n          </div>\n\n          {/* Blader Right */}\n          <div className=\"bg-white dark:bg-[#191922] p-4 rounded-xl flex items-center gap-4 border-r-4 border-[#04A8FC] flex-row-reverse text-right shadow-sm\">\n            <img\n              src={onDeckB?.avatarUrl}\n              alt={onDeckB?.name}\n              className=\"w-12 h-12 rounded-lg object-cover bg-gray-100 dark:bg-gray-800\"\n            />\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"font-label-caps text-[10px] text-gray-500 uppercase\">\n                {onDeckB?.team || \'Team Wild\'}\n              </p>\n              <h4 className=\"font-headline font-bold text-base text-[#1a1c1e] dark:text-white truncate\">\n                {onDeckB?.name || \'Kenta Y.\'}\n              </h4>\n              <p className=\"text-[11px] text-gray-500 dark:text-gray-400 font-label-caps truncate\">\n                {onDeckB?.combos[0]?.name || \'Viper Tail 5-80O\'}\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { Blader, Match, TournamentConfig } from \'../../types\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { soundManager } from \'../../utils/audio\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "interface DashboardScreenProps {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  currentMatch: Match;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  config: TournamentConfig;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  allBladers: Blader[];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
