  file_change {
    absolute_path_uri: "file:///src/components/screens/EquipmentScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { INITIAL_BEYBLADE_PARTS } from \'../../data/initialData\';\nimport { BeybladePart } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\n\nexport const EquipmentScreen: React.FC = () => {\n  const [selectedCategory, setSelectedCategory] = useState<\'All\' | \'Blade\' | \'Ratchet\' | \'Bit\'>(\'All\');\n  const [activeBlade, setActiveBlade] = useState<string>(\'Dransword\');\n  const [activeRatchet, setActiveRatchet] = useState<string>(\'3-60\');\n  const [activeBit, setActiveBit] = useState<string>(\'F (Flat)\');\n\n  const blades = INITIAL_BEYBLADE_PARTS.filter((p) => p.type === \'Blade\');\n  const ratchets = INITIAL_BEYBLADE_PARTS.filter((p) => p.type === \'Ratchet\');\n  const bits = INITIAL_BEYBLADE_PARTS.filter((p) => p.type === \'Bit\');\n\n  const filteredParts = INITIAL_BEYBLADE_PARTS.filter((p) => {\n    if (selectedCategory === \'All\') return true;\n    return p.type === selectedCategory;\n  });\n\n  // Calculate dynamic stats\n  const getStats = () => {\n    const isAttack = activeBlade.includes(\'Dran\') || activeBlade.includes(\'Shark\') || activeBlade.includes(\'Phoenix\');\n    const isDefense = activeBlade.includes(\'Knight\') || activeBit.includes(\'Needle\') || activeBit.includes(\'Hexa\');\n    const isStamina = activeBlade.includes(\'Wizard\') || activeBit.includes(\'Ball\');\n\n    const attack = isAttack ? 95 : isDefense ? 40 : isStamina ? 30 : 65;\n    const defense = isDefense ? 90 : isAttack ? 35 : isStamina ? 50 : 60;\n    const stamina = isStamina ? 92 : isDefense ? 65 : isAttack ? 30 : 60;\n    const dash = activeBit.includes(\'Flat\') ? 98 : activeBit.includes(\'Taper\') ? 75 : 45;\n    const weightTotal = (35.0 + 6.4 + 2.2).toFixed(1);\n\n    return { attack, defense, stamina, dash, weightTotal };\n  };\n\n  const stats = getStats();\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n          EQUIPAMIENTO & COMBO BUILDER X\n        </h1>\n        <p className=\"font-body-text text-base text-gray-600 dark:text-gray-400\">\n          Base de datos oficial de piezas Takara Tomy / Hasbro Xtreme Series y simulador de rendimiento.\n        </p>\n      </div>\n\n      {/* Combo Builder Studio (Top Bento) */}\n      <div className=\"glass-panel p-6 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm relative overflow-hidden bg-gradient-to-r from-transparent via-[#04A8FC]/5 to-transparent\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n          {/* Visual Combo Display */}\n          <div className=\"lg:col-span-5 flex flex-col items-center text-center\">\n            <div className=\"w-48 h-48 rounded-2xl bg-white dark:bg-[#161620] border-2 border-[#04A8FC] p-4 flex items-center justify-center shadow-lg shadow-[#04A8FC]/20 relative\">\n              <img\n                src=\"https://lh3.googleusercontent.com/aida/AEtjO1XpdWjsILVmDGUzAAryc-7ZPusTPtPwcs7W_jvf29oijme-A2WoPIwhSpPPwpZo0s6OnenRFwkjVtGAGvD5kbIQZbyhNdTrSO2PNIMhwo_MRzZdCHzBqOTg2TkmjjW3l6BLDFirfkUBYITvQ5yBWwD-MWs2tCrxtMeVVmLQS2SzjU7FUqisWrOhDYJloR7yySq9WR1k6PbnHl-ZfzTx_bESXcPG77Be-rEOkLi6TezfqoXoiVVpVbbSipxX\"\n                alt=\"Combo preview\"\n                className=\"w-full h-full object-contain transform hover:rotate-45 transition-transform duration-500\"\n              />\n              <div className=\"absolute -bottom-3 bg-[#04A8FC] text-white text-[10px] font-label-caps uppercase px-3 py-1 rounded-full font-black tracking-widest shadow\">\n                XTREME SYSTEM\n              </div>\n            </div>\n            <h3 className=\"font-headline font-black text-2xl uppercase text-[#1a1c1e] dark:text-white mt-5\">\n              {activeBlade} {activeRatchet}{activeBit.split(\' \')[0]}\n            </h3>\n            <p className=\"font-label-caps text-xs text-gray-500 dark:text-gray-400 uppercase\">\n              Peso Estimado Total: <span className=\"text-[#04A8FC] font-bold\">{stats.weightTotal}g</span>\n            </p>\n          </div>\n\n          {/* Selectors & Performance Radar */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            {/* Parts Selectors */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div>\n                <label className=\"block text-[11px] font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                  1. Blade (Capa de Metal)\n                </label>\n                <select\n                  value={activeBlade}\n                  onChange={(e) => {\n                    soundManager.playClick();\n                    setActiveBlade(e.target.value);\n                  }}\n                  className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                >\n                  {blades.map((b) => (\n                    <option key={b.name} value={b.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                      {b.name} ({b.weight})\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-[11px] font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                  2. Ratchet (Trinquete)\n                </label>\n                <select\n                  value={activeRatchet}\n                  onChange={(e) => {\n                    soundManager.playClick();\n                    setActiveRatchet(e.target.value);\n                  }}\n                  className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                >\n                  {ratchets.map((r) => (\n                    <option key={r.name} value={r.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                      {r.name}\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-[11px] font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                  3. Bit (Punta de Engranaje)\n                </label>\n                <select\n                  value={activeBit}\n                  onChange={(e) => {\n                    soundManager.playClick();\n                    setActiveBit(e.target.value);\n                  }}\n                  className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                >\n                  {bits.map((bt) => (\n                    <option key={bt.name} value={bt.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                      {bt.name}\n                    </option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {/* Performance Stats Bars */}\n            <div className=\"space-y-3 pt-2\">\n              <h4 className=\"font-headline font-bold text-xs uppercase text-gray-500 tracking-wider\">\n                M\303\251tricas de Rendimiento en Estadio\n              </h4>\n\n              {/* Attack */}\n              <div>\n                <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                  <span className=\"font-bold text-[#AC191F]\">Poder de Ataque</span>\n                  <span className=\"font-bold text-[#AC191F]\">{stats.attack} / 100</span>\n                </div>\n                <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                  <div\n                    className=\"h-full bg-[#AC191F] transition-all duration-300\"\n                    style={{ width: `${stats.attack}%` }}\n                  ></div>\n                </div>\n              </div>\n\n              {/* Defense */}\n              <div>\n                <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                  <span className=\"font-bold text-green-500\">Defensa / Absorci\303\263n</span>\n                  <span className=\"font-bold text-green-500\">{stats.defense} / 100</span>\n                </div>\n                <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                  <div\n                    className=\"h-full bg-green-500 transition-all duration-300\"\n                    style={{ width: `${stats.defense}%` }}\n                  ></div>\n                </div>\n              </div>\n\n              {/* Stamina */}\n              <div>\n                <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                  <span className=\"font-bold text-[#04A8FC]\">Resistencia Centr\303\255fuga</span>\n                  <span className=\"font-bold text-[#04A8FC]\">{stats.stamina} / 100</span>\n                </div>\n                <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                  <div\n                    className=\"h-full bg-[#04A8FC] transition-all duration-300\"\n                    style={{ width: `${stats.stamina}%` }}\n                  ></div>\n                </div>\n              </div>\n\n              {/* Xtreme Dash Speed */}\n              <div>\n                <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                  <span className=\"font-bold text-amber-500\">Aceleraci\303\263n Xtreme Dash</span>\n                  <span className=\"font-bold text-amber-500\">{stats.dash} / 100</span>\n                </div>\n                <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                  <div\n                    className=\"h-full bg-amber-500 transition-all duration-300\"\n                    style={{ width: `${stats.dash}%` }}\n                  ></div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Catalog of Parts */}\n      <div className=\"space-y-4\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n          <h3 className=\"font-headline font-black text-xl uppercase text-[#1a1c1e] dark:text-white\">\n            Cat\303\241logo Oficial de Piezas\n          </h3>\n\n          <div className=\"flex items-center gap-1 bg-black/5 dark:bg-white/5 p-1 rounded-xl\">\n            {([\'All\', \'Blade\', \'Ratchet\', \'Bit\'] as const).map((cat) => (\n              <button\n                key={cat}\n                onClick={() => {\n                  soundManager.playClick();\n                  setSelectedCategory(cat);\n                }}\n                className={`px-3 py-1 rounded-lg text-xs font-label-caps uppercase font-bold transition-all ${\n                  selectedCategory === cat\n                    ? \'bg-[#04A8FC] text-white shadow-sm\'\n                    : \'text-gray-500 hover:text-black dark:hover:text-white\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\">\n          {filteredParts.map((part) => (\n            <div\n              key={part.name}\n              className=\"glass-panel p-4 rounded-xl border border-[#bec7d3]/40 dark:border-white/10 hover:border-[#04A8FC] transition-all shadow-sm space-y-2\"\n            >\n              <div className=\"flex justify-between items-start\">\n                <span className=\"px-2 py-0.5 rounded text-[9px] font-label-caps uppercase font-black bg-[#04A8FC]/15 text-[#006398] dark:text-[#93ccff]\">\n                  {part.type}\n                </span>\n                {part.weight && (\n                  <span className=\"text-[10px] font-mono text-gray-500 font-bold\">\n                    {part.weight}\n                  </span>\n                )}\n              </div>\n              <h4 className=\"font-headline font-black text-base uppercase text-[#1a1c1e] dark:text-white\">\n                {part.name}\n              </h4>\n              <p className=\"text-xs text-gray-600 dark:text-gray-400 font-body-text leading-relaxed\">\n                {part.description}\n              </p>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
