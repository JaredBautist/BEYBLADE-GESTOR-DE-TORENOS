  file_change {
    absolute_path_uri: "file:///src/components/screens/HistoryScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Blader, TournamentRecord } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\nimport { BladerAvatar } from \'../BladerAvatar\';\n\ninterface HistoryScreenProps {\n  bladers: Blader[];\n  history: TournamentRecord[];\n  onAddHistoryRecord?: (record: TournamentRecord) => void;\n  onDeleteHistoryRecord?: (id: string) => void;\n}\n\nexport const HistoryScreen: React.FC<HistoryScreenProps> = ({\n  bladers,\n  history,\n  onAddHistoryRecord,\n  onDeleteHistoryRecord\n}) => {\n  const [activeTab, setActiveTab] = useState<\'hall_of_fame\' | \'tournaments\' | \'casuals\'>(\'hall_of_fame\');\n  const [showAddCasualModal, setShowAddCasualModal] = useState<boolean>(false);\n\n  // Casual match form state\n  const [casualBladerA, setCasualBladerA] = useState<string>(bladers[0]?.name || \'\');\n  const [casualBladerB, setCasualBladerB] = useState<string>(bladers[1]?.name || \'\');\n  const [casualScoreA, setCasualScoreA] = useState<number>(4);\n  const [casualScoreB, setCasualScoreB] = useState<number>(2);\n  const [casualNotes, setCasualNotes] = useState<string>(\'Duelo Amistoso C\303\272cuta\');\n\n  const activeBladers = bladers.filter((b) => b.stats.matchesPlayed > 0 || b.stats.wins > 0);\n  const sortedByWins = [...bladers].sort((a, b) => b.stats.wins - a.stats.wins);\n  const sortedByXtreme = [...bladers].sort((a, b) => b.stats.xtremeFinishes - a.stats.xtremeFinishes);\n  const sortedByBurst = [...bladers].sort((a, b) => b.stats.burstFinishes - a.stats.burstFinishes);\n  const sortedByPoints = [...bladers].sort((a, b) => b.stats.pointsScored - a.stats.pointsScored);\n\n  const officialTournaments = history.filter((h) => h.type === \'tournament\');\n  const casualEncounters = history.filter((h) => h.type === \'casual\');\n\n  const handleCreateCasualRecord = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!casualBladerA.trim() || !casualBladerB.trim() || !onAddHistoryRecord) return;\n\n    soundManager.playScore();\n\n    const winnerName = casualScoreA >= casualScoreB ? casualBladerA.trim() : casualBladerB.trim();\n    const runnerUpName = casualScoreA >= casualScoreB ? casualBladerB.trim() : casualBladerA.trim();\n\n    const newRecord: TournamentRecord = {\n      id: `casual-${Date.now()}`,\n      title: casualNotes.trim() || \'Encuentro Casual\',\n      date: new Date().toLocaleDateString(\'es-CO\', { year: \'numeric\', month: \'short\', day: \'numeric\' }),\n      type: \'casual\',\n      format: \'elimination\',\n      winnerName,\n      runnerUpName,\n      totalMatches: 1,\n      totalBladers: 2,\n      totalPoints: casualScoreA + casualScoreB,\n      matchesSummary: [\n        {\n          bladerA: casualBladerA.trim(),\n          bladerB: casualBladerB.trim(),\n          scoreA: casualScoreA,\n          scoreB: casualScoreB,\n          winner: winnerName\n        }\n      ]\n    };\n\n    onAddHistoryRecord(newRecord);\n    setShowAddCasualModal(false);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-slate-200 dark:border-white/10 pb-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <h1 className=\"font-headline font-black text-3xl md:text-5xl text-slate-900 dark:text-white uppercase tracking-tight\">\n              HISTORIAL & HALL OF FAME\n            </h1>\n            <span className=\"hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#04A8FC]/10 text-[#04A8FC] text-[10px] font-headline font-bold uppercase border border-[#04A8FC]/20\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#04A8FC] animate-pulse\"></span>\n              Supabase DB\n            </span>\n          </div>\n          <p className=\"font-body-text text-base text-slate-600 dark:text-slate-400\">\n            Registros de torneos culminados, encuentros casuales amistosos y l\303\255deres hist\303\263ricos en C\303\272cuta.\n          </p>\n        </div>\n\n        {/* Action Button */}\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setShowAddCasualModal(true);\n          }}\n          className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-4 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02] active:scale-95\"\n        >\n          <span className=\"material-symbols-outlined text-base\">sports_kabaddi</span>\n          <span>Registrar Encuentro Casual</span>\n        </button>\n      </div>\n\n      {/* Tabs Navigation */}\n      <div className=\"flex items-center gap-2 p-1.5 bg-slate-200/80 dark:bg-white/5 rounded-2xl w-fit\">\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'hall_of_fame\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 transition-all ${\n            activeTab === \'hall_of_fame\'\n              ? \'bg-[#04A8FC] text-white shadow-md\'\n              : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm\">emoji_events</span>\n          <span>Hall of Fame & R\303\251cords</span>\n        </button>\n\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'tournaments\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 transition-all ${\n            activeTab === \'tournaments\'\n              ? \'bg-[#04A8FC] text-white shadow-md\'\n              : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm\">military_tech</span>\n          <span>Torneos Culminados ({officialTournaments.length})</span>\n        </button>\n\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'casuals\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 transition-all ${\n            activeTab === \'casuals\'\n              ? \'bg-[#04A8FC] text-white shadow-md\'\n              : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm\">swords</span>\n          <span>Encuentros Casuales ({casualEncounters.length})</span>\n        </button>\n      </div>\n\n      {/* TAB 1: HALL OF FAME */}\n      {activeTab === \'hall_of_fame\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {/* Most Wins */}\n          <div className=\"glass-panel p-5 rounded-3xl border border-amber-500/40 bg-gradient-to-b from-amber-500/10 to-transparent shadow-sm space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-2xl bg-amber-500 text-black flex items-center justify-center font-bold shadow-md\">\n                <span className=\"material-symbols-outlined\">military_tech</span>\n              </div>\n              <div>\n                <h4 className=\"font-headline font-black text-sm uppercase text-slate-900 dark:text-white\">\n                  R\303\251cord de Victorias\n                </h4>\n                <p className=\"text-[10px] font-label-caps text-slate-500 uppercase\">\n                  L\303\255deres en duelos ganados\n                </p>\n              </div>\n            </div>\n            <div className=\"space-y-2\">\n              {sortedByWins.slice(0, 5).map((b, i) => (\n                <div\n                  key={b.id}\n                  className=\"flex items-center justify-between p-2.5 rounded-xl bg-white/70 dark:bg-white/5 border border-slate-200/50 dark:border-white/5 text-xs font-label-caps uppercase\"\n                >\n                  <span className=\"font-bold text-slate-900 dark:text-white\">\n                    #{i + 1} {b.name}\n                  </span>\n                  <span className=\"font-headline font-black text-amber-500\">\n                    {b.stats.wins} Wins\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Most Xtreme Finishes */}\n          <div className=\"glass-panel p-5 rounded-3xl border border-[#04A8FC]/40 bg-gradient-to-b from-[#04A8FC]/10 to-transparent shadow-sm space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-2xl bg-[#04A8FC] text-white flex items-center justify-center font-bold shadow-md\">\n                <span className=\"material-symbols-outlined\">bolt</span>\n              </div>\n              <div>\n                <h4 className=\"font-headline font-black text-sm uppercase text-slate-900 dark:text-white\">\n                  Reyes del X-Dash (+3)\n                </h4>\n                <p className=\"text-[10px] font-label-caps text-slate-500 uppercase\">\n                  Mayor n\303\272mero de Xtreme Finishes\n                </p>\n              </div>\n            </div>\n            <div className=\"space-y-2\">\n              {sortedByXtreme.slice(0, 5).map((b, i) => (\n                <div\n                  key={b.id}\n                  className=\"flex items-center justify-between p-2.5 rounded-xl bg-white/70 dark:bg-white/5 border border-slate-200/50 dark:border-white/5 text-xs font-label-caps uppercase\"\n                >\n                  <span className=\"font-bold text-slate-900 dark:text-white\">\n                    #{i + 1} {b.name}\n                  </span>\n                  <span className=\"font-headline font-black text-[#04A8FC]\">\n                    {b.stats.xtremeFinishes} X-Finishes\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Most Burst Finishes */}\n          <div className=\"glass-panel p-5 rounded-3xl border border-[#DC2626]/40 bg-gradient-to-b from-[#DC2626]/10 to-transparent shadow-sm space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-2xl bg-[#DC2626] text-white flex items-center justify-center font-bold shadow-md\">\n                <span className=\"material-symbols-outlined\">explosion</span>\n              </div>\n              <div>\n                <h4 className=\"font-headline font-black text-sm uppercase text-slate-900 dark:text-white\">\n                  Burst Masters (+2)\n                </h4>\n                <p className=\"text-[10px] font-label-caps text-slate-500 uppercase\">\n                  Desarmadores de Ratchet rival\n                </p>\n              </div>\n            </div>\n            <div className=\"space-y-2\">\n              {sortedByBurst.slice(0, 5).map((b, i) => (\n                <div\n                  key={b.id}\n                  className=\"flex items-center justify-between p-2.5 rounded-xl bg-white/70 dark:bg-white/5 border border-slate-200/50 dark:border-white/5 text-xs font-label-caps uppercase\"\n                >\n                  <span className=\"font-bold text-slate-900 dark:text-white\">\n                    #{i + 1} {b.name}\n                  </span>\n                  <span className=\"font-headline font-black text-[#DC2626]\">\n                    {b.stats.burstFinishes} Bursts\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Most Points Scored */}\n          <div className=\"glass-panel p-5 rounded-3xl border border-purple-500/40 bg-gradient-to-b from-purple-500/10 to-transparent shadow-sm space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-2xl bg-purple-600 text-white flex items-center justify-center font-bold shadow-md\">\n                <span className=\"material-symbols-outlined\">scoreboard</span>\n              </div>\n              <div>\n                <h4 className=\"font-headline font-black text-sm uppercase text-slate-900 dark:text-white\">\n                  Puntuaci\303\263n Total\n                </h4>\n                <p className=\"text-[10px] font-label-caps text-slate-500 uppercase\">\n                  Puntos oficiales sumados\n                </p>\n              </div>\n            </div>\n            <div className=\"space-y-2\">\n              {sortedByPoints.slice(0, 5).map((b, i) => (\n                <div\n                  key={b.id}\n                  className=\"flex items-center justify-between p-2.5 rounded-xl bg-white/70 dark:bg-white/5 border border-slate-200/50 dark:border-white/5 text-xs font-label-caps uppercase\"\n                >\n                  <span className=\"font-bold text-slate-900 dark:text-white\">\n                    #{i + 1} {b.name}\n                  </span>\n                  <span className=\"font-headline font-black text-purple-500\">\n                    {b.stats.pointsScored} Pts\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: TOURNAMENTS HISTORY */}\n      {activeTab === \'tournaments\' && (\n        <div className=\"space-y-4\">\n          {officialTournaments.length === 0 ? (\n            <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-3 bg-white dark:bg-[#15151c]\">\n              <div className=\"w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center mx-auto\">\n                <span className=\"material-symbols-outlined text-3xl\">emoji_events</span>\n              </div>\n              <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                No hay torneos archivados todav\303\255a\n              </h4>\n              <p className=\"text-xs text-slate-500 max-w-md mx-auto\">\n                Cuando finalices un torneo en la consola o uses el bot\303\263n de <strong>Reiniciar Torneo &gt; Archivar en Historial</strong>, los resultados quedar\303\241n guardados permanentemente aqu\303\255.\n              </p>\n            </div>\n          ) : (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {officialTournaments.map((t) => (\n                <div\n                  key={t.id}\n                  className=\"glass-panel p-6 rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#15151c] shadow-sm hover:border-amber-500/50 transition-all space-y-4 relative group\"\n                >\n                  <div className=\"flex items-start justify-between border-b border-slate-100 dark:border-white/5 pb-3\">\n                    <div>\n                      <span className=\"text-[10px] font-label-caps uppercase text-amber-500 font-bold block\">\n                        Torneo Oficial \342\200\242 {t.date}\n                      </span>\n                      <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                        {t.title}\n                      </h4>\n                    </div>\n\n                    {onDeleteHistoryRecord && (\n                      <button\n                        onClick={() => {\n                          soundManager.playClick();\n                          onDeleteHistoryRecord(t.id);\n                        }}\n                        className=\"text-slate-400 hover:text-red-500 p-1 opacity-0 group-hover:opacity-100 transition-opacity\"\n                        title=\"Eliminar registro\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    )}\n                  </div>\n\n                  {/* Winner Banner */}\n                  <div className=\"p-3.5 rounded-2xl bg-gradient-to-r from-amber-500/15 via-amber-500/5 to-transparent border border-amber-500/30 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-10 h-10 rounded-full bg-amber-500 text-black flex items-center justify-center font-bold shadow\">\n                        <span className=\"material-symbols-outlined text-xl\">military_tech</span>\n                      </div>\n                      <div>\n                        <span className=\"text-[10px] font-label-caps uppercase text-amber-600 dark:text-amber-400 font-bold block\">\n                          Campe\303\263n del Torneo\n                        </span>\n                        <h5 className=\"font-headline font-black text-base uppercase text-slate-900 dark:text-white\">\n                          {t.winnerName}\n                        </h5>\n                      </div>\n                    </div>\n\n                    {t.runnerUpName && (\n                      <div className=\"text-right\">\n                        <span className=\"text-[10px] font-label-caps uppercase text-slate-400 font-bold block\">\n                          Subcampe\303\263n\n                        </span>\n                        <span className=\"font-headline font-bold text-xs uppercase text-slate-700 dark:text-slate-300\">\n                          {t.runnerUpName}\n                        </span>\n                      </div>\n                    )}\n                  </div>\n\n                  {/* Summary Stats */}\n                  <div className=\"grid grid-cols-3 gap-2 text-center text-xs font-label-caps uppercase pt-1\">\n                    <div className=\"p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5\">\n                      <span className=\"text-slate-400 block text-[9px]\">Participantes</span>\n                      <span className=\"font-black text-slate-900 dark:text-white\">{t.totalBladers} Bladers</span>\n                    </div>\n                    <div className=\"p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5\">\n                      <span className=\"text-slate-400 block text-[9px]\">Combates</span>\n                      <span className=\"font-black text-slate-900 dark:text-white\">{t.totalMatches} Duelos</span>\n                    </div>\n                    <div className=\"p-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5\">\n                      <span className=\"text-slate-400 block text-[9px]\">Puntos Totales</span>\n                      <span className=\"font-black text-[#04A8FC]\">{t.totalPoints} Pts</span>\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* TAB 3: CASUAL ENCOUNTERS */}\n      {activeTab === \'casuals\' && (\n        <div className=\"space-y-4\">\n          {casualEncounters.length === 0 ? (\n            <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-3 bg-white dark:bg-[#15151c]\">\n              <div className=\"w-14 h-14 rounded-2xl bg-[#04A8FC]/10 text-[#04A8FC] flex items-center justify-center mx-auto\">\n                <span className=\"material-symbols-outlined text-3xl\">sports_kabaddi</span>\n              </div>\n              <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                No hay encuentros casuales registrados\n              </h4>\n              <p className=\"text-xs text-slate-500 max-w-md mx-auto\">\n                Registra duelos r\303\241pidos y combates amistosos entre los miembros de la comunidad para que cuenten en el historial.\n              </p>\n              <button\n                onClick={() => setShowAddCasualModal(true)}\n                className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl font-headline font-bold text-xs uppercase\"\n              >\n                Registrar Primer Duelo Casual\n              </button>\n            </div>\n          ) : (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {casualEncounters.map((c) => (\n                <div\n                  key={c.id}\n                  className=\"glass-panel p-5 rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#15151c] shadow-sm hover:border-[#04A8FC] transition-all space-y-3 relative group\"\n                >\n                  <div className=\"flex items-center justify-between border-b border-slate-100 dark:border-white/5 pb-2\">\n                    <span className=\"text-[10px] font-label-caps uppercase text-[#04A8FC] font-bold\">\n                      Casual \342\200\242 {c.date}\n                    </span>\n                    {onDeleteHistoryRecord && (\n                      <button\n                        onClick={() => {\n                          soundManager.playClick();\n                          onDeleteHistoryRecord(c.id);\n                        }}\n                        className=\"text-slate-400 hover:text-red-500 p-0.5 opacity-0 group-hover:opacity-100 transition-opacity\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    )}\n                  </div>\n\n                  <h5 className=\"font-headline font-bold text-sm uppercase text-slate-900 dark:text-white\">\n                    {c.title}\n                  </h5>\n\n                  {c.matchesSummary && c.matchesSummary.length > 0 ? (\n                    <div className=\"p-3 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5 flex items-center justify-between font-headline font-bold uppercase text-xs\">\n                      <span className={c.matchesSummary[0].winner === c.matchesSummary[0].bladerA ? \'text-emerald-600 dark:text-emerald-400\' : \'text-slate-600 dark:text-slate-400\'}>\n                        {c.matchesSummary[0].bladerA} ({c.matchesSummary[0].scoreA})\n                      </span>\n                      <span className=\"text-slate-400 font-mono text-[10px]\">VS</span>\n                      <span className={c.matchesSummary[0].winner === c.matchesSummary[0].bladerB ? \'text-emerald-600 dark:text-emerald-400\' : \'text-slate-600 dark:text-slate-400\'}>\n                        {c.matchesSummary[0].bladerB} ({c.matchesSummary[0].scoreB})\n                      </span>\n                    </div>\n                  ) : (\n                    <p className=\"text-xs font-headline font-bold uppercase text-emerald-500\">\n                      Ganador: {c.winnerName}\n                    </p>\n                  )}\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Modal to register casual encounter */}\n      {showAddCasualModal && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl space-y-5\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 dark:border-white/10 pb-3\">\n              <h3 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                REGISTRAR ENCUENTRO CASUAL\n              </h3>\n              <button\n                onClick={() => setShowAddCasualModal(false)}\n                className=\"w-8 h-8 rounded-full bg-slate-100 dark:bg-white/10 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleCreateCasualRecord} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  T\303\255tulo o Lugar del Duelo\n                </label>\n                <input\n                  type=\"text\"\n                  value={casualNotes}\n                  onChange={(e) => setCasualNotes(e.target.value)}\n                  placeholder=\"Ej. Reto en Parque Santander\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              {/* Blader A and Score */}\n              <div className=\"grid grid-cols-3 gap-2\">\n                <div className=\"col-span-2\">\n                  <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Blader A\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={casualBladerA}\n                    onChange={(e) => setCasualBladerA(e.target.value)}\n                    placeholder=\"Nombre Blader A\"\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Puntos\n                  </label>\n                  <input\n                    type=\"number\"\n                    min=\"0\"\n                    max=\"10\"\n                    value={casualScoreA}\n                    onChange={(e) => setCasualScoreA(parseInt(e.target.value) || 0)}\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-bold text-center\"\n                  />\n                </div>\n              </div>\n\n              {/* Blader B and Score */}\n              <div className=\"grid grid-cols-3 gap-2\">\n                <div className=\"col-span-2\">\n                  <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Blader B\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={casualBladerB}\n                    onChange={(e) => setCasualBladerB(e.target.value)}\n                    placeholder=\"Nombre Blader B\"\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Puntos\n                  </label>\n                  <input\n                    type=\"number\"\n                    min=\"0\"\n                    max=\"10\"\n                    value={casualScoreB}\n                    onChange={(e) => setCasualScoreB(parseInt(e.target.value) || 0)}\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-bold text-center\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddCasualModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase font-bold text-slate-600 hover:text-slate-900 dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-black uppercase shadow-md transition-all\"\n                >\n                  Guardar Encuentro\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
