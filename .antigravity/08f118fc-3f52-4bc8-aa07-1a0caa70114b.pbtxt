      target_content: "        {/* Empty State / Quick Launch Box */}\n        <div className=\"glass-panel p-6 sm:p-8 rounded-3xl border border-[#bec7d3]/40 dark:border-white/10 shadow-xl relative overflow-hidden bg-gradient-to-b from-white/90 to-blue-50/20 dark:from-[#15151c]/90 dark:to-blue-950/10\">\n          <div className=\"max-w-2xl mx-auto text-center space-y-6\">\n            <div className=\"w-16 h-16 mx-auto rounded-2xl bg-[#04A8FC]/10 border border-[#04A8FC]/30 flex items-center justify-center text-[#04A8FC]\">\n              <span className=\"material-symbols-outlined text-3xl\">sports_kabaddi</span>\n            </div>\n\n            <div>\n              <h2 className=\"font-headline font-black text-2xl sm:text-3xl uppercase text-[#1a1c1e] dark:text-white\">\n                Consola Lista para Batalla\n              </h2>\n              <p className=\"font-body-text text-sm text-gray-600 dark:text-gray-400 mt-2\">\n                No hay ning\303\272n combate activo en el estadio en este momento. Puedes iniciar un duelo r\303\241pido escribiendo los nombres o seleccionar jugadores del Roster.\n              </p>\n            </div>\n\n            {/* Quick Match Creator Form */}\n            <form onSubmit={handleQuickStart} className=\"p-6 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-left space-y-4\">\n              <h3 className=\"font-headline font-bold text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400\">\n                Iniciar Duelo Inmediato\n              </h3>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                {/* Red Corner Blader */}\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-[#AC191F] mb-1.5 flex items-center gap-1\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#AC191F]\"></span>\n                    Esquina Roja (Blader A)\n                  </label>\n                  {allBladers.length > 0 ? (\n                    <select\n                      value={quickNameA}\n                      onChange={(e) => setQuickNameA(e.target.value)}\n                      className=\"w-full bg-white dark:bg-[#1a1a24] border border-gray-300 dark:border-gray-700 rounded-xl p-2.5 text-xs font-headline font-bold text-[#1a1c1e] dark:text-white uppercase focus:ring-2 focus:ring-[#AC191F] focus:outline-none\"\n                    >\n                      <option value=\"\">-- Seleccionar Blader --</option>\n                      {allBladers.map((b) => (\n                        <option key={b.id} value={b.name}>\n                          {b.name} ({b.team})\n                        </option>\n                      ))}\n                    </select>\n                  ) : (\n                    <input\n                      type=\"text\"\n                      value={quickNameA}\n                      onChange={(e) => setQuickNameA(e.target.value)}\n                      placeholder=\"Ej. Blader Rojo / Nombre\"\n                      className=\"w-full bg-white dark:bg-[#1a1a24] border border-gray-300 dark:border-gray-700 rounded-xl p-2.5 text-xs font-headline font-bold text-[#1a1c1e] dark:text-white placeholder:text-gray-400 focus:ring-2 focus:ring-[#AC191F] focus:outline-none\"\n                    />\n                  )}\n                </div>\n\n                {/* Blue Corner Blader */}\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-[#04A8FC] mb-1.5 flex items-center gap-1\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#04A8FC]\"></span>\n                    Esquina Azul (Blader B)\n                  </label>\n                  {allBladers.length > 0 ? (\n                    <select\n                      value={quickNameB}\n                      onChange={(e) => setQuickNameB(e.target.value)}\n                      className=\"w-full bg-white dark:bg-[#1a1a24] border border-gray-300 dark:border-gray-700 rounded-xl p-2.5 text-xs font-headline font-bold text-[#1a1c1e] dark:text-white uppercase focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                    >\n                      <option value=\"\">-- Seleccionar Blader --</option>\n                      {allBladers.map((b) => (\n                        <option key={b.id} value={b.name}>\n                          {b.name} ({b.team})\n                        </option>\n                      ))}\n                    </select>\n                  ) : (\n                    <input\n                      type=\"text\"\n                      value={quickNameB}\n                      onChange={(e) => setQuickNameB(e.target.value)}\n                      placeholder=\"Ej. Blader Azul / Nombre\"\n                      className=\"w-full bg-white dark:bg-[#1a1a24] border border-gray-300 dark:border-gray-700 rounded-xl p-2.5 text-xs font-headline font-bold text-[#1a1c1e] dark:text-white placeholder:text-gray-400 focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                    />\n                  )}\n                </div>\n              </div>\n\n              {/* Target Points Selector */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-gray-500 mb-1.5\">\n                  Puntaje Objetivo para Victoria\n                </label>\n                <div className=\"flex gap-2\">\n                  {[3, 4, 5, 7].map((pts) => (\n                    <button\n                      key={pts}\n                      type=\"button\"\n                      onClick={() => setQuickTargetScore(pts)}\n                      className={`flex-1 py-2 rounded-xl font-headline font-bold text-xs uppercase transition-all ${\n                        quickTargetScore === pts\n                          ? \'bg-[#04A8FC] text-white shadow-sm\'\n                          : \'border border-gray-300 dark:border-gray-700 hover:bg-black/5 dark:hover:bg-white/5 text-gray-700 dark:text-gray-300\'\n                      }`}\n                    >\n                      {pts} Puntos\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex flex-col sm:flex-row gap-3 pt-2\">\n                <button\n                  type=\"submit\"\n                  className=\"flex-1 bg-[#04A8FC] hover:bg-[#008fe0] text-white py-3 px-4 rounded-xl font-headline font-black text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg shadow-[#04A8FC]/30 hover:scale-[1.01] active:scale-[0.98] transition-all\"\n                >\n                  <span className=\"material-symbols-outlined text-base\">play_arrow</span>\n                  <span>Lanzar Combate a la Consola</span>\n                </button>\n\n                {allBladers.length === 0 && (\n                  <button\n                    type=\"button\"\n                    onClick={onNavigateToBladers}\n                    className=\"py-3 px-4 rounded-xl border border-gray-300 dark:border-gray-700 hover:bg-black/5 dark:hover:bg-white/5 font-headline font-bold text-xs uppercase text-gray-700 dark:text-gray-300 transition-all flex items-center justify-center gap-2\"\n                  >\n                    <span className=\"material-symbols-outlined text-base\">person_add</span>\n                    <span>Registrar Bladers & Decks</span>\n                  </button>\n                )}\n              </div>"
      replacement_content: "        {/* Empty State / Quick Launch Box */}\n        <div className=\"glass-panel p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-white/10 shadow-lg relative overflow-hidden bg-white dark:bg-[#15151c]\">\n          <div className=\"max-w-2xl mx-auto text-center space-y-6\">\n            <div className=\"w-16 h-16 mx-auto rounded-2xl bg-[#04A8FC]/10 border border-[#04A8FC]/30 flex items-center justify-center text-[#04A8FC]\">\n              <span className=\"material-symbols-outlined text-3xl\">sports_kabaddi</span>\n            </div>\n\n            <div>\n              <h2 className=\"font-headline font-black text-2xl sm:text-3xl uppercase text-slate-900 dark:text-white\">\n                Consola Lista para Batalla\n              </h2>\n              <p className=\"font-body-text text-sm text-slate-600 dark:text-slate-400 mt-2\">\n                No hay ning\303\272n combate activo en el estadio en este momento. Puedes iniciar un duelo r\303\241pido escribiendo los nombres o seleccionar jugadores del Roster.\n              </p>\n            </div>\n\n            {/* Quick Match Creator Form */}\n            <form onSubmit={handleQuickStart} className=\"p-6 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-left space-y-4 shadow-sm\">\n              <h3 className=\"font-headline font-bold text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400\">\n                Iniciar Duelo Inmediato\n              </h3>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                {/* Red Corner Blader */}\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-[#DC2626] dark:text-[#f87171] mb-1.5 flex items-center gap-1\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#DC2626]\"></span>\n                    Esquina Roja (Blader A)\n                  </label>\n                  {a