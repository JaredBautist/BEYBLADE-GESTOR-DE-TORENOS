    replacement_chunks {
      target_content: "    // If assigned to a deck slot (1, 2, or 3) and target blader exists, update the blader\'s deck\n    if (assignDeckSlot !== \'none\' && targetBlader && onUpdateBlader) {\n      const slotNum = parseInt(assignDeckSlot, 10) as 1 | 2 | 3;\n      const currentCombos = targetBlader.combos || [];\n      const updatedCombos: BladerCombo[] = [\n        currentCombos.find((c) => c.slot === 1) || { slot: 1, blade: \'Dransword\', ratchet: \'3-60\', bit: \'F\', name: \'Dransword 3-60F\' },\n        currentCombos.find((c) => c.slot === 2) || { slot: 2, blade: \'Hellscythe\', ratchet: \'4-60\', bit: \'T\', name: \'Hellscythe 4-60T\' },\n        currentCombos.find((c) => c.slot === 3) || { slot: 3, blade: \'Wizardarrow\', ratchet: \'4-80\', bit: \'B\', name: \'Wizardarrow 4-80B\' }\n      ].map((c) => {\n        if (c.slot === slotNum) {\n          return {\n            slot: slotNum,\n            blade: bladeVal,\n            ratchet: ratchetVal,\n            bit: bitVal,\n            name: comboFullName\n          };\n        }\n        return c;\n      });\n\n      const updatedBlader: Blader = {\n        ...targetBlader,\n        combos: updatedCombos\n      };\n      onUpdateBlader(updatedBlader);\n    }"
      replacement_content: "    // If assigned to a deck slot (1, 2, or 3) and target blader exists, update the blader\'s deck\n    if (assignDeckSlot !== \'none\' && targetBlader && onUpdateBlader) {\n      const slotNum = parseInt(assignDeckSlot, 10) as 1 | 2 | 3;\n      const currentCombos = [...(targetBlader.combos || [])];\n      const existingIdx = currentCombos.findIndex((c) => c.slot === slotNum);\n      const newComboItem: BladerCombo = {\n        slot: slotNum,\n        blade: bladeVal,\n        ratchet: ratchetVal,\n        bit: bitVal,\n        name: comboFullName\n      };\n\n      if (existingIdx >= 0) {\n        currentCombos[existingIdx] = newComboItem;\n      } else {\n        currentCombos.push(newComboItem);\n        currentCombos.sort((a, b) => a.slot - b.slot);\n      }\n\n      const updatedBlader: Blader = {\n        ...targetBlader,\n        combos: currentCombos\n      };\n      onUpdateBlader(updatedBlader);\n    }"
    }
    diff {
      end_line: 1005
      unified_diff {
