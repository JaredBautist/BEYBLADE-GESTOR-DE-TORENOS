      replacement_content: "import React from \'react\';\nimport { ActiveScreen } from \'../types\';\nimport { COMMUNITY_ASSETS } from \'../data/initialData\';\nimport { soundManager } from \'../utils/audio\';\n\ninterface HeaderProps {\n  activeScreen: ActiveScreen;\n  setActiveScreen: (screen: ActiveScreen) => void;\n  isDark: boolean;\n  setIsDark: (dark: boolean) => void;\n  isMuted: boolean;\n  setIsMuted: (muted: boolean) => void;\n  onOpenNewBladerModal: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeScreen,\n  setActiveScreen,\n  isDark,\n  setIsDark,\n  isMuted,\n  setIsMuted,\n  onOpenNewBladerModal\n}) => {\n  return (\n    <header className=\"bg-white/80 dark:bg-[#131318]/90 border-b border-[#bec7d3]/40 dark:border-white/10 backdrop-blur-xl fixed top-0 left-0 right-0 md:left-64 z-40 h-16 flex items-center justify-between px-4 md:px-8 transition-colors duration-200\">\n      {/* Left branding / navigation */}\n      <div className=\"flex items-center gap-4 md:gap-8\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-8 h-8 rounded-lg bg-[#04A8FC] text-white flex items-center justify-center font-black font-headline text-lg shadow-sm shadow-[#04A8FC]/30\">\n            X\n          </div>\n          <div>\n            <h1 className=\"font-headline font-black text-lg md:text-xl text-[#1a1c1e] dark:text-white tracking-tight uppercase leading-none\">\n              BEYBLADE X TOURNAMENT\n            </h1>\n            <span className=\"text-[10px] font-label-caps uppercase tracking-wider text-[#04A8FC] font-bold\">\n              COMUNIDAD C\303\232CUTA \342\200\242 XTREME SERIES\n            </span>\n          </div>\n        </div>\n\n        {/* Quick Nav Links */}\n        <nav className=\"hidden lg:flex items-center gap-1 font-label-caps text-xs tracking-wider uppercase font-semibold\">\n          <button\n            id=\"nav-link-bracket\"\n            onClick={() => {\n              soundManager.playClick();\n              setActiveScreen(\'bracket\');\n            }}\n            className={`px-3 py-1.5 rounded transition-all ${\n              activeScreen === \'bracket\'\n                ? \'bg-[#04A8FC]/15 text-[#006398] dark:text-[#93ccff] font-bold\'\n                : \'text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/5\'\n            }`}\n          >\n            Bracket\n          </button>\n          <button\n            id=\"nav-link-matches\"\n            onClick={() => {\n              soundManager.playClick();\n              setActiveScreen(\'matches\');\n            }}\n            className={`px-3 py-1.5 rounded transition-all ${\n              activeScreen === \'matches\'\n                ? \'bg-[#04A8FC]/15 text-[#006398] dark:text-[#93ccff] font-bold\'\n                : \'text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/5\'\n            }`}\n          >\n            Matches\n          </button>\n          <button\n            id=\"nav-link-rules\"\n            onClick={() => {\n              soundManager.playClick();\n              setActiveScreen(\'rules\');\n            }}\n            className={`px-3 py-1.5 rounded transition-all ${\n              activeScreen === \'rules\'\n                ? \'bg-[#04A8FC]/15 text-[#006398] dark:text-[#93ccff] font-bold\'\n                : \'text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/5\'\n            }`}\n          >\n            Rules\n          </button>\n        </nav>\n      </div>\n\n      {/* Right Controls */}\n      <div className=\"flex items-center gap-2 md:gap-3\">\n        {/* Register Player Action */}\n        <button\n          id=\"btn-register-player-top\"\n          onClick={() => {\n            soundManager.playClick();\n            onOpenNewBladerModal();\n          }}\n          className=\"hidden sm:flex items-center gap-1.5 bg-[#04A8FC] hover:bg-[#008fe0] text-white px-3.5 py-1.5 rounded text-xs font-label-caps uppercase tracking-wider font-bold shadow-sm shadow-[#04A8FC]/20 transition-all hover:scale-[1.02] active:scale-[0.98]\"\n        >\n          <span className=\"material-symbols-outlined text-base\">person_add</span>\n          <span>Registrar Blader</span>\n        </button>\n\n        {/* Audio Toggle */}\n        <button\n          id=\"btn-toggle-sound\"\n          title={isMuted ? \'Activar Sonidos\' : \'Silenciar Sonidos\'}\n          onClick={() => {\n            const next = !isMuted;\n            setIsMuted(next);\n            soundManager.setMuted(next);\n            if (!next) soundManager.playClick();\n          }}\n          className={`w-9 h-9 rounded-lg flex items-center justify-center transition-all ${\n            isMuted\n              ? \'text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 bg-gray-100 dark:bg-white/5\'\n              : \'text-[#04A8FC] bg-[#04A8FC]/10 hover:bg-[#04A8FC]/20\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-lg\">\n            {isMuted ? \'volume_off\' : \'volume_up\'}\n          </span>\n        </button>\n\n        {/* Dark / Light Mode Toggle */}\n        <button\n          id=\"btn-toggle-theme\"\n          title={isDark ? \'Modo Claro\' : \'Modo Oscuro\'}\n          onClick={() => {\n            soundManager.playClick();\n            setIsDark(!isDark);\n          }}\n          className=\"w-9 h-9 rounded-lg bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:hover:bg-white/10 text-gray-700 dark:text-gray-300 flex items-center justify-center transition-all\"\n        >\n          <span className=\"material-symbols-outlined text-lg\">\n            {isDark ? \'light_mode\' : \'dark_mode\'}\n          </span>\n        </button>\n\n        {/* Settings button */}\n        <button\n          id=\"btn-settings-header\"\n          title=\"Configuraci\303\263n de Torneo\"\n          onClick={() => {\n            soundManager.playClick();\n            setActiveScreen(\'configuration\');\n          }}\n          className={`w-9 h-9 rounded-lg flex items-center justify-center transition-all ${\n            activeScreen === \'configuration\'\n              ? \'bg-[#04A8FC] text-white\'\n              : \'bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:hover:bg-white/10 text-gray-700 dark:text-gray-300\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-lg\">settings</span>\n        </button>\n\n        {/* Organizer Avatar with Tooltip */}\n        <div className=\"relative group pl-1\">\n          <div className=\"w-8 h-8 rounded-full border-2 border-[#04A8FC] overflow-hidden shadow-sm\">\n            <img\n              src={COMMUNITY_ASSETS.organizerAvatar}\n              alt=\"Tournament Organizer\"\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n          <div className=\"absolute right-0 top-10 hidden group-hover:block bg-black/90 text-white text-[11px] font-label-caps uppercase px-2.5 py-1 rounded shadow-lg whitespace-nowrap z-50\">\n            Juez Oficial \342\200\242 C\303\272cuta\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
