a-public/AB6AXuCC41e0tg4GM0jozXL5Chc1id3VZWGBKJm85ycaDf1ngz4nwxAbQYQ8eO81ly4Hqng0X5IBxb8LdffzBTdzJw4DzgxB0qiIk6rLtkmokFQO0Y2hZD3Yx1BHjveX5VtKpL3SzJHf8NesxjJYIrj6JhLFzPXTGKwK7Ys0l4yBw6wGCd_nkFvxWbM0YODnBojRDoSQYqBo7MKtqkXbSqCsyBNmNc0_Ib5jN2Nfwy62kLmd33JOZsLQOWWHzA\',\n  \'https://lh3.googleusercontent.com/aida-public/AB6AXuA5RLAf6su6JT2CvjhO_bqMdVMVzIpJGEYAVtbRnfeS7vVF5MYEmICWwrbbawrD7_9tstVaQ9ONCSjjNFPISm3dP7RqLT9VJHbR4wCrvFWhwcTkPfBPwllDCryTnu6j9kPUKqIdRJ2d3frPBB1mCZ_gvXkHsvOdxZtqndNGRLrRVBxe8zmKOOgG6a98yeH_BwdggmQLb2UbSZV8uVV1UcN4hx2xHhQZb6QcR5QTE6q481HaX5d0x_nrqQ\',\n  \'https://lh3.googleusercontent.com/aida-public/AB6AXuAtlsHBCv-yF8IAzBSq_pSZokj5DjK-Vh8NZH8eJP82AaAcTQ92AQmLTXL1KWmDw1QLMD_ZYujg8Re3q8AHXQMjQ_poHzsOs6lGBTiGunvfpq36PR3lJx-KQAzG_49iD6cKRhlYO-HEfI6XX50rJf_345Z67Qsaaq-jUfNkCCK5xphmD4aUIrdah6O3sN9c9pfLRh11PnU47PabZxdfyFAVZRgnu_sG2ZZ6hi-MRaYmV1UnaLLfJzA0eA\'\n];\n\nexport const BladersScreen: React.FC<BladersScreenProps> = ({\n  bladers,\n  onAddBlader,\n  onToggleVerified,\n  onDeleteBlader\n}) => {\n  const [name, setName] = useState<string>(\'\');\n  const [alias, setAlias] = useState<string>(\'\');\n  const [team, setTeam] = useState<string>(\'\');\n  const [avatarIndex, setAvatarIndex] = useState<number>(0);\n  const [selectedBlader, setSelectedBlader] = useState<Blader | null>(null);\n\n  // 3 Combos state\n  const [combo1, setCombo1] = useState<string>(\'Dransword 3-60F\');\n  const [combo2, setCombo2] = useState<string>(\'Hellscythe 4-60T\');\n  const [combo3, setCombo3] = useState<string>(\'Wizardarrow 4-80B\');\n\n  const handleClear = () => {\n    setName(\'\');\n    setAlias(\'\');\n    setTeam(\'\');\n    setCombo1(\'Dransword 3-60F\');\n    setCombo2(\'Hellscythe 4-60T\');\n    setCombo3(\'Wizardarrow 4-80B\');\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim()) return;\n\n    soundManager.playClick();\n\n    const combos: BladerCombo[] = [\n      {\n        slot: 1,\n        blade: combo1.split(\' \')[0] || \'Dransword\',\n        ratchet: combo1.split(\' \')[1] || \'3-60\',\n        bit: \'F\',\n        name: combo1,\n        imageUrl: DEFAULT_COMBO_IMAGES[0]\n      },\n      {\n        slot: 2,\n        blade: combo2.split(\' \')[0] || \'Hellscythe\',\n        ratchet: combo2.split(\' \')[1] || \'4-60\',\n        bit: \'T\',\n        name: combo2,\n        imageUrl: DEFAULT_COMBO_IMAGES[1]\n      },\n      {\n        slot: 3,\n        blade: combo3.split(\' \')[0] || \'Wizardarrow\',\n        ratchet: combo3.split(\' \')[1] || \'4-80\',\n        bit: \'B\',\n        name: combo3,\n        imageUrl: DEFAULT_COMBO_IMAGES[2]\n      }\n    ];\n\n    const newBlader: Blader = {\n      id: `blader-${Date.now()}`,\n      name: name.trim(),\n      alias: alias.trim() || name.trim(),\n      team: team.trim() || \'Solo\',\n      avatarUrl: PRESET_AVATARS[avatarIndex % PRESET_AVATARS.length],\n      verified: true,\n      registeredAt: new Date().toISOString().split(\'T\')[0],\n      combos,\n      stats: {\n        matchesPlayed: 0,\n        wins: 0,\n        losses: 0,\n        pointsScored: 0,\n        xtremeFinishes: 0,\n        burstFinishes: 0,\n        overFinishes: 0,\n        spinFinishes: 0\n      }\n    };\n\n    onAddBlader(newBlader);\n    handleClear();\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n          BLADER REGISTRATION\n        </h1>\n        <p className=\"font-body-text text-base md:text-lg text-gray-600 dark:text-gray-400\">\n          Manage active participants and verify tournament combos.\n        </p>\n      </div>\n\n      {/* Main Grid: Form (Col 8) + Active Roster (Col 4) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Form Container */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          <div className=\"glass-panel p-6 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm relative overflow-hidden group\">\n            <div className=\"absolute top-0 right-0 w-32 h-32 bg-[#04A8FC]/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110\"></div>\n\n            <h3 className=\"font-headline font-bold text-xl text-[#04A8FC] uppercase mb-6 flex items-center gap-2\">\n              <span className=\"material-symbols-outlined\">person_add</span>\n              <span>New Blader Profile</span>\n            </h3>\n\n            <form onSubmit={handleSubmit} className=\"space-y-6\">\n              {/* Name & Team Fields */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                    Blader Name / Alias *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={name}\n                    onChange={(e) => setName(e.target.value)}\n                    placeholder=\"e.g., Kamen X\"\n                    className=\"w-full bg-black/5 dark:bg-white/5 border-b-2 border-[#04A8FC] rounded-t-lg px-3 py-2 text-[#1a1c1e] dark:text-white font-headline text-base focus:outline-none focus:bg-black/10 transition-colors\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                    Team Affiliation (Optional)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={team}\n                    onChange={(e) => setTeam(e.target.value)}\n                    placeholder=\"e.g., Team Persona\"\n                    className=\"w-full bg-black/5 dark:bg-white/5 border-b-2 border-gray-400 dark:border-gray-600 rounded-t-lg px-3 py-2 text-[#1a1c1e] dark:text-white font-headline text-base focus:border-[#04A8FC] focus:outline-none transition-colors\"\n                  />\n                </div>\n              </div>\n\n              {/* Avatar Selector */}\n              <div>\n                <label className=\"block font-label-caps text-xs text-gray-500 dark:text-gray-400 mb-2 uppercase font-bold\">\n                  Seleccionar Avatar de Combate\n                </label>\n                <div className=\"flex items-center gap-3 overflow-x-auto pb-2\">\n                  {PRESET_AVATARS.map((av, idx) => (\n                    <button\n                      key={idx}\n                      type=\"button\"\n                      onClick={() => setAvatarIndex(idx)}\n                      className={`w-14 h-14 rounded-xl overflow-hidden border-2 flex-shrink-0 transition-all ${\n                        avatarIndex === idx\n                          ? \'border-[#04A8FC] scale-105 shadow-md shadow-[#04A8FC]/30 ring-2 ring-[#04A8FC]/40\'\n                          : \'border-transparent opacity-60 hover:opacity-100\'\n                      }`}\n                    >\n                      <img src={av} alt=\"Avatar option\" className=\"w-full h-full object-cover\" />\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Tournament Combos (3 Slots Required) */}\n              <div className=\"pt-2\">\n                <div className=\"flex items-center justify-between mb-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-2\">\n                  <h4 className=\"font-headline font-bold text-sm uppercase text-[#1a1c1e] dark:text-white\">\n                    TOURNAMENT COMBOS\n                  </h4>\n                  <span className=\"bg-[#04A8FC]/15 text-[#006398] dark:text-[#93ccff] px-2.5 py-1 text-[11px] font-label-caps uppercase font-bold rounded-md\">\n                    3 Slots Required\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n                  {/* Slot 1 */}\n                  <div className=\"bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 p-4 rounded-xl hover:border-[#04A8FC]/50 transition-colors shadow-sm\">\n                    <div className=\"flex justify-between items-center mb-2 font-label-caps text-xs text-gray-500 font-bold\">\n                      <span>SLOT 1</span>\n                      <span className=\"material-symbols-outlined text-sm text-[#04A8FC]\">photo_camera</span>\n                    </div>\n                    <div className=\"aspect-square bg-white dark:bg-[#191922] rounded-lg mb-3 flex items-center justify-center overflow-hidden border border-[#bec7d3]/30 dark:border-white/10 p-2\">\n                      <img\n                        src={DEFAULT_COMBO_IMAGES[0]}\n                        alt=\"Combo 1\"\n                        className=\"w-full h-full object-contain\"\n                      />\n                    </div>\n                    <input\n                      type=\"text\"\n                      value={combo1}\n                      onChange={(e) => setCombo1(e.target.value)}\n                      placeholder=\"Dransword 3-60F\"\n                      className=\"w-full bg-transparent border-b border-gray-400 dark:border-gray-600 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:border-[#04A8FC] focus:outline-none py-1\"\n                    />\n                  </div>\n\n                  {/* Slot 2 */}\n                  <div className=\"bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 p-4 rounded-xl hover:border-[#04A8FC]/50 transition-colors shadow-sm\">\n                    <div className=\"flex justify-between items-center mb-2 font-label-caps text-xs text-gray-500 font-bold\">\n                      <span>SLOT 2</span>\n                      <span className=\"material-symbols-outlined text-sm text-[#04A8FC]\">photo_camera</span>\n                    </div>\n                    <div className=\"aspect-square bg-white dark:bg-[#191922] rounded-lg mb-3 flex items-center justify-center overflow-hidden border border-[#bec7d3]/30 dark:border-white/10 p-2\">\n                      <img\n                        src={DEFAULT_COMBO_IMAGES[1]}\n                        alt=\"Combo 2\"\n                        className=\"w-full h-full object-contain\"\n                      />\n                    </div>\n                    <input\n                      type=\"text\"\n                      value={combo2}\n                      onChange={(e) => setCombo2(e.target.value)}\n                      placeholder=\"Hellscythe 4-60T\"\n                      className=\"w-full bg-transparent border-b border-gray-400 dark:border-gray-600 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:border-[#04A8FC] focus:outline-none py-1\"\n                    />\n                  </div>\n\n                  {/* Slot 3 */}\n                  <div className=\"bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 p-4 rounded-xl hover:border-[#04A8FC]/50 transition-colors shadow-sm\">\n                    <div className=\"flex justify-between items-center mb-2 font-label-caps text-xs text-gray-500 font-bold\">\n                      <span>SLOT 3</span>\n                      <span className=\"material-symbols-outlined text-sm text-[#04A8FC]\">photo_camera</span>\n                    </div>\n                    <div className=\"aspect-square bg-white dark:bg-[#191922] rounded-lg mb-3 flex items-center justify-center overflow-hidden border border-[#bec7d3]/30 dark:border-white/10 p-2\">\n                      <img\n                        src={DEFAULT_COMBO_IMAGES[2]}\n                        alt=\"Combo 3\"\n                        className=\"w-full h-full object-contain\"\n                      />\n                    </div>\n                    <input\n                      type=\"text\"\n                      value={combo3}\n                      onChange={(e) => setCombo3(e.target.value)}\n                      placeholder=\"Wizardarrow 4-80B\"\n                      className=\"w-full bg-transparent border-b border-gray-400 dark:border-gray-600 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:border-[#04A8FC] focus:outline-none py-1\"\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Form Action Buttons */}\n              <div className=\"flex justify-end gap-3 pt-4 border-t border-[#bec7d3]/30 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={handleClear}\n                  className=\"px-6 py-2.5 border border-gray-400 dark:border-gray-600 text-[#1a1c1e] dark:text-white hover:bg-black/5 dark:hover:bg-white/5 font-label-caps text-xs uppercase rounded-xl transition-all\"\n                >\n                  Limpiar\n                </button>\n                <button\n                  type=\"submit\"\n                  id=\"btn-confirm-registration\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-8 py-2.5 font-headline font-bold text-xs uppercase rounded-xl flex items-center gap-2 shadow-md shadow-[#04A8FC]/30 transition-all hover:scale-[1.02] active:scale-[0.98]\"\n                >\n                  <span className=\"material-symbols-outlined text-base\">how_to_reg</span>\n                  <span>Confirm Registration</span>\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n\n        {/* ACTIVE ROSTER (Col 4) */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"font-headline font-black text-xl uppercase text-[#1a1c1e] dark:text-white\">\n              Active Roster\n            </h3>\n            <span className=\"bg-black/5 dark:bg-white/10 py-1 px-3 text-xs font-label-caps font-bold rounded-lg border border-[#bec7d3]/30 text-[#04A8FC]\">\n              {bladers.length} / 16\n            </span>\n          </div>\n\n          <div className=\"glass-panel rounded-2xl p-3 max-h-[620px] overflow-y-auto space-y-2 border border-[#bec7d3]/40 dark:border-white/10 shadow-sm\">\n            {bladers.map((b) => {\n              const isSelected = selectedBlader?.id === b.id;\n              return (\n                <div\n                  key={b.id}\n                  onClick={() => setSelectedBlader(b)}\n                  className={`p-3 rounded-xl flex items-center gap-3.5 border-l-4 transition-all cursor-pointer ${\n                    b.verified ? \'border-l-[#04A8FC]\' : \'border-l-[#FFA500]\'\n                  } ${\n                    isSelected\n                      ? \'bg-[#04A8FC]/15 shadow-sm\'\n                      : \'bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10\'\n                  }`}\n                >\n                  <div className=\"w-12 h-12 rounded-lg bg-gray-200 dark:bg-gray-800 overflow-hidden flex-shrink-0 border border-black/10\">\n                    <img src={b.avatarUrl} alt={b.name} className=\"w-full h-full object-cover\" />\n                  </div>\n\n                  <div className=\"flex-1 min-w-0\">\n                    <h4 className=\"font-headline font-bold text-sm uppercase text-[#1a1c1e] dark:text-white truncate\">\n                      {b.name}\n                    </h4>\n                    <p className=\"font-label-caps text-[11px] text-gray-500 dark:text-gray-400 truncate\">\n                      {b.team}\n                    </p>\n                    <p className=\"font-label-caps text-[10px] text-gray-400 truncate mt-0.5\">\n                      {b.combos[0]?.name}\n                    </p>\n                  </div>\n\n                  <div className=\"flex flex-col items-end gap-1 flex-shrink-0\">\n                    <button\n                      type=\"button\"\n                      title={b.verified ? \'Verificado\' : \'Pendiente\'}\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onToggleVerified(b.id);\n                      }}\n                      className={`text-xs flex items-center gap-0.5 ${\n                        b.verified ? \'text-[#04A8FC]\' : \'text-amber-500\'\n                      }`}\n                    >\n                      <span className=\"material-symbols-outlined text-base\">\n                        {b.verified ? \'check_circle\' : \'pending\'}\n                      </span>\n                      <span className=\"text-[10px] uppercase font-bold\">\n                        {b.verified ? \'Verificado\' : \'Pendiente\'}\n                      </span>\n                    </button>\n\n                    {bladers.length > 2 && (\n                      <button\n                        type=\"button\"\n                        title=\"Eliminar Blader\"\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          if (confirm(`\302\277Eliminar a ${b.name}?`)) {\n                            onDeleteBlader(b.id);\n                          }\n                        }}\n                        className=\"text-gray-400 hover:text-[#AC191F] p-0.5 transition-colors\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n          {/* Selected Blader Detail Card */}\n          {selectedBlader && (\n            <div className=\"glass-panel p-4 rounded-xl border border-[#04A8FC]/30 text-xs font-label-caps space-y-2 bg-[#04A8FC]/5\">\n              <div className=\"flex justify-between items-center font-bold text-[#04A8FC]\">\n                <span>PERFIL DE COMBATE</span>\n                <button\n                  onClick={() => setSelectedBlader(null)}\n                  className=\"text-gray-400 hover:text-black dark:hover:text-white\"\n                >\n                  \342\234\225\n                </button>\n              </div>\n              <p className=\"text-gray-700 dark:text-gray-300 font-bold\">{selectedBlader.name} ({selectedBlader.alias})</p>\n              <div className=\"grid grid-cols-2 gap-2 text-[10px] text-gray-500\">\n                <div>Victorias: <span className=\"font-bold text-[#22c55e]\">{selectedBlader.stats.wins}</span></div>\n                <div>Xtreme Finishes: <span className=\"font-bold text-[#04A8FC]\">{selectedBlader.stats.xtremeFinishes}</span></div>\n                <div>Burst Finishes: <span className=\"font-bold text-[#AC191F]\">{selectedBlader.stats.burstFinishes}</span></div>\n                <div>Puntos Totales: <span className=\"font-bold text-amber-500\">{selectedBlader.stats.pointsScored}</span></div>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
