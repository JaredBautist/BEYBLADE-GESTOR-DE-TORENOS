    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { BeybladePart, Blader, BladerCombo, RegisteredCombo } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\nimport { compressImage } from \'../../utils/imageUtils\';\nimport { BeybladeVisualizer } from \'../BeybladeVisualizer\';\nimport { BladerAvatar } from \'../BladerAvatar\';\nimport { OFFICIAL_BEYBLADE_X_CATALOG } from \'../../data/officialParts\';\n\ninterface EquipmentScreenProps {\n  parts: BeybladePart[];\n  bladers: Blader[];\n  registeredCombos: RegisteredCombo[];\n  onAddPart: (part: BeybladePart) => void;\n  onDeletePart: (name: string) => void;\n  onAddCombo: (combo: RegisteredCombo) => void;\n  onDeleteCombo: (id: string) => void;\n  onUpdateBlader?: (blader: Blader) => void;\n}\n\nexport const EquipmentScreen: React.FC<EquipmentScreenProps> = ({\n  parts,\n  bladers,\n  registeredCombos,\n  onAddPart,\n  onDeletePart,\n  onAddCombo,\n  onDeleteCombo,\n  onUpdateBlader\n}) => {\n  const [activeTab, setActiveTab] = useState<\'combos\' | \'parts\'>(\'combos\');\n  const [selectedCategory, setSelectedCategory] = useState<\'All\' | \'Blade\' | \'Ratchet\' | \'Bit\'>(\'All\');\n  const [comboFilterType, setComboFilterType] = useState<string>(\'All\');\n  const [comboFilterBlader, setComboFilterBlader] = useState<string>(\'All\');\n\n  const [showAddPartModal, setShowAddPartModal] = useState<boolean>(false);\n  const [showAddComboModal, setShowAddComboModal] = useState<boolean>(false);\n\n  // New part form state\n  const [newName, setNewName] = useState<string>(\'\');\n  const [newType, setNewType] = useState<\'Blade\' | \'Ratchet\' | \'Bit\'>(\'Blade\');\n  const [newCategory, setNewCategory] = useState<\'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\'>(\'Attack\');\n  const [newWeight, setNewWeight] = useState<string>(\'\');\n  const [newDescription, setNewDescription] = useState<string>(\'\');\n  const [newImage, setNewImage] = useState<string>(\'\');\n  const [partImageUrl, setPartImageUrl] = useState<string>(\'\');\n  const [showPartUrlInput, setShowPartUrlInput] = useState<boolean>(false);\n  const [isCompressing, setIsCompressing] = useState<boolean>(false);\n\n  // Active builder pieces\n  const blades = parts.filter((p) => p.type === \'Blade\');\n  const ratchets = parts.filter((p) => p.type === \'Ratchet\');\n  const bits = parts.filter((p) => p.type === \'Bit\');\n\n  const [activeBlade, setActiveBlade] = useState<string>(\'\');\n  const [activeRatchet, setActiveRatchet] = useState<string>(\'\');\n  const [activeBit, setActiveBit] = useState<string>(\'\');\n\n  // Save Combo Form State (with manual inputs fallback)\n  const [manualBlade, setManualBlade] = useState<string>(\'\');\n  const [manualRatchet, setManualRatchet] = useState<string>(\'\');\n  const [manualBit, setManualBit] = useState<string>(\'\');\n  const [manualWeight, setManualWeight] = useState<string>(\'\');\n\n  const [selectedOwnerId, setSelectedOwnerId] = useState<string>(bladers[0]?.id || \'custom\');\n  const [customOwnerName, setCustomOwnerName] = useState<string>(\'\');\n  const [comboNotes, setComboNotes] = useState<string>(\'\');\n  const [comboType, setComboType] = useState<\'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\'>(\'Attack\');\n  const [assignDeckSlot, setAssignDeckSlot] = useState<string>(\'none\'); // \'none\', \'1\', \'2\', \'3\'\n\n  const currentBlade = blades.find((b) => b.name === activeBlade) || blades[0];\n  const currentRatchet = ratchets.find((r) => r.name === activeRatchet) || ratchets[0];\n  const currentBit = bits.find((bt) => bt.name === activeBit) || bits[0];\n\n  const filteredParts = parts.filter((p) => {\n    if (selectedCategory === \'All\') return true;\n    return p.type === selectedCategory;\n  });\n\n  const filteredCombos = registeredCombos.filter((c) => {\n    const matchesType = comboFilterType === \'All\' || c.type === comboFilterType;\n    const matchesBlader =\n      comboFilterBlader === \'All\' ||\n      c.bladerId === comboFilterBlader ||\n      c.bladerName.toLowerCase() === comboFilterBlader.toLowerCase();\n    return matchesType && matchesBlader;\n  });\n\n  // Calculate dynamic stats if parts are configured\n  const getStats = () => {\n    if (!currentBlade && !currentRatchet && !currentBit) {\n      return { attack: 0, defense: 0, stamina: 0, dash: 0, weightTotal: \'0.0\' };\n    }\n\n    const bName = currentBlade?.name || \'\';\n    const btName = currentBit?.name || \'\';\n\n    const isAttack =\n      currentBlade?.category === \'Attack\' ||\n      bName.toLowerCase().includes(\'dran\') ||\n      bName.toLowerCase().includes(\'shark\') ||\n      bName.toLowerCase().includes(\'phoenix\') ||\n      bName.toLowerCase().includes(\'drake\');\n\n    const isDefense =\n      currentBlade?.category === \'Defense\' ||\n      bName.toLowerCase().includes(\'knight\') ||\n      btName.toLowerCase().includes(\'needle\') ||\n      btName.toLowerCase().includes(\'hexa\');\n\n    const isStamina =\n      currentBlade?.category === \'Stamina\' ||\n      bName.toLowerCase().includes(\'wizard\') ||\n      btName.toLowerCase().includes(\'ball\');\n\n    const attack = isAttack ? 95 : isDefense ? 40 : isStamina ? 30 : 65;\n    const defense = isDefense ? 90 : isAttack ? 35 : isStamina ? 50 : 60;\n    const stamina = isStamina ? 92 : isDefense ? 65 : isAttack ? 30 : 60;\n    const dash = btName.toLowerCase().includes(\'flat\') ? 98 : btName.toLowerCase().includes(\'taper\') ? 75 : 50;\n\n    const parseW = (wStr?: string) => parseFloat(wStr?.replace(\'g\', \'\') || \'0\') || 0;\n    const weightTotal = (\n      (currentBlade ? parseW(currentBlade.weight) || 35.0 : 0) +\n      (currentRatchet ? parseW(currentRatchet.weight) || 6.5 : 0) +\n      (currentBit ? parseW(currentBit.weight) || 2.3 : 0)\n    ).toFixed(1);\n\n    return { attack, defense, stamina, dash, weightTotal };\n  };\n\n  const stats = getStats();\n\n  const handlePartImageUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    try {\n      setIsCompressing(true);\n      const dataUrl = await compressImage(file, 400, 400, 0.85);\n      setNewImage(dataUrl);\n    } catch (err) {\n      console.error(\'Error uploading part photo:\', err);\n    } finally {\n      setIsCompressing(false);\n    }\n  };\n\n  const handleCreatePart = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newName.trim()) return;\n\n    soundManager.playClick();\n    const newPart: BeybladePart = {\n      name: newName.trim(),\n      type: newType,\n      category: newCategory,\n      weight: newWeight.trim() ? `${newWeight.trim()}${newWeight.includes(\'g\') ? \'\' : \'g\'}` : undefined,\n      description: newDescription.trim() || undefined,\n      image: newImage || partImageUrl.trim() || undefined\n    };\n\n    onAddPart(newPart);\n\n    if (newType === \'Blade\') setActiveBlade(newPart.name);\n    if (newType === \'Ratchet\') setActiveRatchet(newPart.name);\n    if (newType === \'Bit\') setActiveBit(newPart.name);\n\n    setNewName(\'\');\n    setNewWeight(\'\');\n    setNewDescription(\'\');\n    setNewImage(\'\');\n    setPartImageUrl(\'\');\n    setShowAddPartModal(false);\n  };\n\n  // Bulk import official Beyblade X Catalog\n  const handleImportOfficialCatalog = () => {\n    soundManager.playScore();\n    OFFICIAL_BEYBLADE_X_CATALOG.forEach((part) => {\n      onAddPart(part);\n    });\n    if (OFFICIAL_BEYBLADE_X_CATALOG.length > 0) {\n      const firstBlade = OFFICIAL_BEYBLADE_X_CATALOG.find((p) => p.type === \'Blade\');\n      const firstRatchet = OFFICIAL_BEYBLADE_X_CATALOG.find((p) => p.type === \'Ratchet\');\n      const firstBit = OFFICIAL_BEYBLADE_X_CATALOG.find((p) => p.type === \'Bit\');\n      if (firstBlade) setActiveBlade(firstBlade.name);\n      if (firstRatchet) setActiveRatchet(firstRatchet.name);\n      if (firstBit) setActiveBit(firstBit.name);\n    }\n  };\n\n  const handleSaveCurrentCombo = (e: React.FormEvent) => {\n    e.preventDefault();\n\n    const bladeVal = currentBlade?.name || manualBlade.trim();\n    const ratchetVal = currentRatchet?.name || manualRatchet.trim();\n    const bitVal = currentBit?.name || manualBit.trim();\n\n    if (!bladeVal || !ratchetVal || !bitVal) {\n      alert(\'Por favor especifica la Blade, Ratchet y Bit del combo.\');\n      return;\n    }\n\n    soundManager.playScore();\n\n    let bladerName = \'\';\n    let bladerId: string | undefined = undefined;\n    let targetBlader: Blader | undefined = undefined;\n\n    if (selectedOwnerId === \'custom\' || !selectedOwnerId) {\n      bladerName = customOwnerName.trim() || \'Blader C\303\272cuta\';\n    } else {\n      targetBlader = bladers.find((b) => b.id === selectedOwnerId);\n      bladerName = targetBlader?.name || \'Blader C\303\272cuta\';\n      bladerId = targetBlader?.id;\n    }\n\n    const calculatedWeight =\n      parts.length > 0 && stats.weightTotal !== \'0.0\'\n        ? `${stats.weightTotal}g`\n        : manualWeight.trim()\n        ? `${manualWeight.trim()}${manualWeight.includes(\'g\') ? \'\' : \'g\'}`\n        : undefined;\n\n    const comboFullName = `${bladeVal} ${ratchetVal}${bitVal}`;\n\n    const newCombo: RegisteredCombo = {\n      id: `combo-${Date.now()}`,\n      bladerId,\n      bladerName,\n      blade: bladeVal,\n      ratchet: ratchetVal,\n      bit: bitVal,\n      type: comboType,\n      weight: calculatedWeight,\n      notes: comboNotes.trim() || undefined,\n      createdAt: new Date().toISOString()\n    };\n\n    onAddCombo(newCombo);\n\n    // If assigned to a deck slot (1, 2, or 3) and target blader exists, update the blader\'s deck\n    if (assignDeckSlot !== \'none\' && targetBlader && onUpdateBlader) {\n      const slotNum = parseInt(assignDeckSlot, 10) as 1 | 2 | 3;\n      const currentCombos = targetBlader.combos || [];\n      const updatedCombos: BladerCombo[] = [\n        currentCombos.find((c) => c.slot === 1) || { slot: 1, blade: \'Dransword\', ratchet: \'3-60\', bit: \'F\', name: \'Dransword 3-60F\' },\n        currentCombos.find((c) => c.slot === 2) || { slot: 2, blade: \'Hellscythe\', ratchet: \'4-60\', bit: \'T\', name: \'Hellscythe 4-60T\' },\n        currentCombos.find((c) => c.slot === 3) || { slot: 3, blade: \'Wizardarrow\', ratchet: \'4-80\', bit: \'B\', name: \'Wizardarrow 4-80B\' }\n      ].map((c) => {\n        if (c.slot === slotNum) {\n          return {\n            slot: slotNum,\n            blade: bladeVal,\n            ratchet: ratchetVal,\n            bit: bitVal,\n            name: comboFullName\n          };\n        }\n        return c;\n      });\n\n      const updatedBlader: Blader = {\n        ...targetBlader,\n        combos: updatedCombos\n      };\n      onUpdateBlader(updatedBlader);\n    }\n\n    setShowAddComboModal(false);\n    setComboNotes(\'\');\n    setCustomOwnerName(\'\');\n    setManualBlade(\'\');\n    setManualRatchet(\'\');\n    setManualBit(\'\');\n    setManualWeight(\'\');\n    setAssignDeckSlot(\'none\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-slate-200 dark:border-white/10 pb-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <h1 className=\"font-headline font-black text-3xl md:text-5xl text-slate-900 dark:text-white uppercase tracking-tight\">\n              EQUIPAMIENTO & COMBOS\n            </h1>\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#04A8FC]/10 text-[#04A8FC] text-[11px] font-headline font-bold uppercase border border-[#04A8FC]/20\">\n              <span className=\"w-2 h-2 rounded-full bg-[#04A8FC] animate-pulse\"></span>\n              Base de Datos Supabase\n            </span>\n          </div>\n          <p className=\"font-body-text text-base text-slate-600 dark:text-slate-400\">\n            Armero oficial de piezas, registro de combos y asignaci\303\263n directa a los Decks 3on3 de los Bladers.\n          </p>\n        </div>\n\n        {/* Action Buttons */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <button\n            onClick={() => {\n              soundManager.playClick();\n              setShowAddComboModal(true);\n            }}\n            className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-4 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02] active:scale-95\"\n          >\n            <span className=\"material-symbols-outlined text-base\">bookmark_add</span>\n            <span>Registrar Combo</span>\n          </button>\n\n          <button\n            onClick={() => {\n              soundManager.playClick();\n              setShowAddPartModal(true);\n            }}\n            className=\"bg-slate-100 dark:bg-white/10 hover:bg-slate-200 dark:hover:bg-white/15 text-slate-800 dark:text-white px-4 py-2.5 rounded-xl font-headline font-bold text-xs uppercase flex items-center gap-1.5 transition-all\"\n          >\n            <span className=\"material-symbols-outlined text-base\">add</span>\n            <span>Nueva Pieza</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Tabs */}\n      <div className=\"flex items-center gap-2 border-b border-slate-200 dark:border-white/10 pb-2\">\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'combos\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-bold text-xs uppercase tracking-wider transition-all flex items-center gap-2 ${\n            activeTab === \'combos\'\n              ? \'bg-[#04A8FC] text-white shadow-md shadow-[#04A8FC]/20\'\n              : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/5\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-base\">military_tech</span>\n          <span>Combos Registrados ({registeredCombos.length})</span>\n        </button>\n\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'parts\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-bold text-xs uppercase tracking-wider transition-all flex items-center gap-2 ${\n            activeTab === \'parts\'\n              ? \'bg-[#04A8FC] text-white shadow-md shadow-[#04A8FC]/20\'\n              : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/5\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-base\">category</span>\n          <span>Cat\303\241logo de Piezas ({parts.length})</span>\n        </button>\n      </div>\n\n      {/* TAB 1: COMBOS ARMORY */}\n      {activeTab === \'combos\' && (\n        <div className=\"space-y-8\">\n          {/* Top Interactive Builder (if parts exist or can be assembled) */}\n          <div className=\"glass-panel p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm bg-white dark:bg-[#15151c]\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n              {/* Visualizer & Dynamic Specs */}\n              <div className=\"lg:col-span-5 flex flex-col items-center justify-center p-6 rounded-2xl bg-slate-50 dark:bg-black/40 border border-slate-200 dark:border-white/5 relative overflow-hidden\">\n                <div className=\"w-full max-w-[220px] aspect-square flex items-center justify-center\">\n                  <BeybladeVisualizer\n                    bladeName={currentBlade?.name || \'Dransword\'}\n                    ratchetName={currentRatchet?.name || \'3-60\'}\n                    bitName={currentBit?.name || \'Flat\'}\n                    scale={1.2}\n                  />\n                </div>\n\n                <div className=\"mt-4 text-center\">\n                  <h3 className=\"font-headline font-black text-xl uppercase text-slate-900 dark:text-white\">\n                    {currentBlade?.name || \'Selecciona Blade\'} {currentRatchet?.name || \'3-60\'}\n                    {currentBit?.name || \'F\'}\n                  </h3>\n                  <span className=\"text-xs font-label-caps font-bold uppercase text-[#04A8FC]\">\n                    Peso Total Estimado: {stats.weightTotal}g\n                  </span>\n                </div>\n\n                {/* Radar / Bars Stats */}\n                <div className=\"w-full grid grid-cols-2 gap-3 mt-5 pt-4 border-t border-slate-200 dark:border-white/10\">\n                  <div className=\"space-y-1\">\n                    <div className=\"flex justify-between text-[10px] font-label-caps uppercase font-bold text-slate-500\">\n                      <span>Ataque</span>\n                      <span className=\"text-red-500\">{stats.attack}%</span>\n                    </div>\n                    <div className=\"h-1.5 bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                      <div className=\"h-full bg-red-500 rounded-full transition-all\" style={{ width: `${stats.attack}%` }}></div>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <div className=\"flex justify-between text-[10px] font-label-caps uppercase font-bold text-slate-500\">\n                      <span>Defensa</span>\n                      <span className=\"text-emerald-500\">{stats.defense}%</span>\n                    </div>\n                    <div className=\"h-1.5 bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                      <div className=\"h-full bg-emerald-500 rounded-full transition-all\" style={{ width: `${stats.defense}%` }}></div>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <div className=\"flex justify-between text-[10px] font-label-caps uppercase font-bold text-slate-500\">\n                      <span>Resistencia</span>\n                      <span className=\"text-amber-500\">{stats.stamina}%</span>\n                    </div>\n                    <div className=\"h-1.5 bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                      <div className=\"h-full bg-amber-500 rounded-full transition-all\" style={{ width: `${stats.stamina}%` }}></div>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <div className=\"flex justify-between text-[10px] font-label-caps uppercase font-bold text-slate-500\">\n                      <span>X-Dash</span>\n                      <span className=\"text-[#04A8FC]\">{stats.dash}%</span>\n                    </div>\n                    <div className=\"h-1.5 bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                      <div className=\"h-full bg-[#04A8FC] rounded-full transition-all\" style={{ width: `${stats.dash}%` }}></div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Quick Selectors or Actions */}\n              <div className=\"lg:col-span-7 space-y-5\">\n                <div>\n                  <h3 className=\"font-headline font-black text-xl uppercase text-slate-900 dark:text-white flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-[#04A8FC]\">build_circle</span>\n                    <span>Taller y Ensamblador de Combos</span>\n                  </h3>\n                  <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n                    Selecciona los 3 componentes oficiales de tu cat\303\241logo o registra nuevos para alimentar la base de datos de la comunidad.\n                  </p>\n                </div>\n\n                {parts.length === 0 ? (\n                  <div className=\"p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-3\">\n                    <div className=\"flex items-center gap-2 text-amber-600 dark:text-amber-400\">\n                      <span className=\"material-symbols-outlined text-lg\">info</span>\n                      <span className=\"font-headline font-bold text-xs uppercase\">\n                        Cat\303\241logo de Piezas Vac\303\255o\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-600 dark:text-slate-400\">\n                      Puedes agregar piezas individuales o alimentar la base de datos con el cat\303\241logo oficial oficial Takara Tomy & Hasbro (19 piezas est\303\241ndar).\n                    </p>\n                    <div className=\"flex flex-wrap gap-2\">\n                      <button\n                        onClick={handleImportOfficialCatalog}\n                        className=\"px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-xl font-headline font-bold text-xs uppercase transition-all shadow-sm flex items-center gap-1.5\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">cloud_download</span>\n                        <span>+ Importar Cat\303\241logo Oficial (19 Piezas)</span>\n                      </button>\n                      <button\n                        onClick={() => setShowAddPartModal(true)}\n                        className=\"px-3.5 py-2 bg-white dark:bg-white/10 text-slate-700 dark:text-white rounded-xl font-headline font-bold text-xs uppercase border border-slate-300 dark:border-white/10\"\n                      >\n                        + Crear Pieza Manual\n                      </button>\n                    </div>\n                  </div>\n                ) : (\n                  <div className=\"space-y-4\">\n                    {/* Blades Row */}\n                    <div>\n                      <div className=\"flex items-center justify-between mb-1.5\">\n                        <label className=\"text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-300\">\n                          1. Blade (Capa de Metal)\n                        </label>\n                        <span className=\"text-[10px] text-slate-400\">{blades.length} disponibles</span>\n                      </div>\n                      <div className=\"flex gap-2 overflow-x-auto pb-1\">\n                        {blades.map((b) => (\n                          <button\n                            key={b.name}\n                            onClick={() => setActiveBlade(b.name)}\n                            className={`px-3 py-1.5 rounded-xl text-xs font-headline font-bold uppercase flex-shrink-0 transition-all ${\n                              currentBlade?.name === b.name\n                                ? \'bg-red-500 text-white shadow-sm font-black\'\n                                : \'bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:bg-slate-200\'\n                            }`}\n                          >\n                            {b.name}\n                          </button>\n                        ))}\n                      </div>\n                    </div>\n\n                    {/* Ratchets Row */}\n                    <div>\n                      <div className=\"flex items-center justify-between mb-1.5\">\n                        <label className=\"text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-300\">\n                          2. Ratchet (Trinquete Central)\n                        </label>\n                        <span className=\"text-[10px] text-slate-400\">{ratchets.length} disponibles</span>\n                      </div>\n                      <div className=\"flex gap-2 overflow-x-auto pb-1\">\n                        {ratchets.map((r) => (\n                          <button\n                            key={r.name}\n                            onClick={() => setActiveRatchet(r.name)}\n                            className={`px-3 py-1.5 rounded-xl text-xs font-headline font-bold uppercase flex-shrink-0 transition-all ${\n                              currentRatchet?.name === r.name\n                                ? \'bg-amber-500 text-white shadow-sm font-black\'\n                                : \'bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:bg-slate-200\'\n                            }`}\n                          >\n                            {r.name}\n                          </button>\n                        ))}\n                      </div>\n                    </div>\n\n                    {/* Bits Row */}\n                    <div>\n                      <div className=\"flex items-center justify-between mb-1.5\">\n                        <label className=\"text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-300\">\n                          3. Bit (Punta de Eje)\n                        </label>\n                        <span className=\"text-[10px] text-slate-400\">{bits.length} disponibles</span>\n                      </div>\n                      <div className=\"flex gap-2 overflow-x-auto pb-1\">\n                        {bits.map((bt) => (\n                          <button\n                            key={bt.name}\n                            onClick={() => setActiveBit(bt.name)}\n                            className={`px-3 py-1.5 rounded-xl text-xs font-headline font-bold uppercase flex-shrink-0 transition-all ${\n                              currentBit?.name === bt.name\n                                ? \'bg-blue-500 text-white shadow-sm font-black\'\n                                : \'bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-300 hover:bg-slate-200\'\n                            }`}\n                          >\n                            {bt.name}\n                          </button>\n                        ))}\n                      </div>\n                    </div>\n\n                    <div className=\"pt-2 flex justify-end\">\n                      <button\n                        onClick={() => setShowAddComboModal(true)}\n                        className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 shadow-md shadow-[#04A8FC]/20\"\n                      >\n                        <span className=\"material-symbols-outlined text-base\">save</span>\n                        <span>Guardar este Combo en Supabase</span>\n                      </button>\n                    </div>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* Registered Combos List */}\n          <div className=\"space-y-4\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n              <h3 className=\"font-headline font-black text-xl uppercase text-slate-900 dark:text-white flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-[#04A8FC]\">military_tech</span>\n                <span>Padr\303\263n de Combos Registrados ({filteredCombos.length})</span>\n              </h3>\n\n              {/* Filters */}\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <select\n                  value={comboFilterType}\n                  onChange={(e) => setComboFilterType(e.target.value)}\n                  className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold uppercase text-slate-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-[#04A8FC]\"\n                >\n                  <option value=\"All\">Todos los Tipos</option>\n                  <option value=\"Attack\">Ataque</option>\n                  <option value=\"Defense\">Defensa</option>\n                  <option value=\"Stamina\">Resistencia</option>\n                  <option value=\"Balance\">Equilibrio</option>\n                </select>\n\n                <select\n                  value={comboFilterBlader}\n                  onChange={(e) => setComboFilterBlader(e.target.value)}\n                  className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold uppercase text-slate-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-[#04A8FC]\"\n                >\n                  <option value=\"All\">Todos los Bladers</option>\n                  {bladers.map((b) => (\n                    <option key={b.id} value={b.id}>\n                      {b.name}\n                    </option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {filteredCombos.length === 0 ? (\n              <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-4 bg-white dark:bg-[#15151c]\">\n                <div className=\"w-14 h-14 rounded-2xl bg-[#04A8FC]/10 text-[#04A8FC] flex items-center justify-center mx-auto\">\n                  <span className=\"material-symbols-outlined text-3xl\">sports_martial_arts</span>\n                </div>\n                <div className=\"space-y-1\">\n                  <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                    No Hay Combos Registrados\n                  </h4>\n                  <p className=\"text-xs text-slate-500 max-w-sm mx-auto\">\n                    A\303\272n no se han guardado combinaciones en la base de datos. Haz clic en \"Registrar Combo\" para asignar el primer Beyblade a un Blader.\n                  </p>\n                </div>\n                <button\n                  onClick={() => setShowAddComboModal(true)}\n                  className=\"px-5 py-2.5 bg-[#04A8FC] text-white rounded-xl font-headline font-black text-xs uppercase shadow-md flex items-center gap-1.5 mx-auto\"\n                >\n                  <span className=\"material-symbols-outlined text-base\">add_circle</span>\n                  <span>Registrar Primer Combo</span>\n                </button>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                {filteredCombos.map((combo) => (\n                  <div\n                    key={combo.id}\n                    className=\"p-5 rounded-3xl border border-slate-200 dark:border-white/5 bg-white dark:bg-[#15151c] hover:border-[#04A8FC] transition-all space-y-3 relative group shadow-sm\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span\n                        className={`text-[10px] font-label-caps font-black px-2.5 py-0.5 rounded-full uppercase ${\n                          combo.type === \'Attack\'\n                            ? \'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20\'\n                            : combo.type === \'Defense\'\n                            ? \'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20\'\n                            : combo.type === \'Stamina\'\n                            ? \'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20\'\n                            : \'bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20\'\n                        }`}\n                      >\n                        {combo.type}\n                      </span>\n                      <div className=\"flex items-center gap-2\">\n                        {combo.weight && (\n                          <span className=\"font-mono text-xs font-bold text-slate-500 dark:text-slate-400\">\n                            {combo.weight}\n                          </span>\n                        )}\n                        <button\n                          onClick={() => {\n                            soundManager.playClick();\n                            onDeleteCombo(combo.id);\n                          }}\n                          className=\"opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 p-0.5 rounded transition-opacity\"\n                          title=\"Eliminar combo\"\n                        >\n                          <span className=\"material-symbols-outlined text-sm\">delete</span>\n                        </button>\n                      </div>\n                    </div>\n\n                    <div>\n                      <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                        {combo.blade} {combo.ratchet}{combo.bit}\n                      </h4>\n                      <div className=\"flex items-center gap-1.5 text-xs text-slate-500 mt-1\">\n                        <span className=\"material-symbols-outlined text-xs text-[#04A8FC]\">person</span>\n                        <span className=\"font-headline font-bold uppercase text-slate-700 dark:text-slate-300\">\n                          {combo.bladerName}\n                        </span>\n                      </div>\n                    </div>\n\n                    <div className=\"grid grid-cols-3 gap-1.5 pt-2 border-t border-slate-100 dark:border-white/5 text-center\">\n                      <div className=\"p-1.5 rounded-xl bg-slate-50 dark:bg-white/5\">\n                        <span className=\"text-[9px] font-label-caps uppercase text-slate-400 block font-bold\">Blade</span>\n                        <span className=\"font-headline font-bold text-xs uppercase text-slate-800 dark:text-white truncate block\">\n                          {combo.blade}\n                        </span>\n                      </div>\n                      <div className=\"p-1.5 rounded-xl bg-slate-50 dark:bg-white/5\">\n                        <span className=\"text-[9px] font-label-caps uppercase text-slate-400 block font-bold\">Ratchet</span>\n                        <span className=\"font-headline font-bold text-xs uppercase text-slate-800 dark:text-white truncate block\">\n                          {combo.ratchet}\n                        </span>\n                      </div>\n                      <div className=\"p-1.5 rounded-xl bg-slate-50 dark:bg-white/5\">\n                        <span className=\"text-[9px] font-label-caps uppercase text-slate-400 block font-bold\">Bit</span>\n                        <span className=\"font-headline font-bold text-xs uppercase text-slate-800 dark:text-white truncate block\">\n                          {combo.bit}\n                        </span>\n                      </div>\n                    </div>\n\n                    {combo.notes && (\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400 italic pt-1 border-t border-slate-100 dark:border-white/5 line-clamp-2\">\n                        \"{combo.notes}\"\n                      </p>\n                    )}\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: PARTS CATALOG */}\n      {activeTab === \'parts\' && (\n        <div className=\"space-y-6\">\n          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n            {/* Category Filter */}\n            <div className=\"flex items-center gap-2\">\n              {([\'All\', \'Blade\', \'Ratchet\', \'Bit\'] as const).map((cat) => (\n                <button\n                  key={cat}\n                  onClick={() => {\n                    soundManager.playClick();\n                    setSelectedCategory(cat);\n                  }}\n                  className={`px-3.5 py-1.5 rounded-xl text-xs font-headline font-bold uppercase transition-all ${\n                    selectedCategory === cat\n                      ? \'bg-[#04A8FC] text-white shadow-sm font-black\'\n                      : \'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400 hover:bg-slate-200\'\n                  }`}\n                >\n                  {cat === \'All\' ? \'Todas\' : `${cat}s`}\n                </button>\n              ))}\n            </div>\n\n            {/* Import official catalog button */}\n            <button\n              onClick={handleImportOfficialCatalog}\n              className=\"px-3.5 py-1.5 rounded-xl text-xs font-headline font-bold uppercase bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 text-slate-700 dark:text-slate-300 flex items-center gap-1.5 transition-all\"\n              title=\"Cargar lote de piezas est\303\241ndar Takara Tomy a Supabase\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">download</span>\n              <span>+ Importar 19 Piezas Oficiales Beyblade X</span>\n            </button>\n          </div>\n\n          {/* Parts Grid */}\n          {filteredParts.length === 0 ? (\n            <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-4 bg-white dark:bg-[#15151c]\">\n              <div className=\"w-14 h-14 rounded-2xl bg-[#04A8FC]/10 text-[#04A8FC] flex items-center justify-center mx-auto\">\n                <span className=\"material-symbols-outlined text-3xl\">precision_manufacturing</span>\n              </div>\n              <div className=\"space-y-1\">\n                <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                  Cat\303\241logo de Piezas Vac\303\255o\n                </h4>\n                <p className=\"text-xs text-slate-500 max-w-sm mx-auto\">\n                  No hay piezas en el cat\303\241logo. Puedes registrar piezas personalizadas con foto y peso o importar el lote oficial.\n                </p>\n              </div>\n              <div className=\"flex flex-wrap items-center justify-center gap-3\">\n                <button\n                  onClick={() => setShowAddPartModal(true)}\n                  className=\"px-5 py-2.5 bg-[#04A8FC] hover:bg-[#008fe0] text-white rounded-xl font-headline font-black text-xs uppercase shadow-md flex items-center gap-1.5\"\n                >\n                  <span className=\"material-symbols-outlined text-base\">add_circle</span>\n                  <span>Registrar Pieza</span>\n                </button>\n                <button\n                  onClick={handleImportOfficialCatalog}\n                  className=\"px-5 py-2.5 bg-slate-200 dark:bg-white/10 text-slate-800 dark:text-white rounded-xl font-headline font-bold text-xs uppercase\"\n                >\n                  + Importar Lote Oficial (19 Piezas)\n                </button>\n              </div>\n            </div>\n          ) : (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {filteredParts.map((part) => (\n                <div\n                  key={part.name}\n                  className=\"p-4 rounded-3xl border border-slate-200 dark:border-white/5 bg-white dark:bg-[#15151c] hover:border-[#04A8FC] transition-all space-y-2.5 relative group shadow-sm\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span\n                      className={`text-[10px] font-label-caps font-black px-2 py-0.5 rounded-lg uppercase ${\n                        part.type === \'Blade\'\n                          ? \'bg-red-500/10 text-red-600 dark:text-red-400\'\n                          : part.type === \'Ratchet\'\n                          ? \'bg-amber-500/10 text-amber-600 dark:text-amber-400\'\n                          : \'bg-blue-500/10 text-blue-600 dark:text-blue-400\'\n                      }`}\n                    >\n                      {part.type} {part.category ? `\342\200\242 ${part.category}` : \'\'}\n                    </span>\n                    <div className=\"flex items-center gap-2\">\n                      {part.weight && (\n                        <span className=\"font-mono text-xs font-bold text-slate-500 dark:text-slate-400\">\n                          {part.weight}\n                        </span>\n                      )}\n                      <button\n                        onClick={() => {\n                          soundManager.playClick();\n                          onDeletePart(part.name);\n                        }}\n                        className=\"opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 p-0.5 rounded transition-opacity\"\n                        title=\"Eliminar pieza\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-3\">\n                    {part.image ? (\n                      <div className=\"w-12 h-12 rounded-xl overflow-hidden bg-slate-100 dark:bg-white/5 flex-shrink-0 border border-slate-200 dark:border-white/10\">\n                        <img src={part.image} alt={part.name} className=\"w-full h-full object-cover\" />\n                      </div>\n                    ) : (\n                      <div className=\"w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/5 flex items-center justify-center flex-shrink-0 text-slate-400\">\n                        <span className=\"material-symbols-outlined text-xl\">\n                          {part.type === \'Blade\' ? \'shield\' : part.type === \'Ratchet\' ? \'settings\' : \'toys\'}\n                        </span>\n                      </div>\n                    )}\n                    <div className=\"min-w-0 flex-1\">\n                      <h4 className=\"font-headline font-bold text-base uppercase text-slate-900 dark:text-white truncate\">\n                        {part.name}\n                      </h4>\n                    </div>\n                  </div>\n\n                  {part.description && (\n                    <p className=\"text-xs text-slate-600 dark:text-gray-400 font-body-text leading-relaxed line-clamp-2\">\n                      {part.description}\n                    </p>\n                  )}\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Modal to Save/Register Combo by Blader */}\n      {showAddComboModal && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 dark:border-white/10 pb-3\">\n              <div>\n                <h3 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                  REGISTRAR COMBO PARA BLADER\n                </h3>\n                <p className=\"text-xs text-slate-500\">\n                  Asigna la configuraci\303\263n al arsenal del Blader en Supabase.\n                </p>\n              </div>\n              <button\n                onClick={() => setShowAddComboModal(false)}\n                className=\"w-8 h-8 rounded-full bg-slate-100 dark:bg-white/10 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleSaveCurrentCombo} className=\"space-y-4\">\n              {/* If parts exist and are selected */}\n              {currentBlade && currentRatchet && currentBit ? (\n                <div className=\"p-3.5 rounded-2xl bg-[#04A8FC]/10 border border-[#04A8FC]/30 flex items-center justify-between\">\n                  <div>\n                    <span className=\"text-[10px] font-label-caps uppercase text-[#04A8FC] font-bold block\">\n                      Configuraci\303\263n Seleccionada\n                    </span>\n                    <span className=\"font-headline font-black text-sm uppercase text-slate-900 dark:text-white\">\n                      {currentBlade?.name} {currentRatchet?.name} {currentBit?.name}\n                    </span>\n                  </div>\n                  <span className=\"font-mono text-xs font-black text-[#04A8FC]\">\n                    {stats.weightTotal}g\n                  </span>\n                </div>\n              ) : (\n                /* Free input for parts if no parts pre-registered in catalog */\n                <div className=\"space-y-3 p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10\">\n                  <span className=\"text-[11px] font-label-caps uppercase font-bold text-[#04A8FC] block\">\n                    Especificaciones del Combo (Blade + Ratchet + Bit)\n                  </span>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                    <div>\n                      <label className=\"block text-[10px] font-label-caps uppercase font-bold text-slate-500 mb-1\">\n                        1. Blade (Metal) *\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"Ej. Dransword\"\n                        value={manualBlade}\n                        onChange={(e) => setManualBlade(e.target.value)}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[10px] font-label-caps uppercase font-bold text-slate-500 mb-1\">\n                        2. Ratchet *\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"Ej. 3-60\"\n                        value={manualRatchet}\n                        onChange={(e) => setManualRatchet(e.target.value)}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[10px] font-label-caps uppercase font-bold text-slate-500 mb-1\">\n                        3. Bit (Punta) *\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"Ej. Flat\"\n                        value={manualBit}\n                        onChange={(e) => setManualBit(e.target.value)}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* Select Blader Owner */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Blader Propietario / Due\303\261o del Combo *\n                </label>\n                <select\n                  value={selectedOwnerId}\n                  onChange={(e) => setSelectedOwnerId(e.target.value)}\n                  className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm font-headline font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                >\n                  {bladers.map((b) => (\n                    <option key={b.id} value={b.id}>\n                      {b.name} ({b.team})\n                    </option>\n                  ))}\n                  <option value=\"custom\">+ Escribir otro nombre de Blader</option>\n                </select>\n              </div>\n\n              {selectedOwnerId === \'custom\' && (\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                    Nombre del Blader\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={customOwnerName}\n                    onChange={(e) => setCustomOwnerName(e.target.value)}\n                    placeholder=\"Ej. Dylan Bautista\"\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                  />\n                </div>\n              )}\n\n              {/* Assign to 3on3 Deck Slot */}\n              {selectedOwnerId !== \'custom\' && (\n                <div className=\"p-3 bg-slate-50 dark:bg-white/5 rounded-2xl border border-slate-200 dark:border-white/10 space-y-1.5\">\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300\">\n                    Asignar al Deck 3on3 del Blader\n                  </label>\n                  <select\n                    value={assignDeckSlot}\n                    onChange={(e) => setAssignDeckSlot(e.target.value)}\n                    className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold text-slate-900 dark:text-white\"\n                  >\n                    <option value=\"none\">Solo guardar en Colecci\303\263n / Arsenal</option>\n                    <option value=\"1\">Asignar como Slot 1 (Principal)</option>\n                    <option value=\"2\">Asignar como Slot 2</option>\n                    <option value=\"3\">Asignar como Slot 3</option>\n                  </select>\n                </div>\n              )}\n\n              {/* Combo Archetype */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Tipo de Estrategia\n                </label>\n                <div className=\"grid grid-cols-4 gap-2\">\n                  {([\'Attack\', \'Defense\', \'Stamina\', \'Balance\'] as const).map((t) => (\n                    <button\n                      key={t}\n                      type=\"button\"\n                      onClick={() => setComboType(t)}\n                      className={`py-2 rounded-xl text-xs font-headline font-bold uppercase transition-all ${\n                        comboType === t\n                          ? \'bg-[#04A8FC] text-white shadow-sm font-black\'\n                          : \'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400 hover:bg-slate-200\'\n                      }`}\n                    >\n                      {t === \'Attack\'\n                        ? \'Ataque\'\n                        : t === \'Defense\'\n                        ? \'Defensa\'\n                        : t === \'Stamina\'\n                        ? \'Resistencia\'\n                        : \'Equilibrio\'}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Notes */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Notas de Lanzamiento / Rendimiento (Opcional)\n                </label>\n                <textarea\n                  rows={2}\n                  value={comboNotes}\n                  onChange={(e) => setComboNotes(e.target.value)}\n                  placeholder=\"Ej. Lanzamiento en \303\241ngulo plano para enganche agresivo al X-Celerator Rail.\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-body-text focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddComboModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase font-bold text-slate-600 hover:text-slate-900 dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-black uppercase shadow-md transition-all active:scale-95\"\n                >\n                  Guardar en Base de Datos\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}"
        replacement_content: "import React, { useState } from \'react\';\nimport { BeybladePart, Blader, BladerCombo, RegisteredCombo } from \'../../types\';\nimport { soundManager } from \'../../utils/audio\';\nimport { compressImage } from \'../../utils/imageUtils\';\nimport { OFFICIAL_BEYBLADE_X_CATALOG } from \'../../data/officialParts\';\n\ninterface EquipmentScreenProps {\n  parts: BeybladePart[];\n  bladers: Blader[];\n  registeredCombos: RegisteredCombo[];\n  onAddPart: (part: BeybladePart) => void;\n  onDeletePart: (name: string) => void;\n  onAddCombo: (combo: RegisteredCombo) => void;\n  onDeleteCombo: (id: string) => void;\n  onUpdateBlader?: (blader: Blader) => void;\n}\n\nexport const EquipmentScreen: React.FC<EquipmentScreenProps> = ({\n  parts,\n  bladers,\n  registeredCombos,\n  onAddPart,\n  onDeletePart,\n  onAddCombo,\n  onDeleteCombo,\n  onUpdateBlader\n}) => {\n  const [activeTab, setActiveTab] = useState<\'combos\' | \'parts\'>(\'combos\');\n  const [selectedCategory, setSelectedCategory] = useState<\'All\' | \'Blade\' | \'Ratchet\' | \'Bit\'>(\'All\');\n  const [comboFilterType, setComboFilterType] = useState<string>(\'All\');\n  const [comboFilterBlader, setComboFilterBlader] = useState<string>(\'All\');\n\n  const [showAddPartModal, setShowAddPartModal] = useState<boolean>(false);\n  const [showAddComboModal, setShowAddComboModal] = useState<boolean>(false);\n\n  // New part form state\n  const [newName, setNewName] = useState<string>(\'\');\n  const [newType, setNewType] = useState<\'Blade\' | \'Ratchet\' | \'Bit\'>(\'Blade\');\n  const [newCategory, setNewCategory] = useState<\'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\'>(\'Attack\');\n  const [newWeight, setNewWeight] = useState<string>(\'\');\n  const [newDescription, setNewDescription] = useState<string>(\'\');\n  const [newImage, setNewImage] = useState<string>(\'\');\n  const [partImageUrl, setPartImageUrl] = useState<string>(\'\');\n  const [showPartUrlInput, setShowPartUrlInput] = useState<boolean>(false);\n  const [isCompressing, setIsCompressing] = useState<boolean>(false);\n\n  // Available pieces by type\n  const blades = parts.filter((p) => p.type === \'Blade\');\n  const ratchets = parts.filter((p) => p.type === \'Ratchet\');\n  const bits = parts.filter((p) => p.type === \'Bit\');\n\n  // Combo Modal Form State\n  const [comboBlade, setComboBlade] = useState<string>(\'\');\n  const [comboRatchet, setComboRatchet] = useState<string>(\'\');\n  const [comboBit, setComboBit] = useState<string>(\'\');\n  const [comboWeight, setComboWeight] = useState<string>(\'\');\n\n  const [selectedOwnerId, setSelectedOwnerId] = useState<string>(bladers[0]?.id || \'custom\');\n  const [customOwnerName, setCustomOwnerName] = useState<string>(\'\');\n  const [comboNotes, setComboNotes] = useState<string>(\'\');\n  const [comboType, setComboType] = useState<\'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\'>(\'Attack\');\n  const [assignDeckSlot, setAssignDeckSlot] = useState<string>(\'none\'); // \'none\', \'1\', \'2\', \'3\'\n\n  const filteredParts = parts.filter((p) => {\n    if (selectedCategory === \'All\') return true;\n    return p.type === selectedCategory;\n  });\n\n  const filteredCombos = registeredCombos.filter((c) => {\n    const matchesType = comboFilterType === \'All\' || c.type === comboFilterType;\n    const matchesBlader =\n      comboFilterBlader === \'All\' ||\n      c.bladerId === comboFilterBlader ||\n      c.bladerName.toLowerCase() === comboFilterBlader.toLowerCase();\n    return matchesType && matchesBlader;\n  });\n\n  const handlePartImageUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    try {\n      setIsCompressing(true);\n      const dataUrl = await compressImage(file, 400, 400, 0.85);\n      setNewImage(dataUrl);\n    } catch (err) {\n      console.error(\'Error uploading part photo:\', err);\n    } finally {\n      setIsCompressing(false);\n    }\n  };\n\n  const handleCreatePart = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newName.trim()) return;\n\n    soundManager.playClick();\n    const newPart: BeybladePart = {\n      name: newName.trim(),\n      type: newType,\n      category: newCategory,\n      weight: newWeight.trim() ? `${newWeight.trim()}${newWeight.includes(\'g\') ? \'\' : \'g\'}` : undefined,\n      description: newDescription.trim() || undefined,\n      image: newImage || partImageUrl.trim() || undefined\n    };\n\n    onAddPart(newPart);\n\n    setNewName(\'\');\n    setNewWeight(\'\');\n    setNewDescription(\'\');\n    setNewImage(\'\');\n    setPartImageUrl(\'\');\n    setShowAddPartModal(false);\n  };\n\n  // Bulk import official Beyblade X Catalog\n  const handleImportOfficialCatalog = () => {\n    soundManager.playScore();\n    OFFICIAL_BEYBLADE_X_CATALOG.forEach((part) => {\n      onAddPart(part);\n    });\n  };\n\n  const handleSaveCurrentCombo = (e: React.FormEvent) => {\n    e.preventDefault();\n\n    const bladeVal = comboBlade.trim();\n    const ratchetVal = comboRatchet.trim();\n    const bitVal = comboBit.trim();\n\n    if (!bladeVal || !ratchetVal || !bitVal) {\n      alert(\'Por favor especifica la Blade, Ratchet y Bit del combo.\');\n      return;\n    }\n\n    soundManager.playScore();\n\n    let bladerName = \'\';\n    let bladerId: string | undefined = undefined;\n    let targetBlader: Blader | undefined = undefined;\n\n    if (selectedOwnerId === \'custom\' || !selectedOwnerId) {\n      bladerName = customOwnerName.trim() || \'Blader C\303\272cuta\';\n    } else {\n      targetBlader = bladers.find((b) => b.id === selectedOwnerId);\n      bladerName = targetBlader?.name || \'Blader C\303\272cuta\';\n      bladerId = targetBlader?.id;\n    }\n\n    const calculatedWeight = comboWeight.trim()\n      ? `${comboWeight.trim()}${comboWeight.includes(\'g\') ? \'\' : \'g\'}`\n      : undefined;\n\n    const comboFullName = `${bladeVal} ${ratchetVal}${bitVal}`;\n\n    const newCombo: RegisteredCombo = {\n      id: `combo-${Date.now()}`,\n      bladerId,\n      bladerName,\n      blade: bladeVal,\n      ratchet: ratchetVal,\n      bit: bitVal,\n      type: comboType,\n      weight: calculatedWeight,\n      notes: comboNotes.trim() || undefined,\n      createdAt: new Date().toISOString()\n    };\n\n    onAddCombo(newCombo);\n\n    // If assigned to a deck slot (1, 2, or 3) and target blader exists, update the blader\'s deck\n    if (assignDeckSlot !== \'none\' && targetBlader && onUpdateBlader) {\n      const slotNum = parseInt(assignDeckSlot, 10) as 1 | 2 | 3;\n      const currentCombos = targetBlader.combos || [];\n      const updatedCombos: BladerCombo[] = [\n        currentCombos.find((c) => c.slot === 1) || { slot: 1, blade: \'Dransword\', ratchet: \'3-60\', bit: \'F\', name: \'Dransword 3-60F\' },\n        currentCombos.find((c) => c.slot === 2) || { slot: 2, blade: \'Hellscythe\', ratchet: \'4-60\', bit: \'T\', name: \'Hellscythe 4-60T\' },\n        currentCombos.find((c) => c.slot === 3) || { slot: 3, blade: \'Wizardarrow\', ratchet: \'4-80\', bit: \'B\', name: \'Wizardarrow 4-80B\' }\n      ].map((c) => {\n        if (c.slot === slotNum) {\n          return {\n            slot: slotNum,\n            blade: bladeVal,\n            ratchet: ratchetVal,\n            bit: bitVal,\n            name: comboFullName\n          };\n        }\n        return c;\n      });\n\n      const updatedBlader: Blader = {\n        ...targetBlader,\n        combos: updatedCombos\n      };\n      onUpdateBlader(updatedBlader);\n    }\n\n    setShowAddComboModal(false);\n    setComboNotes(\'\');\n    setCustomOwnerName(\'\');\n    setComboBlade(\'\');\n    setComboRatchet(\'\');\n    setComboBit(\'\');\n    setComboWeight(\'\');\n    setAssignDeckSlot(\'none\');\n  };\n\n  const openAddComboWithDefaults = () => {\n    soundManager.playClick();\n    if (blades.length > 0 && !comboBlade) setComboBlade(blades[0].name);\n    if (ratchets.length > 0 && !comboRatchet) setComboRatchet(ratchets[0].name);\n    if (bits.length > 0 && !comboBit) setComboBit(bits[0].name);\n    setShowAddComboModal(true);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-slate-200 dark:border-white/10 pb-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <h1 className=\"font-headline font-black text-3xl md:text-5xl text-slate-900 dark:text-white uppercase tracking-tight\">\n              EQUIPAMIENTO & COMBOS\n            </h1>\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#04A8FC]/10 text-[#04A8FC] text-[11px] font-headline font-bold uppercase border border-[#04A8FC]/20\">\n              <span className=\"w-2 h-2 rounded-full bg-[#04A8FC] animate-pulse\"></span>\n              Base de Datos Supabase\n            </span>\n          </div>\n          <p className=\"font-body-text text-base text-slate-600 dark:text-slate-400\">\n            Armero oficial de piezas, registro de combos y asignaci\303\263n directa a los Decks 3on3 de los Bladers.\n          </p>\n        </div>\n\n        {/* Action Buttons */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <button\n            onClick={openAddComboWithDefaults}\n            className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-4 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02] active:scale-95\"\n          >\n            <span className=\"material-symbols-outlined text-base\">bookmark_add</span>\n            <span>Registrar Combo</span>\n          </button>\n\n          <button\n            onClick={() => {\n              soundManager.playClick();\n              setShowAddPartModal(true);\n            }}\n            className=\"bg-slate-100 dark:bg-white/10 hover:bg-slate-200 dark:hover:bg-white/15 text-slate-800 dark:text-white px-4 py-2.5 rounded-xl font-headline font-bold text-xs uppercase flex items-center gap-1.5 transition-all\"\n          >\n            <span className=\"material-symbols-outlined text-base\">add</span>\n            <span>Nueva Pieza</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Tabs */}\n      <div className=\"flex items-center gap-2 border-b border-slate-200 dark:border-white/10 pb-2\">\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'combos\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-bold text-xs uppercase tracking-wider transition-all flex items-center gap-2 ${\n            activeTab === \'combos\'\n              ? \'bg-[#04A8FC] text-white shadow-md shadow-[#04A8FC]/20\'\n              : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/5\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-base\">military_tech</span>\n          <span>Combos Registrados ({registeredCombos.length})</span>\n        </button>\n\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setActiveTab(\'parts\');\n          }}\n          className={`px-5 py-2.5 rounded-xl font-headline font-bold text-xs uppercase tracking-wider transition-all flex items-center gap-2 ${\n            activeTab === \'parts\'\n              ? \'bg-[#04A8FC] text-white shadow-md shadow-[#04A8FC]/20\'\n              : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/5\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-base\">category</span>\n          <span>Cat\303\241logo de Piezas ({parts.length})</span>\n        </button>\n      </div>\n\n      {/* TAB 1: COMBOS ARMORY */}\n      {activeTab === \'combos\' && (\n        <div className=\"space-y-6\">\n          {/* Registered Combos Header & Filters */}\n          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n            <h3 className=\"font-headline font-black text-xl uppercase text-slate-900 dark:text-white flex items-center gap-2\">\n              <span className=\"material-symbols-outlined text-[#04A8FC]\">military_tech</span>\n              <span>Padr\303\263n de Combos Registrados ({filteredCombos.length})</span>\n            </h3>\n\n            {/* Filters */}\n            <div className=\"flex flex-wrap items-center gap-2\">\n              <select\n                value={comboFilterType}\n                onChange={(e) => setComboFilterType(e.target.value)}\n                className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold uppercase text-slate-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-[#04A8FC]\"\n              >\n                <option value=\"All\">Todos los Tipos</option>\n                <option value=\"Attack\">Ataque</option>\n                <option value=\"Defense\">Defensa</option>\n                <option value=\"Stamina\">Resistencia</option>\n                <option value=\"Balance\">Equilibrio</option>\n              </select>\n\n              <select\n                value={comboFilterBlader}\n                onChange={(e) => setComboFilterBlader(e.target.value)}\n                className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold uppercase text-slate-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-[#04A8FC]\"\n              >\n                <option value=\"All\">Todos los Bladers</option>\n                {bladers.map((b) => (\n                  <option key={b.id} value={b.id}>\n                    {b.name}\n                  </option>\n                ))}\n              </select>\n            </div>\n          </div>\n\n          {filteredCombos.length === 0 ? (\n            <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-4 bg-white dark:bg-[#15151c]\">\n              <div className=\"w-14 h-14 rounded-2xl bg-[#04A8FC]/10 text-[#04A8FC] flex items-center justify-center mx-auto\">\n                <span className=\"material-symbols-outlined text-3xl\">sports_martial_arts</span>\n              </div>\n              <div className=\"space-y-1\">\n                <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                  No Hay Combos Registrados\n                </h4>\n                <p className=\"text-xs text-slate-500 max-w-sm mx-auto\">\n                  A\303\272n no se han guardado combinaciones en la base de datos. Haz clic en \"Registrar Combo\" para asignar el primer Beyblade a un Blader.\n                </p>\n              </div>\n              <button\n                onClick={openAddComboWithDefaults}\n                className=\"px-5 py-2.5 bg-[#04A8FC] text-white rounded-xl font-headline font-black text-xs uppercase shadow-md flex items-center gap-1.5 mx-auto\"\n              >\n                <span className=\"material-symbols-outlined text-base\">add_circle</span>\n                <span>Registrar Primer Combo</span>\n              </button>\n            </div>\n          ) : (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {filteredCombos.map((combo) => (\n                <div\n                  key={combo.id}\n                  className=\"p-5 rounded-3xl border border-slate-200 dark:border-white/5 bg-white dark:bg-[#15151c] hover:border-[#04A8FC] transition-all space-y-3 relative group shadow-sm\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span\n                      className={`text-[10px] font-label-caps font-black px-2.5 py-0.5 rounded-full uppercase ${\n                        combo.type === \'Attack\'\n                          ? \'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20\'\n                          : combo.type === \'Defense\'\n                          ? \'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20\'\n                          : combo.type === \'Stamina\'\n                          ? \'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20\'\n                          : \'bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20\'\n                      }`}\n                    >\n                      {combo.type}\n                    </span>\n                    <div className=\"flex items-center gap-2\">\n                      {combo.weight && (\n                        <span className=\"font-mono text-xs font-bold text-slate-500 dark:text-slate-400\">\n                          {combo.weight}\n                        </span>\n                      )}\n                      <button\n                        onClick={() => {\n                          soundManager.playClick();\n                          onDeleteCombo(combo.id);\n                        }}\n                        className=\"opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 p-0.5 rounded transition-opacity\"\n                        title=\"Eliminar combo\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    </div>\n                  </div>\n\n                  <div>\n                    <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                      {combo.blade} {combo.ratchet}{combo.bit}\n                    </h4>\n                    <div className=\"flex items-center gap-1.5 text-xs text-slate-500 mt-1\">\n                      <span className=\"material-symbols-outlined text-xs text-[#04A8FC]\">person</span>\n                      <span className=\"font-headline font-bold uppercase text-slate-700 dark:text-slate-300\">\n                        {combo.bladerName}\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-3 gap-1.5 pt-2 border-t border-slate-100 dark:border-white/5 text-center\">\n                    <div className=\"p-1.5 rounded-xl bg-slate-50 dark:bg-white/5\">\n                      <span className=\"text-[9px] font-label-caps uppercase text-slate-400 block font-bold\">Blade</span>\n                      <span className=\"font-headline font-bold text-xs uppercase text-slate-800 dark:text-white truncate block\">\n                        {combo.blade}\n                      </span>\n                    </div>\n                    <div className=\"p-1.5 rounded-xl bg-slate-50 dark:bg-white/5\">\n                      <span className=\"text-[9px] font-label-caps uppercase text-slate-400 block font-bold\">Ratchet</span>\n                      <span className=\"font-headline font-bold text-xs uppercase text-slate-800 dark:text-white truncate block\">\n                        {combo.ratchet}\n                      </span>\n                    </div>\n                    <div className=\"p-1.5 rounded-xl bg-slate-50 dark:bg-white/5\">\n                      <span className=\"text-[9px] font-label-caps uppercase text-slate-400 block font-bold\">Bit</span>\n                      <span className=\"font-headline font-bold text-xs uppercase text-slate-800 dark:text-white truncate block\">\n                        {combo.bit}\n                      </span>\n                    </div>\n                  </div>\n\n                  {combo.notes && (\n                    <p className=\"text-xs text-slate-500 dark:text-slate-400 italic pt-1 border-t border-slate-100 dark:border-white/5 line-clamp-2\">\n                      \"{combo.notes}\"\n                    </p>\n                  )}\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* TAB 2: PARTS CATALOG */}\n      {activeTab === \'parts\' && (\n        <div className=\"space-y-6\">\n          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n            {/* Category Filter */}\n            <div className=\"flex items-center gap-2\">\n              {([\'All\', \'Blade\', \'Ratchet\', \'Bit\'] as const).map((cat) => (\n                <button\n                  key={cat}\n                  onClick={() => {\n                    soundManager.playClick();\n                    setSelectedCategory(cat);\n                  }}\n                  className={`px-3.5 py-1.5 rounded-xl text-xs font-headline font-bold uppercase transition-all ${\n                    selectedCategory === cat\n                      ? \'bg-[#04A8FC] text-white shadow-sm font-black\'\n                      : \'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400 hover:bg-slate-200\'\n                  }`}\n                >\n                  {cat === \'All\' ? \'Todas\' : `${cat}s`}\n                </button>\n              ))}\n            </div>\n\n            {/* Import official catalog button */}\n            <button\n              onClick={handleImportOfficialCatalog}\n              className=\"px-3.5 py-1.5 rounded-xl text-xs font-headline font-bold uppercase bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 text-slate-700 dark:text-slate-300 flex items-center gap-1.5 transition-all\"\n              title=\"Cargar lote de piezas est\303\241ndar Takara Tomy a Supabase\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">download</span>\n              <span>+ Importar 19 Piezas Oficiales Beyblade X</span>\n            </button>\n          </div>\n\n          {/* Parts Grid */}\n          {filteredParts.length === 0 ? (\n            <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-4 bg-white dark:bg-[#15151c]\">\n              <div className=\"w-14 h-14 rounded-2xl bg-[#04A8FC]/10 text-[#04A8FC] flex items-center justify-center mx-auto\">\n                <span className=\"material-symbols-outlined text-3xl\">precision_manufacturing</span>\n              </div>\n              <div className=\"space-y-1\">\n                <h4 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                  Cat\303\241logo de Piezas Vac\303\255o\n                </h4>\n                <p className=\"text-xs text-slate-500 max-w-sm mx-auto\">\n                  No hay piezas en el cat\303\241logo. Puedes registrar piezas personalizadas con foto y peso o importar el lote oficial.\n                </p>\n              </div>\n              <div className=\"flex flex-wrap items-center justify-center gap-3\">\n                <button\n                  onClick={() => setShowAddPartModal(true)}\n                  className=\"px-5 py-2.5 bg-[#04A8FC] hover:bg-[#008fe0] text-white rounded-xl font-headline font-black text-xs uppercase shadow-md flex items-center gap-1.5\"\n                >\n                  <span className=\"material-symbols-outlined text-base\">add_circle</span>\n                  <span>Registrar Pieza</span>\n                </button>\n                <button\n                  onClick={handleImportOfficialCatalog}\n                  className=\"px-5 py-2.5 bg-slate-200 dark:bg-white/10 text-slate-800 dark:text-white rounded-xl font-headline font-bold text-xs uppercase\"\n                >\n                  + Importar Lote Oficial (19 Piezas)\n                </button>\n              </div>\n            </div>\n          ) : (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {filteredParts.map((part) => (\n                <div\n                  key={part.name}\n                  className=\"p-4 rounded-3xl border border-slate-200 dark:border-white/5 bg-white dark:bg-[#15151c] hover:border-[#04A8FC] transition-all space-y-2.5 relative group shadow-sm\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span\n                      className={`text-[10px] font-label-caps font-black px-2 py-0.5 rounded-lg uppercase ${\n                        part.type === \'Blade\'\n                          ? \'bg-red-500/10 text-red-600 dark:text-red-400\'\n                          : part.type === \'Ratchet\'\n                          ? \'bg-amber-500/10 text-amber-600 dark:text-amber-400\'\n                          : \'bg-blue-500/10 text-blue-600 dark:text-blue-400\'\n                      }`}\n                    >\n                      {part.type} {part.category ? `\342\200\242 ${part.category}` : \'\'}\n                    </span>\n                    <div className=\"flex items-center gap-2\">\n                      {part.weight && (\n                        <span className=\"font-mono text-xs font-bold text-slate-500 dark:text-slate-400\">\n                          {part.weight}\n                        </span>\n                      )}\n                      <button\n                        onClick={() => {\n                          soundManager.playClick();\n                          onDeletePart(part.name);\n                        }}\n                        className=\"opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 p-0.5 rounded transition-opacity\"\n                        title=\"Eliminar pieza\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-3\">\n                    {part.image ? (\n                      <div className=\"w-12 h-12 rounded-xl overflow-hidden bg-slate-100 dark:bg-white/5 flex-shrink-0 border border-slate-200 dark:border-white/10\">\n                        <img src={part.image} alt={part.name} className=\"w-full h-full object-cover\" />\n                      </div>\n                    ) : (\n                      <div className=\"w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/5 flex items-center justify-center flex-shrink-0 text-slate-400\">\n                        <span className=\"material-symbols-outlined text-xl\">\n                          {part.type === \'Blade\' ? \'shield\' : part.type === \'Ratchet\' ? \'settings\' : \'toys\'}\n                        </span>\n                      </div>\n                    )}\n                    <div className=\"min-w-0 flex-1\">\n                      <h4 className=\"font-headline font-bold text-base uppercase text-slate-900 dark:text-white truncate\">\n                        {part.name}\n                      </h4>\n                    </div>\n                  </div>\n\n                  {part.description && (\n                    <p className=\"text-xs text-slate-600 dark:text-gray-400 font-body-text leading-relaxed line-clamp-2\">\n                      {part.description}\n                    </p>\n                  )}\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Modal to Save/Register Combo by Blader */}\n      {showAddComboModal && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 dark:border-white/10 pb-3\">\n              <div>\n                <h3 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                  REGISTRAR COMBO PARA BLADER\n                </h3>\n                <p className=\"text-xs text-slate-500\">\n                  Asigna la configuraci\303\263n al arsenal del Blader en Supabase.\n                </p>\n              </div>\n              <button\n                onClick={() => setShowAddComboModal(false)}\n                className=\"w-8 h-8 rounded-full bg-slate-100 dark:bg-white/10 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleSaveCurrentCombo} className=\"space-y-4\">\n              {/* Components Selection */}\n              <div className=\"space-y-3 p-4 rounded-2xl bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10\">\n                <span className=\"text-[11px] font-label-caps uppercase font-bold text-[#04A8FC] block\">\n                  1. Componentes del Beyblade (Blade + Ratchet + Bit)\n                </span>\n                \n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\">\n                  {/* Blade */}\n                  <div>\n                    <label className=\"block text-[10px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                      Blade (Metal) *\n                    </label>\n                    {blades.length > 0 ? (\n                      <div className=\"space-y-1\">\n                        <select\n                          value={comboBlade}\n                          onChange={(e) => setComboBlade(e.target.value)}\n                          className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                        >\n                          <option value=\"\">-- Elige Blade --</option>\n                          {blades.map((b) => (\n                            <option key={b.name} value={b.name}>\n                              {b.name}\n                            </option>\n                          ))}\n                        </select>\n                        <input\n                          type=\"text\"\n                          placeholder=\"o escribe...\"\n                          value={comboBlade}\n                          onChange={(e) => setComboBlade(e.target.value)}\n                          className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1 text-[11px] text-slate-900 dark:text-white font-headline focus:outline-none\"\n                        />\n                      </div>\n                    ) : (\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"Ej. Dransword\"\n                        value={comboBlade}\n                        onChange={(e) => setComboBlade(e.target.value)}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                      />\n                    )}\n                  </div>\n\n                  {/* Ratchet */}\n                  <div>\n                    <label className=\"block text-[10px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                      Ratchet *\n                    </label>\n                    {ratchets.length > 0 ? (\n                      <div className=\"space-y-1\">\n                        <select\n                          value={comboRatchet}\n                          onChange={(e) => setComboRatchet(e.target.value)}\n                          className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                        >\n                          <option value=\"\">-- Elige Ratchet --</option>\n                          {ratchets.map((r) => (\n                            <option key={r.name} value={r.name}>\n                              {r.name}\n                            </option>\n                          ))}\n                        </select>\n                        <input\n                          type=\"text\"\n                          placeholder=\"o escribe...\"\n                          value={comboRatchet}\n                          onChange={(e) => setComboRatchet(e.target.value)}\n                          className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1 text-[11px] text-slate-900 dark:text-white font-headline focus:outline-none\"\n                        />\n                      </div>\n                    ) : (\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"Ej. 3-60\"\n                        value={comboRatchet}\n                        onChange={(e) => setComboRatchet(e.target.value)}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                      />\n                    )}\n                  </div>\n\n                  {/* Bit */}\n                  <div>\n                    <label className=\"block text-[10px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                      Bit (Punta) *\n                    </label>\n                    {bits.length > 0 ? (\n                      <div className=\"space-y-1\">\n                        <select\n                          value={comboBit}\n                          onChange={(e) => setComboBit(e.target.value)}\n                          className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                        >\n                          <option value=\"\">-- Elige Bit --</option>\n                          {bits.map((bt) => (\n                            <option key={bt.name} value={bt.name}>\n                              {bt.name}\n                            </option>\n                          ))}\n                        </select>\n                        <input\n                          type=\"text\"\n                          placeholder=\"o escribe...\"\n                          value={comboBit}\n                          onChange={(e) => setComboBit(e.target.value)}\n                          className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1 text-[11px] text-slate-900 dark:text-white font-headline focus:outline-none\"\n                        />\n                      </div>\n                    ) : (\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"Ej. Flat\"\n                        value={comboBit}\n                        onChange={(e) => setComboBit(e.target.value)}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                      />\n                    )}\n                  </div>\n                </div>\n\n                <div className=\"pt-1\">\n                  <label className=\"block text-[10px] font-label-caps uppercase font-bold text-slate-500 mb-1\">\n                    Peso Total Opcional (g)\n                  </label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"Ej. 43.5g\"\n                    value={comboWeight}\n                    onChange={(e) => setComboWeight(e.target.value)}\n                    className=\"w-full sm:w-1/2 bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-2.5 py-1.5 text-xs text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                  />\n                </div>\n              </div>\n\n              {/* Select Blader Owner */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Blader Propietario / Due\303\261o del Combo *\n                </label>\n                <select\n                  value={selectedOwnerId}\n                  onChange={(e) => setSelectedOwnerId(e.target.value)}\n                  className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm font-headline font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                >\n                  {bladers.map((b) => (\n                    <option key={b.id} value={b.id}>\n                      {b.name} ({b.team})\n                    </option>\n                  ))}\n                  <option value=\"custom\">+ Escribir otro nombre de Blader</option>\n                </select>\n              </div>\n\n              {selectedOwnerId === \'custom\' && (\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                    Nombre del Blader\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={customOwnerName}\n                    onChange={(e) => setCustomOwnerName(e.target.value)}\n                    placeholder=\"Ej. Dylan Bautista\"\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                  />\n                </div>\n              )}\n\n              {/* Assign to 3on3 Deck Slot */}\n              {selectedOwnerId !== \'custom\' && (\n                <div className=\"p-3 bg-slate-50 dark:bg-white/5 rounded-2xl border border-slate-200 dark:border-white/10 space-y-1.5\">\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300\">\n                    Asignar al Deck 3on3 del Blader\n                  </label>\n                  <select\n                    value={assignDeckSlot}\n                    onChange={(e) => setAssignDeckSlot(e.target.value)}\n                    className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs font-headline font-bold text-slate-900 dark:text-white\"\n                  >\n                    <option value=\"none\">Solo guardar en Colecci\303\263n / Arsenal</option>\n                    <option value=\"1\">Asignar como Slot 1 (Principal)</option>\n                    <option value=\"2\">Asignar como Slot 2</option>\n                    <option value=\"3\">Asignar como Slot 3</option>\n                    </select>\n                </div>\n              )}\n\n              {/* Combo Archetype */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Tipo de Estrategia\n                </label>\n                <div className=\"grid grid-cols-4 gap-2\">\n                  {([\'Attack\', \'Defense\', \'Stamina\', \'Balance\'] as const).map((t) => (\n                    <button\n                      key={t}\n                      type=\"button\"\n                      onClick={() => setComboType(t)}\n                      className={`py-2 rounded-xl text-xs font-headline font-bold uppercase transition-all ${\n                        comboType === t\n                          ? \'bg-[#04A8FC] text-white shadow-sm font-black\'\n                          : \'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400 hover:bg-slate-200\'\n                      }`}\n                    >\n                      {t === \'Attack\'\n                        ? \'Ataque\'\n                        : t === \'Defense\'\n                        ? \'Defensa\'\n                        : t === \'Stamina\'\n                        ? \'Resistencia\'\n                        : \'Equilibrio\'}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Notes */}\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Notas de Lanzamiento / Rendimiento (Opcional)\n                </label>\n                <textarea\n                  rows={2}\n                  value={comboNotes}\n                  onChange={(e) => setComboNotes(e.target.value)}\n                  placeholder=\"Ej. Lanzamiento en \303\241ngulo plano para enganche agresivo al X-Celerator Rail.\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-body-text focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddComboModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase font-bold text-slate-600 hover:text-slate-900 dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-black uppercase shadow-md transition-all active:scale-95\"\n                >\n                  Guardar en Base de Datos\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* Modal to register new piece */}\n      {showAddPartModal && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 dark:border-white/10 pb-3\">\n              <h3 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                Registrar Nueva Pieza\n              </h3>\n              <button\n                onClick={() => setShowAddPartModal(false)}\n                className=\"text-slate-400 hover:text-slate-900 dark:hover:text-white font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleCreatePart} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Nombre de la Pieza *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={newName}\n                  onChange={(e) => setNewName(e.target.value)}\n                  placeholder=\"Ej. Dransword, 3-60, Flat, Phoenix Wing...\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                    Tipo de Componente\n                  </label>\n                  <select\n                    value={newType}\n                    onChange={(e) => setNewType(e.target.value as \'Blade\' | \'Ratchet\' | \'Bit\')}\n                    className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold text-slate-900 dark:text-white\"\n                  >\n                    <option value=\"Blade\">Blade (Metal superior)</option>\n                    <option value=\"Ratchet\">Ratchet (Trinquete)</option>\n                    <option value=\"Bit\">Bit (Punta de eje)</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                    Arquetipo\n                  </label>\n                  <select\n                    value={newCategory}\n                    onChange={(e) => setNewCategory(e.target.value as any)}\n                    className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold text-slate-900 dark:text-white\"\n                  >\n                    <option value=\"Attack\">Ataque</option>\n                    <option value=\"Defense\">Defensa</option>\n                    <option value=\"Stamina\">Resistencia</option>\n                    <option value=\"Balance\">Equilibrio</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Peso Oficial / Balanza (Opcional)\n                </label>\n                <input\n                  type=\"text\"\n                  value={newWeight}\n                  onChange={(e) => setNewWeight(e.target.value)}\n                  placeholder=\"Ej. 35.2g, 6.8g, 2.3g\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-mono focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              {/* Photo Upload / URL */}\n              <div className=\"space-y-2\">\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300\">\n                  Foto de la Pieza (Opcional)\n                </label>\n                <div className=\"flex items-center gap-3\">\n                  {newImage ? (\n                    <div className=\"w-14 h-14 rounded-2xl overflow-hidden bg-slate-100 dark:bg-white/5 relative border border-slate-200 dark:border-white/10\">\n                      <img src={newImage} alt=\"Preview\" className=\"w-full h-full object-cover\" />\n                      <button\n                        type=\"button\"\n                        onClick={() => setNewImage(\'\')}\n                        className=\"absolute top-0.5 right-0.5 bg-red-500 text-white rounded-full w-4 h-4 flex items-center justify-center text-[10px]\"\n                      >\n                        \342\234\225\n                      </button>\n                    </div>\n                  ) : null}\n\n                  <label className=\"cursor-pointer px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-white/5 dark:hover:bg-white/10 border border-slate-300 dark:border-white/10 text-xs font-headline font-bold text-slate-700 dark:text-white flex items-center gap-1.5 transition-all\">\n                    <span className=\"material-symbols-outlined text-base text-[#04A8FC]\">photo_camera</span>\n                    <span>{isCompressing ? \'Procesando...\' : \'Subir Foto\'}</span>\n                    <input\n                      type=\"file\"\n                      accept=\"image/*\"\n                      onChange={handlePartImageUpload}\n                      disabled={isCompressing}\n                      className=\"hidden\"\n                    />\n                  </label>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowPartUrlInput(!showPartUrlInput)}\n                    className=\"text-xs text-[#04A8FC] hover:underline font-label-caps\"\n                  >\n                    {showPartUrlInput ? \'Ocultar URL\' : \'O usar URL\'}\n                  </button>\n                </div>\n\n                {showPartUrlInput && (\n                  <input\n                    type=\"url\"\n                    value={partImageUrl}\n                    onChange={(e) => setPartImageUrl(e.target.value)}\n                    placeholder=\"https://ejemplo.com/dransword.png\"\n                    className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-1.5 text-xs text-slate-900 dark:text-white font-mono focus:ring-2 focus:ring-[#04A8FC] focus:outline-none\"\n                  />\n                )}\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-700 dark:text-slate-300 mb-1\">\n                  Descripci\303\263n o Notas\n                </label>\n                <textarea\n                  rows={2}\n                  value={newDescription}\n                  onChange={(e) => setNewDescription(e.target.value)}\n                  placeholder=\"Ej. Hoja de tres alas met\303\241licas especializada en impacto frontal masivo.\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-body-text focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddPartModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase font-bold text-slate-600 hover:text-slate-900 dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-black uppercase shadow-md transition-all active:scale-95\"\n                >\n                  Guardar Pieza\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
