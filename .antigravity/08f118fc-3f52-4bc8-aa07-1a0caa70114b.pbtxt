  file_change {
    absolute_path_uri: "file:///src/components/screens/EquipmentScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n        <div>\n          <h1 className=\"font-headline font-black text-3xl md:text-5xl text-[#1a1c1e] dark:text-white uppercase tracking-tight mb-2\">\n            EQUIPAMIENTO & COMBO BUILDER X\n          </h1>\n          <p className=\"font-body-text text-base text-gray-600 dark:text-gray-400\">\n            Base de datos oficial de piezas Takara Tomy / Hasbro Xtreme Series y simulador de rendimiento.\n          </p>\n        </div>\n\n        {/* Action Button */}\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setShowAddModal(true);\n          }}\n          className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-4 py-2.5 rounded-xl font-headline font-bold text-xs uppercase flex items-center gap-2 shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02]\"\n        >\n          <span className=\"material-symbols-outlined text-base\">add_circle</span>\n          <span>Registrar Pieza</span>\n        </button>\n      </div>\n\n      {/* Empty Database State */}\n      {!hasAnyParts ? (\n        <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-[#bec7d3]/40 dark:border-white/10 text-center space-y-4\">\n          <div className=\"w-16 h-16 rounded-2xl bg-[#04A8FC]/10 border border-[#04A8FC]/30 flex items-center justify-center text-[#04A8FC] mx-auto\">\n            <span className=\"material-symbols-outlined text-3xl\">precision_manufacturing</span>\n          </div>\n          <h3 className=\"font-headline font-black text-xl uppercase text-[#1a1c1e] dark:text-white\">\n            Base de Datos de Piezas Vac\303\255a\n          </h3>\n          <p className=\"font-body-text text-sm text-gray-500 max-w-md mx-auto\">\n            No hay piezas registradas en el sistema. Puedes agregar Blades, Ratchets y Bits oficiales utilizando el bot\303\263n de registro para habilitar el simulador de combos.\n          </p>\n          <button\n            onClick={() => setShowAddModal(true)}\n            className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-6 py-2.5 rounded-xl font-headline font-bold text-xs uppercase shadow-md shadow-[#04A8FC]/20\"\n          >\n            Registrar Primera Pieza\n          </button>\n        </div>\n      ) : (\n        <>\n          {/* Combo Builder Studio (Top Bento) */}\n          {canBuildCombo ? (\n            <div className=\"glass-panel p-6 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm relative overflow-hidden bg-gradient-to-r from-transparent via-[#04A8FC]/5 to-transparent\">\n              <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n                {/* Visual Combo Display */}\n                <div className=\"lg:col-span-5 flex flex-col items-center text-center\">\n                  <div className=\"w-52 h-52 rounded-2xl bg-white dark:bg-[#161620] border-2 border-[#04A8FC] p-4 flex items-center justify-center shadow-lg shadow-[#04A8FC]/20 relative\">\n                    <BeybladeVisualizer\n                      bladeName={currentBlade?.name || \'Custom Blade\'}\n                      ratchetName={currentRatchet?.name || \'3-60\'}\n                      bitName={currentBit?.name || \'F\'}\n                      size=\"lg\"\n                    />\n                    <div className=\"absolute -bottom-3 bg-[#04A8FC] text-white text-[10px] font-label-caps uppercase px-3 py-1 rounded-full font-black tracking-widest shadow\">\n                      XTREME SYSTEM\n                    </div>\n                  </div>\n                  <h3 className=\"font-headline font-black text-2xl uppercase text-[#1a1c1e] dark:text-white mt-5\">\n                    {currentBlade?.name} {currentRatchet?.name} {currentBit?.name?.split(\' \')[0]}\n                  </h3>\n                  <p className=\"font-label-caps text-xs text-gray-500 dark:text-gray-400 uppercase\">\n                    Peso Estimado Total: <span className=\"text-[#04A8FC] font-bold\">{stats.weightTotal}g</span>\n                  </p>\n                </div>\n\n                {/* Selectors & Performance Radar */}\n                <div className=\"lg:col-span-7 space-y-6\">\n                  {/* Parts Selectors */}\n                  <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                    <div>\n                      <label className=\"block text-[11px] font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                        1. Blade (Capa de Metal)\n                      </label>\n                      <select\n                        value={currentBlade?.name || \'\'}\n                        onChange={(e) => {\n                          soundManager.playClick();\n                          setActiveBlade(e.target.value);\n                        }}\n                        className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                      >\n                        {blades.map((b) => (\n                          <option key={b.name} value={b.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                            {b.name} {b.weight ? `(${b.weight})` : \'\'}\n                          </option>\n                        ))}\n                      </select>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-[11px] font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                        2. Ratchet (Trinquete)\n                      </label>\n                      <select\n                        value={currentRatchet?.name || \'\'}\n                        onChange={(e) => {\n                          soundManager.playClick();\n                          setActiveRatchet(e.target.value);\n                        }}\n                        className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                      >\n                        {ratchets.map((r) => (\n                          <option key={r.name} value={r.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                            {r.name} {r.weight ? `(${r.weight})` : \'\'}\n                          </option>\n                        ))}\n                      </select>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-[11px] font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                        3. Bit (Punta de Engranaje)\n                      </label>\n                      <select\n                        value={currentBit?.name || \'\'}\n                        onChange={(e) => {\n                          soundManager.playClick();\n                          setActiveBit(e.target.value);\n                        }}\n                        className=\"w-full bg-black/5 dark:bg-[#1a1a24] border border-[#bec7d3]/40 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-label-caps uppercase text-[#1a1c1e] dark:text-white focus:outline-none focus:border-[#04A8FC]\"\n                      >\n                        {bits.map((bt) => (\n                          <option key={bt.name} value={bt.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                            {bt.name}\n                          </option>\n                        ))}\n                      </select>\n                    </div>\n                  </div>\n\n                  {/* Performance Stats Bars */}\n                  <div className=\"space-y-3 pt-2\">\n                    <h4 className=\"font-headline font-bold text-xs uppercase text-gray-500 tracking-wider\">\n                      M\303\251tricas de Rendimiento en Estadio\n                    </h4>\n\n                    {/* Attack */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-[#AC191F]\">Poder de Ataque</span>\n                        <span className=\"font-bold text-[#AC191F]\">{stats.attack} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-[#AC191F] transition-all duration-300\"\n                          style={{ width: `${stats.attack}%` }}\n                        ></div>\n                      </div>\n                    </div>\n\n                    {/* Defense */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-emerald-500\">Defensa & Retenci\303\263n</span>\n                        <span className=\"font-bold text-emerald-500\">{stats.defense} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-emerald-500 transition-all duration-300\"\n                          style={{ width: `${stats.defense}%` }}\n                        ></div>\n                      </div>\n                    </div>\n\n                    {/* Stamina */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-[#04A8FC]\">Resistencia Centr\303\255fuga</span>\n                        <span className=\"font-bold text-[#04A8FC]\">{stats.stamina} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-[#04A8FC] transition-all duration-300\"\n                          style={{ width: `${stats.stamina}%` }}\n                        ></div>\n                      </div>\n                    </div>\n\n                    {/* Xtreme Dash Speed */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-[#FFA500]\">Aceleraci\303\263n Xtreme Dash</span>\n                        <span className=\"font-bold text-[#FFA500]\">{stats.dash} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-black/10 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-[#FFA500] transition-all duration-300\"\n                          style={{ width: `${stats.dash}%` }}\n                        ></div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"glass-panel p-6 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 text-center\">\n              <p className=\"text-xs font-label-caps text-gray-500 uppercase\">\n                Para activar el simulador visual de combos, registra al menos 1 Blade, 1 Ratchet y 1 Bit.\n              </p>\n            </div>\n          )}\n\n          {/* Parts Catalog Table */}\n          <div className=\"glass-panel p-6 rounded-2xl border border-[#bec7d3]/40 dark:border-white/10 shadow-sm space-y-4\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-[#bec7d3]/30 dark:border-white/10 pb-4\">\n              <div>\n                <h3 className=\"font-headline font-black text-xl uppercase text-[#1a1c1e] dark:text-white\">\n                  Cat\303\241logo de Piezas Registradas\n                </h3>\n                <p className=\"font-label-caps text-xs text-gray-500 uppercase\">\n                  {filteredParts.length} Componentes Registrados\n                </p>\n              </div>\n\n              {/* Filter Tabs */}\n              <div className=\"flex items-center gap-1.5 p-1 bg-black/5 dark:bg-white/5 rounded-xl font-label-caps text-xs uppercase font-bold\">\n                {([\'All\', \'Blade\', \'Ratchet\', \'Bit\'] as const).map((cat) => (\n                  <button\n                    key={cat}\n                    onClick={() => {\n                      soundManager.playClick();\n                      setSelectedCategory(cat);\n                    }}\n                    className={`px-3 py-1.5 rounded-lg transition-all ${\n                      selectedCategory === cat\n                        ? \'bg-[#04A8FC] text-white shadow-sm\'\n                        : \'text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white\'\n                    }`}\n                  >\n                    {cat === \'All\' ? \'Todas\' : cat}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Parts Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {filteredParts.map((part) => (\n                <div\n                  key={part.name}\n                  className=\"p-4 rounded-xl border border-black/5 dark:border-white/5 bg-white/60 dark:bg-white/5 hover:border-[#04A8FC] transition-all space-y-2 relative group\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span\n                      className={`text-[10px] font-label-caps font-black px-2 py-0.5 rounded uppercase ${\n                        part.type === \'Blade\'\n                          ? \'bg-red-500/10 text-red-600 dark:text-red-400\'\n                          : part.type === \'Ratchet\'\n                          ? \'bg-amber-500/10 text-amber-600 dark:text-amber-400\'\n                          : \'bg-blue-500/10 text-blue-600 dark:text-blue-400\'\n                      }`}\n                    >\n                      {part.type} {part.category ? `\342\200\242 ${part.category}` : \'\'}\n                    </span>\n                    <div className=\"flex items-center gap-2\">\n                      {part.weight && (\n                        <span className=\"font-mono text-xs font-bold text-gray-500\">\n                          {part.weight}\n                        </span>\n                      )}\n                      <button\n                        onClick={() => {\n                          soundManager.playClick();\n                          onDeletePart(part.name);\n                        }}\n                        className=\"opacity-0 group-hover:opacity-100 text-red-400 hover:text-red-600 p-0.5 rounded transition-opacity\"\n                        title=\"Eliminar pieza\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    </div>\n                  </div>\n\n                  <h4 className=\"font-headline font-bold text-base uppercase text-[#1a1c1e] dark:text-white\">\n                    {part.name}\n                  </h4>\n                  {part.description && (\n                    <p className=\"text-xs text-gray-600 dark:text-gray-400 font-body-text leading-relaxed\">\n                      {part.description}\n                    </p>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        </>\n      )}\n\n      {/* Modal to register new piece */}\n      {showAddModal && (\n        <div className=\"fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-[#bec7d3]/40 dark:border-white/10 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4\">\n            <div className=\"flex justify-between items-center border-b border-[#bec7d3]/30 dark:border-white/10 pb-3\">\n              <h3 className=\"font-headline font-bold text-lg uppercase text-[#1a1c1e] dark:text-white\">\n                Registrar Nueva Pieza\n              </h3>\n              <button\n                onClick={() => setShowAddModal(false)}\n                className=\"text-gray-400 hover:text-black dark:hover:text-white\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleCreatePart} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                  Nombre de la Pieza *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={newName}\n                  onChange={(e) => setNewName(e.target.value)}\n                  placeholder=\"Ej. Dransword, 3-60, F (Flat)\"\n                  className=\"w-full bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-2 text-sm text-[#1a1c1e] dark:text-white font-headline\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                    Tipo de Componente\n                  </label>\n                  <select\n                    value={newType}\n                    onChange={(e) => setNewType(e.target.value as \'Blade\' | \'Ratchet\' | \'Bit\')}\n                    className=\"w-full bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-2 text-xs font-headline text-[#1a1c1e] dark:text-white\"\n                  >\n                    <option value=\"Blade\" className=\"bg-white dark:bg-[#15151c]\">Blade (Capa Metal)</option>\n                    <option value=\"Ratchet\" className=\"bg-white dark:bg-[#15151c]\">Ratchet (Trinquete)</option>\n                    <option value=\"Bit\" className=\"bg-white dark:bg-[#15151c]\">Bit (Punta)</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                    Arquetipo / Categor\303\255a\n                  </label>\n                  <select\n                    value={newCategory}\n                    onChange={(e) => setNewCategory(e.target.value as \'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\')}\n                    className=\"w-full bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-2 text-xs font-headline text-[#1a1c1e] dark:text-white\"\n                  >\n                    <option value=\"Attack\" className=\"bg-white dark:bg-[#15151c]\">Ataque (Attack)</option>\n                    <option value=\"Defense\" className=\"bg-white dark:bg-[#15151c]\">Defensa (Defense)</option>\n                    <option value=\"Stamina\" className=\"bg-white dark:bg-[#15151c]\">Resistencia (Stamina)</option>\n                    <option value=\"Balance\" className=\"bg-white dark:bg-[#15151c]\">Equilibrio (Balance)</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                  Peso (g)\n                </label>\n                <input\n                  type=\"text\"\n                  value={newWeight}\n                  onChange={(e) => setNewWeight(e.target.value)}\n                  placeholder=\"Ej. 35.0g\"\n                  className=\"w-full bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-2 text-sm text-[#1a1c1e] dark:text-white font-headline\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-gray-500 mb-1\">\n                  Descripci\303\263n o Funci\303\263n\n                </label>\n                <textarea\n                  rows={2}\n                  value={newDescription}\n                  onChange={(e) => setNewDescription(e.target.value)}\n                  placeholder=\"Detalles sobre el dise\303\261o, agarre al riel Xtreme o comportamiento.\"\n                  className=\"w-full bg-black/5 dark:bg-white/5 border border-[#bec7d3]/40 dark:border-white/10 rounded-lg px-3 py-2 text-xs text-[#1a1c1e] dark:text-white font-body-text\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-2 border-t border-[#bec7d3]/30 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase text-gray-500 hover:text-black dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-bold uppercase shadow-sm\"\n                >\n                  Guardar Pieza\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>"
      replacement_content: "    <div className=\"max-w-7xl mx-auto space-y-8 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b border-slate-200 dark:border-white/10 pb-4\">\n        <div>\n          <h1 className=\"font-headline font-black text-3xl md:text-5xl text-slate-900 dark:text-white uppercase tracking-tight mb-2\">\n            EQUIPAMIENTO & COMBO BUILDER X\n          </h1>\n          <p className=\"font-body-text text-base text-slate-600 dark:text-slate-400\">\n            Base de datos oficial de piezas Takara Tomy / Hasbro Xtreme Series y simulador de rendimiento.\n          </p>\n        </div>\n\n        {/* Action Button */}\n        <button\n          onClick={() => {\n            soundManager.playClick();\n            setShowAddModal(true);\n          }}\n          className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2.5 rounded-xl font-headline font-black text-xs uppercase flex items-center gap-2 shadow-md shadow-[#04A8FC]/20 transition-all hover:scale-[1.02]\"\n        >\n          <span className=\"material-symbols-outlined text-base\">add_circle</span>\n          <span>Registrar Pieza</span>\n        </button>\n      </div>\n\n      {/* Empty Database State */}\n      {!hasAnyParts ? (\n        <div className=\"glass-panel p-12 rounded-3xl border border-dashed border-slate-300 dark:border-white/10 text-center space-y-4 bg-white dark:bg-[#15151c]\">\n          <div className=\"w-16 h-16 rounded-2xl bg-[#04A8FC]/10 border border-[#04A8FC]/30 flex items-center justify-center text-[#04A8FC] mx-auto\">\n            <span className=\"material-symbols-outlined text-3xl\">precision_manufacturing</span>\n          </div>\n          <h3 className=\"font-headline font-black text-xl uppercase text-slate-900 dark:text-white\">\n            Base de Datos de Piezas Vac\303\255a\n          </h3>\n          <p className=\"font-body-text text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto\">\n            No hay piezas registradas en el sistema. Puedes agregar Blades, Ratchets y Bits oficiales utilizando el bot\303\263n de registro para habilitar el simulador de combos.\n          </p>\n          <button\n            onClick={() => setShowAddModal(true)}\n            className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-6 py-2.5 rounded-xl font-headline font-black text-xs uppercase shadow-md shadow-[#04A8FC]/20\"\n          >\n            Registrar Primera Pieza\n          </button>\n        </div>\n      ) : (\n        <>\n          {/* Combo Builder Studio (Top Bento) */}\n          {canBuildCombo ? (\n            <div className=\"glass-panel p-6 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm relative overflow-hidden bg-white dark:bg-[#15151c]\">\n              <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n                {/* Visual Combo Display */}\n                <div className=\"lg:col-span-5 flex flex-col items-center text-center\">\n                  <div className=\"w-52 h-52 rounded-2xl bg-slate-50 dark:bg-[#161620] border-2 border-[#04A8FC] p-4 flex items-center justify-center shadow-lg shadow-[#04A8FC]/20 relative\">\n                    <BeybladeVisualizer\n                      bladeName={currentBlade?.name || \'Custom Blade\'}\n                      ratchetName={currentRatchet?.name || \'3-60\'}\n                      bitName={currentBit?.name || \'F\'}\n                      size=\"lg\"\n                    />\n                    <div className=\"absolute -bottom-3 bg-[#04A8FC] text-white text-[10px] font-label-caps uppercase px-3 py-1 rounded-full font-black tracking-widest shadow\">\n                      XTREME SYSTEM\n                    </div>\n                  </div>\n                  <h3 className=\"font-headline font-black text-2xl uppercase text-slate-900 dark:text-white mt-5\">\n                    {currentBlade?.name} {currentRatchet?.name} {currentBit?.name?.split(\' \')[0]}\n                  </h3>\n                  <p className=\"font-label-caps text-xs text-slate-500 dark:text-slate-400 uppercase font-bold\">\n                    Peso Estimado Total: <span className=\"text-[#0284c7] dark:text-[#04A8FC] font-black\">{stats.weightTotal}g</span>\n                  </p>\n                </div>\n\n                {/* Selectors & Performance Radar */}\n                <div className=\"lg:col-span-7 space-y-6\">\n                  {/* Parts Selectors */}\n                  <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                    <div>\n                      <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                        1. Blade (Capa de Metal)\n                      </label>\n                      <select\n                        value={currentBlade?.name || \'\'}\n                        onChange={(e) => {\n                          soundManager.playClick();\n                          setActiveBlade(e.target.value);\n                        }}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                      >\n                        {blades.map((b) => (\n                          <option key={b.name} value={b.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                            {b.name} {b.weight ? `(${b.weight})` : \'\'}\n                          </option>\n                        ))}\n                      </select>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                        2. Ratchet (Trinquete)\n                      </label>\n                      <select\n                        value={currentRatchet?.name || \'\'}\n                        onChange={(e) => {\n                          soundManager.playClick();\n                          setActiveRatchet(e.target.value);\n                        }}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                      >\n                        {ratchets.map((r) => (\n                          <option key={r.name} value={r.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                            {r.name} {r.weight ? `(${r.weight})` : \'\'}\n                          </option>\n                        ))}\n                      </select>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-[11px] font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                        3. Bit (Punta de Engranaje)\n                      </label>\n                      <select\n                        value={currentBit?.name || \'\'}\n                        onChange={(e) => {\n                          soundManager.playClick();\n                          setActiveBit(e.target.value);\n                        }}\n                        className=\"w-full bg-white dark:bg-[#1a1a24] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold uppercase text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#04A8FC] shadow-sm\"\n                      >\n                        {bits.map((bt) => (\n                          <option key={bt.name} value={bt.name} className=\"bg-white dark:bg-[#1a1a24]\">\n                            {bt.name}\n                          </option>\n                        ))}\n                      </select>\n                    </div>\n                  </div>\n\n                  {/* Performance Stats Bars */}\n                  <div className=\"space-y-3 pt-2\">\n                    <h4 className=\"font-headline font-bold text-xs uppercase text-slate-500 dark:text-slate-400 tracking-wider\">\n                      M\303\251tricas de Rendimiento en Estadio\n                    </h4>\n\n                    {/* Attack */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-[#DC2626] dark:text-[#f87171]\">Poder de Ataque</span>\n                        <span className=\"font-bold text-[#DC2626] dark:text-[#f87171]\">{stats.attack} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-[#DC2626] dark:bg-[#f87171] transition-all duration-300\"\n                          style={{ width: `${stats.attack}%` }}\n                        ></div>\n                      </div>\n                    </div>\n\n                    {/* Defense */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-emerald-600 dark:text-emerald-400\">Defensa & Retenci\303\263n</span>\n                        <span className=\"font-bold text-emerald-600 dark:text-emerald-400\">{stats.defense} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-emerald-500 transition-all duration-300\"\n                          style={{ width: `${stats.defense}%` }}\n                        ></div>\n                      </div>\n                    </div>\n\n                    {/* Stamina */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-[#0284c7] dark:text-[#04A8FC]\">Resistencia Centr\303\255fuga</span>\n                        <span className=\"font-bold text-[#0284c7] dark:text-[#04A8FC]\">{stats.stamina} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-[#04A8FC] transition-all duration-300\"\n                          style={{ width: `${stats.stamina}%` }}\n                        ></div>\n                      </div>\n                    </div>\n\n                    {/* Xtreme Dash Speed */}\n                    <div>\n                      <div className=\"flex justify-between text-xs font-label-caps uppercase mb-1\">\n                        <span className=\"font-bold text-amber-600 dark:text-[#FFA500]\">Aceleraci\303\263n Xtreme Dash</span>\n                        <span className=\"font-bold text-amber-600 dark:text-[#FFA500]\">{stats.dash} / 100</span>\n                      </div>\n                      <div className=\"h-2 w-full bg-slate-200 dark:bg-white/10 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-[#FFA500] transition-all duration-300\"\n                          style={{ width: `${stats.dash}%` }}\n                        ></div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"glass-panel p-6 rounded-2xl border border-slate-200 dark:border-white/10 text-center bg-white dark:bg-[#15151c]\">\n              <p className=\"text-xs font-label-caps text-slate-500 dark:text-slate-400 uppercase\">\n                Para activar el simulador visual de combos, registra al menos 1 Blade, 1 Ratchet y 1 Bit.\n              </p>\n            </div>\n          )}\n\n          {/* Parts Catalog Table */}\n          <div className=\"glass-panel p-6 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm space-y-4 bg-white dark:bg-[#15151c]\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-200 dark:border-white/10 pb-4\">\n              <div>\n                <h3 className=\"font-headline font-black text-xl uppercase text-slate-900 dark:text-white\">\n                  Cat\303\241logo de Piezas Registradas\n                </h3>\n                <p className=\"font-label-caps text-xs text-slate-500 dark:text-slate-400 uppercase font-bold\">\n                  {filteredParts.length} Componentes Registrados\n                </p>\n              </div>\n\n              {/* Filter Tabs */}\n              <div className=\"flex items-center gap-1.5 p-1 bg-slate-100 dark:bg-white/5 rounded-xl font-label-caps text-xs uppercase font-bold border border-slate-200 dark:border-transparent\">\n                {([\'All\', \'Blade\', \'Ratchet\', \'Bit\'] as const).map((cat) => (\n                  <button\n                    key={cat}\n                    onClick={() => {\n                      soundManager.playClick();\n                      setSelectedCategory(cat);\n                    }}\n                    className={`px-3 py-1.5 rounded-lg transition-all ${\n                      selectedCategory === cat\n                        ? \'bg-[#04A8FC] text-white shadow-sm font-black\'\n                        : \'text-slate-600 dark:text-gray-400 hover:text-slate-900 dark:hover:text-white\'\n                    }`}\n                  >\n                    {cat === \'All\' ? \'Todas\' : cat}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Parts Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {filteredParts.map((part) => (\n                <div\n                  key={part.name}\n                  className=\"p-4 rounded-2xl border border-slate-200 dark:border-white/5 bg-slate-50/70 dark:bg-white/5 hover:border-[#04A8FC] transition-all space-y-2 relative group shadow-sm\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span\n                      className={`text-[10px] font-label-caps font-black px-2 py-0.5 rounded-lg uppercase ${\n                        part.type === \'Blade\'\n                          ? \'bg-red-500/10 text-red-600 dark:text-red-400\'\n                          : part.type === \'Ratchet\'\n                          ? \'bg-amber-500/10 text-amber-600 dark:text-amber-400\'\n                          : \'bg-blue-500/10 text-blue-600 dark:text-blue-400\'\n                      }`}\n                    >\n                      {part.type} {part.category ? `\342\200\242 ${part.category}` : \'\'}\n                    </span>\n                    <div className=\"flex items-center gap-2\">\n                      {part.weight && (\n                        <span className=\"font-mono text-xs font-bold text-slate-500 dark:text-slate-400\">\n                          {part.weight}\n                        </span>\n                      )}\n                      <button\n                        onClick={() => {\n                          soundManager.playClick();\n                          onDeletePart(part.name);\n                        }}\n                        className=\"opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 p-0.5 rounded transition-opacity\"\n                        title=\"Eliminar pieza\"\n                      >\n                        <span className=\"material-symbols-outlined text-sm\">delete</span>\n                      </button>\n                    </div>\n                  </div>\n\n                  <h4 className=\"font-headline font-bold text-base uppercase text-slate-900 dark:text-white\">\n                    {part.name}\n                  </h4>\n                  {part.description && (\n                    <p className=\"text-xs text-slate-600 dark:text-gray-400 font-body-text leading-relaxed\">\n                      {part.description}\n                    </p>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        </>\n      )}\n\n      {/* Modal to register new piece */}\n      {showAddModal && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#15151c] border border-slate-200 dark:border-white/10 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 dark:border-white/10 pb-3\">\n              <h3 className=\"font-headline font-black text-lg uppercase text-slate-900 dark:text-white\">\n                Registrar Nueva Pieza\n              </h3>\n              <button\n                onClick={() => setShowAddModal(false)}\n                className=\"text-slate-400 hover:text-slate-900 dark:hover:text-white font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleCreatePart} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                  Nombre de la Pieza *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={newName}\n                  onChange={(e) => setNewName(e.target.value)}\n                  placeholder=\"Ej. Dransword, 3-60, F (Flat)\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Tipo de Componente\n                  </label>\n                  <select\n                    value={newType}\n                    onChange={(e) => setNewType(e.target.value as \'Blade\' | \'Ratchet\' | \'Bit\')}\n                    className=\"w-full bg-white dark:bg-[#15151c] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                  >\n                    <option value=\"Blade\">Blade (Capa Metal)</option>\n                    <option value=\"Ratchet\">Ratchet (Trinquete)</option>\n                    <option value=\"Bit\">Bit (Punta)</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                    Arquetipo / Categor\303\255a\n                  </label>\n                  <select\n                    value={newCategory}\n                    onChange={(e) => setNewCategory(e.target.value as \'Attack\' | \'Defense\' | \'Stamina\' | \'Balance\')}\n                    className=\"w-full bg-white dark:bg-[#15151c] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs font-headline font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                  >\n                    <option value=\"Attack\">Ataque (Attack)</option>\n                    <option value=\"Defense\">Defensa (Defense)</option>\n                    <option value=\"Stamina\">Resistencia (Stamina)</option>\n                    <option value=\"Balance\">Equilibrio (Balance)</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                  Peso (g)\n                </label>\n                <input\n                  type=\"text\"\n                  value={newWeight}\n                  onChange={(e) => setNewWeight(e.target.value)}\n                  placeholder=\"Ej. 35.0g\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-sm text-slate-900 dark:text-white font-headline focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-label-caps uppercase font-bold text-slate-600 dark:text-slate-400 mb-1\">\n                  Descripci\303\263n o Funci\303\263n\n                </label>\n                <textarea\n                  rows={2}\n                  value={newDescription}\n                  onChange={(e) => setNewDescription(e.target.value)}\n                  placeholder=\"Detalles sobre el dise\303\261o, agarre al riel Xtreme o comportamiento.\"\n                  className=\"w-full bg-white dark:bg-white/5 border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs text-slate-900 dark:text-white font-body-text focus:ring-2 focus:ring-[#04A8FC] focus:outline-none shadow-sm\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-2 border-t border-slate-200 dark:border-white/10\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddModal(false)}\n                  className=\"px-4 py-2 text-xs font-label-caps uppercase font-bold text-slate-600 hover:text-slate-900 dark:hover:text-white\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"bg-[#04A8FC] hover:bg-[#008fe0] text-white px-5 py-2 rounded-xl text-xs font-headline font-black uppercase shadow-sm\"\n                >\n                  Guardar Pieza\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>"
    }
