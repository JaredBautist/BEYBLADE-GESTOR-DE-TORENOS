      replacement_content: "// Official Takara Tomy & Hasbro Beyblade X Parts Catalog\nexport const INITIAL_BEYBLADE_PARTS: BeybladePart[] = [\n  // Blades\n  { name: \'Dransword\', type: \'Blade\', category: \'Attack\', weight: \'35.0g\', description: \'Hoja agresiva de tres alas orientada a impactos directos al X-Line.\' },\n  { name: \'Hellscythe\', type: \'Blade\', category: \'Balance\', weight: \'33.5g\', description: \'Cuchillas curvadas balanceadas con excelente capacidad de contraataque.\' },\n  { name: \'Wizardarrow\', type: \'Blade\', category: \'Stamina\', weight: \'31.8g\', description: \'Dise\303\261o circular de dos aspas con alta inercia centr\303\255fuga.\' },\n  { name: \'Knightshield\', type: \'Blade\', category: \'Defense\', weight: \'34.2g\', description: \'Seis crestas defensivas dise\303\261adas para absorber impactos y resistir desarmes.\' },\n  { name: \'Phoenixwing\', type: \'Blade\', category: \'Attack\', weight: \'38.2g\', description: \'Capa de metal pesado de alta masa para colisiones de m\303\241xima energ\303\255a.\' },\n  { name: \'Sharkedge\', type: \'Blade\', category: \'Attack\', weight: \'34.8g\', description: \'Doble aleta de corte bajo dise\303\261ada para uppercuts devastadores.\' },\n  { name: \'Cobalt Dragoon\', type: \'Blade\', category: \'Attack\', weight: \'37.5g\', description: \'Hoja de giro izquierdo con aspas invertidas para succi\303\263n y golpeo.\' },\n  { name: \'Unicornsting\', type: \'Blade\', category: \'Balance\', weight: \'33.9g\', description: \'Geometr\303\255a asim\303\251trica para desviar ataques y devolver golpes certeros.\' },\n  // Ratchets\n  { name: \'3-60\', type: \'Ratchet\', category: \'Attack\', weight: \'6.4g\', description: \'Trinquete de 3 salientes y perfil bajo de 6.0mm.\' },\n  { name: \'4-60\', type: \'Ratchet\', category: \'Defense\', weight: \'6.6g\', description: \'Trinquete cuadril\303\241tero estable de perfil bajo.\' },\n  { name: \'4-80\', type: \'Ratchet\', category: \'Stamina\', weight: \'7.1g\', description: \'Trinquete de 8.0mm de altura para contacto elevado.\' },\n  { name: \'5-60\', type: \'Ratchet\', category: \'Balance\', weight: \'6.8g\', description: \'Distribuci\303\263n pentagonal que minimiza el desbalance y la fricci\303\263n.\' },\n  { name: \'9-60\', type: \'Ratchet\', category: \'Stamina\', weight: \'6.9g\', description: \'Nueve crestas suaves con m\303\241xima resistencia al estallido (Burst).\' },\n  // Bits\n  { name: \'F (Flat)\', type: \'Bit\', category: \'Attack\', weight: \'2.2g\', description: \'Punta plana con engranajes para aceleraci\303\263n extrema en riel X.\' },\n  { name: \'T (Taper)\', type: \'Bit\', category: \'Balance\', weight: \'2.3g\', description: \'Punta c\303\263nica semi-plana que combina movimiento din\303\241mico y estabilidad central.\' },\n  { name: \'B (Ball)\', type: \'Bit\', category: \'Stamina\', weight: \'2.4g\', description: \'Punta esf\303\251rica de baja fricci\303\263n para prolongar el tiempo de giro.\' },\n  { name: \'N (Needle)\', type: \'Bit\', category: \'Defense\', weight: \'2.1g\', description: \'Punta c\303\263nica puntiaguda que mantiene la posici\303\263n fija en el centro del estadio.\' },\n  { name: \'HN (High Needle)\', type: \'Bit\', category: \'Defense\', weight: \'2.5g\', description: \'Variante alta de Needle para elevar el centro de masa y esquivar impactos bajos.\' },\n  { name: \'GF (Gear Flat)\', type: \'Bit\', category: \'Attack\', weight: \'2.4g\', description: \'Dientes de engranaje extendidos para la velocidad de Dash m\303\241s r\303\241pida de la serie.\' }\n];"
