          text: "                <div className=\"flex items-center justify-between\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <span className=\"font-headline font-bold text-xs uppercase text-[#04A8FC] flex items-center gap-1.5\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <span className=\"material-symbols-outlined text-sm\">terminal</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <span>Script SQL para Supabase (Tabla `community_config` + Tablas)</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
