    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ActiveScreen } from \'../types\';\nimport { COMMUNITY_ASSETS } from \'../data/initialData\';\nimport { soundManager } from \'../utils/audio\';\n\ninterface SidebarProps {\n  activeScreen: ActiveScreen;\n  setActiveScreen: (screen: ActiveScreen) => void;\n  onOpenNewBattle: () => void;\n  onOpenSupportModal: () => void;\n  onResetTournament: () => void;\n  leagueName?: string;\n  season?: string;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeScreen,\n  setActiveScreen,\n  onOpenNewBattle,\n  onOpenSupportModal,\n  onResetTournament,\n  leagueName = \'C\303\272cuta League\',\n  season = \'Xtreme Series Season 1\'\n}) => {\n  const navItems: { id: ActiveScreen; label: string; icon: string; badge?: string }[] = [\n    { id: \'dashboard\', label: \'Battle Console\', icon: \'sports_kabaddi\' },\n    { id: \'bracket\', label: \'Bracket / \303\201rbol\', icon: \'account_tree\' },\n    { id: \'bladers\', label: \'Bladers & Roster\', icon: \'groups\' },\n    { id: \'matches\', label: \'Partidas / Fixture\', icon: \'grid_view\' },\n    { id: \'configuration\', label: \'Configuraci\303\263n\', icon: \'tune\' },\n    { id: \'equipment\', label: \'Equipamiento X\', icon: \'settings_input_component\' },\n    { id: \'rules\', label: \'Reglas Oficiales\', icon: \'menu_book\' },\n    { id: \'history\', label: \'Historial\', icon: \'history\' }\n  ];\n\n  return (\n    <aside className=\"fixed left-0 top-0 h-full w-64 bg-white/95 dark:bg-[#111116]/95 border-r border-[#bec7d3]/40 dark:border-white/10 backdrop-blur-md shadow-[4px_0_24px_rgba(0,0,0,0.03)] dark:shadow-[4px_0_24px_rgba(0,0,0,0.4)] z-50 flex flex-col pt-6 pb-6 transition-all duration-200\">\n      {/* Brand Header */}\n      <div className=\"px-5 mb-6 flex flex-col items-center text-center\">\n        <div className=\"relative group cursor-pointer mb-3\" onClick={() => setActiveScreen(\'dashboard\')}>\n          <div className=\"w-20 h-20 rounded-2xl bg-gradient-to-tr from-[#006398] via-[#04A8FC] to-[#AC191F] p-0.5 shadow-md shadow-[#04A8FC]/20\">\n            <div className=\"w-full h-full bg-white dark:bg-[#0e0e13] rounded-[14px] flex items-center justify-center overflow-hidden p-1\">\n              <img\n                src={COMMUNITY_ASSETS.logoCucuta}\n                alt=\"Comunidad Beyblade C\303\272cuta\"\n                className=\"w-full h-full object-contain transform group-hover:scale-105 transition-transform\"\n                onError={(e) => {\n                  (e.target as HTMLImageElement).src = COMMUNITY_ASSETS.bannerGP;\n                }}\n              />\n            </div>\n          </div>\n          <div className=\"absolute -bottom-1.5 -right-1.5 bg-[#04A8FC] text-white text-[9px] font-headline font-black px-1.5 py-0.5 rounded shadow\">\n            X\n          </div>\n        </div>\n\n        <h2 className=\"text-[#1a1c1e] dark:text-white font-headline font-black text-lg uppercase tracking-tight\">\n          {leagueName}\n        </h2>\n        <p className=\"text-gray-500 dark:text-gray-400 font-label-caps text-[11px] uppercase tracking-wider font-semibold\">\n          {season}\n        </p>\n      </div>\n\n      {/* Navigation List */}\n      <div className=\"flex-1 px-3 space-y-1 overflow-y-auto\">\n        {navItems.map((item) => {\n          const isActive = activeScreen === item.id;\n          return (\n            <button\n              key={item.id}\n              id={`sidebar-nav-${item.id}`}\n              onClick={() => {\n                soundManager.playClick();\n                setActiveScreen(item.id);\n              }}\n              className={`w-full flex items-center gap-3.5 px-4 py-2.5 rounded-xl font-label-caps text-xs uppercase tracking-wider transition-all duration-150 text-left ${\n                isActive\n                  ? \'bg-[#04A8FC] text-white font-bold shadow-md shadow-[#04A8FC]/25 translate-x-1\'\n                  : \'text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/5 hover:translate-x-1\'\n              }`}\n            >\n              <span\n                className=\"material-symbols-outlined text-lg\"\n                style={{ fontVariationSettings: isActive ? \"\'FILL\' 1\" : \"\'FILL\' 0\" }}\n              >\n                {item.icon}\n              </span>\n              <span className=\"flex-1 truncate\">{item.label}</span>\n              {item.badge && (\n                <span className=\"bg-[#AC191F] text-white text-[9px] px-1.5 py-0.5 rounded-full font-bold\">\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* New Battle Quick Action */}\n      <div className=\"px-4 my-4\">\n        <button\n          id=\"btn-new-battle-sidebar\"\n          onClick={() => {\n            soundManager.playClick();\n            onOpenNewBattle();\n          }}\n          className=\"w-full bg-gradient-to-r from-[#04A8FC] to-[#006398] hover:from-[#33b8fc] hover:to-[#04A8FC] text-white font-headline font-bold text-xs uppercase tracking-wider py-3 px-4 rounded-xl shadow-md shadow-[#04A8FC]/30 flex items-center justify-center gap-2 transition-all hover:scale-[1.02] active:scale-[0.98]\"\n        >\n          <span className=\"material-symbols-outlined text-base\">add_circle</span>\n          <span>Nueva Batalla</span>\n        </button>\n      </div>\n\n      {/* Bottom links */}\n      <div className=\"px-3 pt-3 border-t border-[#bec7d3]/30 dark:border-white/10 space-y-1\">\n        <button\n          id=\"btn-support-sidebar\"\n          onClick={() => {\n            soundManager.playClick();\n            onOpenSupportModal();\n          }}\n          className=\"w-full flex items-center gap-3 px-4 py-2 text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/5 rounded-lg font-label-caps text-xs uppercase tracking-wider transition-all\"\n        >\n          <span className=\"material-symbols-outlined text-base\">help</span>\n          <span>Soporte & Gu\303\255a</span>\n        </button>\n\n        <button\n          id=\"btn-reset-sidebar\"\n          onClick={() => {\n            soundManager.playClick();\n            onResetTournament();\n          }}\n          className=\"w-full flex items-center gap-3 px-4 py-2 text-[#AC191F] hover:bg-[#AC191F]/10 rounded-lg font-label-caps text-xs uppercase tracking-wider transition-all font-semibold\"\n        >\n          <span className=\"material-symbols-outlined text-base\">restart_alt</span>\n          <span>Reiniciar Torneo</span>\n        </button>\n      </div>\n    </aside>\n  );\n};\n"
    }
