    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ActiveScreen, Blader, Match, TournamentConfig } from \'./types\';\nimport {\n  INITIAL_BLADERS,\n  INITIAL_CONFIG,\n  INITIAL_MATCHES\n} from \'./data/initialData\';\nimport { Header } from \'./components/Header\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { DashboardScreen } from \'./components/screens/DashboardScreen\';\nimport { ConfigScreen } from \'./components/screens/ConfigScreen\';\nimport { BladersScreen } from \'./components/screens/BladersScreen\';\nimport { BracketScreen } from \'./components/screens/BracketScreen\';\nimport { MatchesScreen } from \'./components/screens/MatchesScreen\';\nimport { EquipmentScreen } from \'./components/screens/EquipmentScreen\';\nimport { RulesScreen } from \'./components/screens/RulesScreen\';\nimport { HistoryScreen } from \'./components/screens/HistoryScreen\';\nimport { WinnerModal } from \'./components/WinnerModal\';\nimport { NewBattleModal } from \'./components/NewBattleModal\';\nimport { SupportModal } from \'./components/SupportModal\';\n\nexport default function App() {\n  const [activeScreen, setActiveScreen] = useState<ActiveScreen>(\'dashboard\');\n  const [isDark, setIsDark] = useState<boolean>(true);\n  const [isMuted, setIsMuted] = useState<boolean>(false);\n\n  // Core Tournament State\n  const [config, setConfig] = useState<TournamentConfig>(INITIAL_CONFIG);\n  const [bladers, setBladers] = useState<Blader[]>(INITIAL_BLADERS);\n  const [matches, setMatches] = useState<Match[]>(INITIAL_MATCHES);\n  const [currentMatch, setCurrentMatch] = useState<Match | null>(INITIAL_MATCHES[0] || null);\n\n  // Modals\n  const [winnerModalData, setWinnerModalData] = useState<{\n    isOpen: boolean;\n    winner: Blader | null;\n    match: Match | null;\n  }>({\n    isOpen: false,\n    winner: null,\n    match: null\n  });\n  const [newBattleModalOpen, setNewBattleModalOpen] = useState<boolean>(false);\n  const [supportModalOpen, setSupportModalOpen] = useState<boolean>(false);\n\n  // Sync dark mode class with root html element\n  useEffect(() => {\n    if (isDark) {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  }, [isDark]);\n\n  // Handle live score updating in the Battle Console\n  const handleUpdateScore = (\n    corner: \'A\' | \'B\',\n    pointType: \'xtreme\' | \'burst\' | \'over\' | \'spin\' | \'stadium\',\n    points: number\n  ) => {\n    if (!currentMatch) return;\n\n    const updatedScoreA = corner === \'A\' ? currentMatch.scoreA + points : currentMatch.scoreA;\n    const updatedScoreB = corner === \'B\' ? currentMatch.scoreB + points : currentMatch.scoreB;\n\n    const scoringBlader = corner === \'A\' ? currentMatch.bladerA : currentMatch.bladerB;\n    const targetScore = currentMatch.targetScore;\n\n    const pointDescriptions: Record<string, string> = {\n      xtreme: `Xtreme Finish (+${points} PTS)`,\n      burst: `Burst Finish (+${points} PTS)`,\n      over: `Over Finish (+${points} PTS)`,\n      spin: `Spin Finish (+${points} PTS)`,\n      stadium: `Stadium Out (+${points} PTS)`\n    };\n\n    const newEvent = {\n      id: `ev-${Date.now()}`,\n      timestamp: new Date().toLocaleTimeString(\'es-CO\', {\n        hour: \'2-digit\',\n        minute: \'2-digit\',\n        second: \'2-digit\'\n      }),\n      bladerCorner: corner,\n      bladerName: scoringBlader?.name || `Blader ${corner}`,\n      pointType,\n      points,\n      scoreAAfter: updatedScoreA,\n      scoreBAfter: updatedScoreB,\n      description: pointDescriptions[pointType] || `Anotaci\303\263n (+${points} PTS)`\n    };\n\n    const isMatchWon =\n      updatedScoreA >= targetScore || updatedScoreB >= targetScore;\n    const winningBlader = isMatchWon\n      ? updatedScoreA >= targetScore\n        ? currentMatch.bladerA\n        : currentMatch.bladerB\n      : null;\n\n    const updatedMatch: Match = {\n      ...currentMatch,\n      scoreA: updatedScoreA,\n      scoreB: updatedScoreB,\n      status: isMatchWon ? \'finished\' : \'live\',\n      winnerId: winningBlader?.id || null,\n      winnerName: winningBlader?.name,\n      events: [...(currentMatch.events || []), newEvent]\n    };\n\n    setCurrentMatch(updatedMatch);\n\n    // Update matches list\n    setMatches((prev) =>\n      prev.map((m) => (m.id === currentMatch.id ? updatedMatch : m))\n    );\n\n    // Update Blader stats if won\n    if (isMatchWon && winningBlader) {\n      setBladers((prev) =>\n        prev.map((b) => {\n          if (b.id === winningBlader.id) {\n            return {\n              ...b,\n              stats: {\n                ...b.stats,\n                wins: b.stats.wins + 1,\n                matchesPlayed: b.stats.matchesPlayed + 1,\n                pointsScored:\n                  b.stats.pointsScored +\n                  (corner === \'A\' ? updatedScoreA : updatedScoreB),\n                xtremeFinishes:\n                  pointType === \'xtreme\'\n                    ? b.stats.xtremeFinishes + 1\n                    : b.stats.xtremeFinishes,\n                burstFinishes:\n                  pointType === \'burst\'\n                    ? b.stats.burstFinishes + 1\n                    : b.stats.burstFinishes\n              }\n            };\n          }\n          return b;\n        })\n      );\n\n      // Open celebration modal\n      setWinnerModalData({\n        isOpen: true,\n        winner: winningBlader,\n        match: updatedMatch\n      });\n    }\n  };\n\n  const handleResetMatch = () => {\n    if (!currentMatch) return;\n    const reset: Match = {\n      ...currentMatch,\n      scoreA: 0,\n      scoreB: 0,\n      status: \'live\',\n      winnerId: null,\n      winnerName: undefined,\n      events: []\n    };\n    setCurrentMatch(reset);\n    setMatches((prev) =>\n      prev.map((m) => (m.id === currentMatch.id ? reset : m))\n    );\n  };\n\n  const handleSwapCorners = () => {\n    if (!currentMatch) return;\n    const swapped: Match = {\n      ...currentMatch,\n      bladerA: currentMatch.bladerB,\n      bladerB: currentMatch.bladerA,\n      scoreA: currentMatch.scoreB,\n      scoreB: currentMatch.scoreA\n    };\n    setCurrentMatch(swapped);\n  };\n\n  const handleSelectOnDeckMatch = (bladerAId: string, bladerBId: string) => {\n    const bA = bladers.find((b) => b.id === bladerAId) || null;\n    const bB = bladers.find((b) => b.id === bladerBId) || null;\n    const newMatch: Match = {\n      id: `match-custom-${Date.now()}`,\n      roundNumber: 1,\n      roundName: \'Duelo On-Deck\',\n      matchNumber: matches.length + 1,\n      bladerA: bA,\n      bladerB: bB,\n      scoreA: 0,\n      scoreB: 0,\n      targetScore: config.victoryConditions.pointsToWin,\n      status: \'live\',\n      winnerId: null,\n      cornerA: \'Red\',\n      cornerB: \'Blue\',\n      events: []\n    };\n    setCurrentMatch(newMatch);\n    setMatches((prev) => [newMatch, ...prev]);\n    setActiveScreen(\'dashboard\');\n  };\n\n  const handleRandomizeOnDeck = () => {\n    const shuffled = [...bladers].sort(() => 0.5 - Math.random());\n    if (shuffled.length >= 2) {\n      handleSelectOnDeckMatch(shuffled[0].id, shuffled[1].id);\n    }\n  };\n\n  const handleStartCustomBattle = (\n    bladerAId: string,\n    bladerBId: string,\n    targetScore: number\n  ) => {\n    const bA = bladers.find((b) => b.id === bladerAId) || null;\n    const bB = bladers.find((b) => b.id === bladerBId) || null;\n    const newMatch: Match = {\n      id: `match-custom-${Date.now()}`,\n      roundNumber: 1,\n      roundName: \'Batalla R\303\241pida\',\n      matchNumber: matches.length + 1,\n      bladerA: bA,\n      bladerB: bB,\n      scoreA: 0,\n      scoreB: 0,\n      targetScore: targetScore,\n      status: \'live\',\n      winnerId: null,\n      cornerA: \'Red\',\n      cornerB: \'Blue\',\n      events: []\n    };\n    setCurrentMatch(newMatch);\n    setMatches((prev) => [newMatch, ...prev]);\n    setActiveScreen(\'dashboard\');\n  };\n\n  const handleQuickStartByName = (\n    nameA: string,\n    nameB: string,\n    targetScore: number\n  ) => {\n    let bA = bladers.find((b) => b.name.toLowerCase() === nameA.toLowerCase());\n    let bB = bladers.find((b) => b.name.toLowerCase() === nameB.toLowerCase());\n\n    const newBladersToAdd: Blader[] = [];\n\n    if (!bA) {\n      bA = {\n        id: `blader-${Date.now()}-a`,\n        name: nameA,\n        team: \'Independiente\',\n        verified: true,\n        stats: {\n          wins: 0,\n          losses: 0,\n          pointsScored: 0,\n          burstFinishes: 0,\n          xtremeFinishes: 0,\n          overFinishes: 0,\n          matchesPlayed: 0\n        },\n        combos: []\n      };\n      newBladersToAdd.push(bA);\n    }\n\n    if (!bB) {\n      bB = {\n        id: `blader-${Date.now()}-b`,\n        name: nameB,\n        team: \'Independiente\',\n        verified: true,\n        stats: {\n          wins: 0,\n          losses: 0,\n          pointsScored: 0,\n          burstFinishes: 0,\n          xtremeFinishes: 0,\n          overFinishes: 0,\n          matchesPlayed: 0\n        },\n        combos: []\n      };\n      newBladersToAdd.push(bB);\n    }\n\n    if (newBladersToAdd.length > 0) {\n      setBladers((prev) => [...prev, ...newBladersToAdd]);\n    }\n\n    const newMatch: Match = {\n      id: `match-quick-${Date.now()}`,\n      roundNumber: 1,\n      roundName: \'Combate en Vivo\',\n      matchNumber: matches.length + 1,\n      bladerA: bA,\n      bladerB: bB,\n      scoreA: 0,\n      scoreB: 0,\n      targetScore: targetScore,\n      status: \'live\',\n      winnerId: null,\n      cornerA: \'Red\',\n      cornerB: \'Blue\',\n      events: []\n    };\n\n    setCurrentMatch(newMatch);\n    setMatches((prev) => [newMatch, ...prev]);\n    setActiveScreen(\'dashboard\');\n  };\n\n  const handleGenerateBracket = () => {\n    if (bladers.length < 2) {\n      alert(\'Registra al menos 2 bladers para generar el \303\241rbol de eliminaci\303\263n.\');\n      setActiveScreen(\'bladers\');\n      return;\n    }\n\n    const shuffled = [...bladers].sort(() => 0.5 - Math.random());\n    const generatedMatches: Match[] = [];\n\n    for (let i = 0; i < shuffled.length; i += 2) {\n      if (i + 1 < shuffled.length) {\n        generatedMatches.push({\n          id: `match-bracket-${i / 2 + 1}`,\n          roundNumber: 1,\n          roundName: `Ronda 1 - Duelo ${i / 2 + 1}`,\n          matchNumber: i / 2 + 1,\n          bladerA: shuffled[i],\n          bladerB: shuffled[i + 1],\n          scoreA: 0,\n          scoreB: 0,\n          targetScore: config.victoryConditions.pointsToWin,\n          status: i === 0 ? \'live\' : \'upcoming\',\n          winnerId: null,\n          cornerA: \'Red\',\n          cornerB: \'Blue\',\n          events: []\n        });\n      }\n    }\n\n    setMatches(generatedMatches);\n    if (generatedMatches.length > 0) {\n      setCurrentMatch(generatedMatches[0]);\n    }\n  };\n\n  const handleSelectMatchForConsole = (match: Match) => {\n    setCurrentMatch(match);\n    setActiveScreen(\'dashboard\');\n  };\n\n  const handleSetMatchWinner = (matchId: string, winnerId: string) => {\n    const winnerBlader = bladers.find((b) => b.id === winnerId);\n    setMatches((prev) =>\n      prev.map((m) => {\n        if (m.id === matchId) {\n          return {\n            ...m,\n            status: \'finished\',\n            winnerId,\n            winnerName: winnerBlader?.name\n          };\n        }\n        return m;\n      })\n    );\n  };\n\n  const handleAddBlader = (newBlader: Blader) => {\n    setBladers((prev) => [newBlader, ...prev]);\n  };\n\n  const handleToggleVerified = (id: string) => {\n    setBladers((prev) =>\n      prev.map((b) => (b.id === id ? { ...b, verified: !b.verified } : b))\n    );\n  };\n\n  const handleDeleteBlader = (id: string) => {\n    setBladers((prev) => prev.filter((b) => b.id !== id));\n  };\n\n  const handleResetTournament = () => {\n    if (\n      confirm(\n        \'\302\277Reiniciar todo el torneo y restablecer los marcadores a cero?\'\n      )\n    ) {\n      setBladers([]);\n      setMatches([]);\n      setCurrentMatch(null);\n      setActiveScreen(\'dashboard\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f7f9fc] dark:bg-[#0c0c10] text-[#1a1c1e] dark:text-white flex flex-col font-sans transition-colors duration-200\">\n      {/* Tactical Grid Background Overlay */}\n      <div className=\"fixed inset-0 pointer-events-none bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:24px_24px] z-0\"></div>\n\n      {/* Sidebar for Desktop */}\n      <div className=\"hidden md:block\">\n        <Sidebar\n          activeScreen={activeScreen}\n          setActiveScreen={setActiveScreen}\n          onOpenNewBattle={() => setNewBattleModalOpen(true)}\n          onOpenSupportModal={() => setSupportModalOpen(true)}\n          onResetTournament={handleResetTournament}\n          leagueName={config.leagueName}\n          season={config.season}\n        />\n      </div>\n\n      {/* Top Header */}\n      <Header\n        activeScreen={activeScreen}\n        setActiveScreen={setActiveScreen}\n        isDark={isDark}\n        setIsDark={setIsDark}\n        isMuted={isMuted}\n        setIsMuted={setIsMuted}\n        onOpenNewBladerModal={() => setActiveScreen(\'bladers\')}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 md:ml-64 pt-20 px-4 md:px-8 relative z-10\">\n        {activeScreen === \'dashboard\' && (\n          <DashboardScreen\n            currentMatch={currentMatch}\n            config={config}\n            allBladers={bladers}\n            onUpdateScore={handleUpdateScore}\n            onResetMatch={handleResetMatch}\n            onSelectOnDeckMatch={handleSelectOnDeckMatch}\n            onRandomizeOnDeck={handleRandomizeOnDeck}\n            onSwapCorners={handleSwapCorners}\n            onQuickStartBattle={handleQuickStartByName}\n          />\n        )}\n\n        {activeScreen === \'configuration\' && (\n          <ConfigScreen\n            config={config}\n            registeredBladersCount={bladers.length}\n            onSaveConfig={(updated) => setConfig(updated)}\n            onStartTournament={() => {\n              setActiveScreen(\'bracket\');\n            }}\n          />\n        )}\n\n        {activeScreen === \'bladers\' && (\n          <BladersScreen\n            bladers={bladers}\n            onAddBlader={handleAddBlader}\n            onToggleVerified={handleToggleVerified}\n            onDeleteBlader={handleDeleteBlader}\n          />\n        )}\n\n        {activeScreen === \'bracket\' && (\n          <BracketScreen\n            bladers={bladers}\n            matches={matches}\n            onSelectMatchForConsole={handleSelectMatchForConsole}\n            onSetMatchWinner={handleSetMatchWinner}\n            onGenerateBracket={handleGenerateBracket}\n          />\n        )}\n\n        {activeScreen === \'matches\' && (\n          <MatchesScreen\n            matches={matches}\n            allBladers={bladers}\n            onSelectMatchForConsole={handleSelectMatchForConsole}\n            onQuickAddMatchByName={(nA, nB, rnd) => {\n              handleQuickStartByName(nA, nB, config.victoryConditions.pointsToWin);\n            }}\n            onAddNewMatch={(bA, bB, round) => {\n              const bladerA = bladers.find((b) => b.id === bA) || null;\n              const bladerB = bladers.find((b) => b.id === bB) || null;\n              const newM: Match = {\n                id: `match-${Date.now()}`,\n                roundNumber: 2,\n                roundName: round,\n                matchNumber: matches.length + 1,\n                bladerA,\n                bladerB,\n                scoreA: 0,\n                scoreB: 0,\n                targetScore: config.victoryConditions.pointsToWin,\n                status: \'upcoming\',\n                winnerId: null,\n                cornerA: \'Red\',\n                cornerB: \'Blue\',\n                events: []\n              };\n              setMatches((prev) => [newM, ...prev]);\n            }}\n          />\n        )}\n\n        {activeScreen === \'equipment\' && <EquipmentScreen />}\n\n        {activeScreen === \'rules\' && <RulesScreen />}\n\n        {activeScreen === \'history\' && <HistoryScreen bladers={bladers} />}\n      </main>\n\n      {/* Mobile Bottom Navigation Bar */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 h-16 bg-white/95 dark:bg-[#111116]/95 border-t border-[#bec7d3]/40 dark:border-white/10 backdrop-blur-lg flex items-center justify-around px-2 z-40\">\n        {[\n          { id: \'dashboard\', label: \'Console\', icon: \'sports_kabaddi\' },\n          { id: \'bracket\', label: \'Bracket\', icon: \'account_tree\' },\n          { id: \'bladers\', label: \'Bladers\', icon: \'groups\' },\n          { id: \'matches\', label: \'Matches\', icon: \'grid_view\' },\n          { id: \'configuration\', label: \'Config\', icon: \'tune\' }\n        ].map((item) => {\n          const isActive = activeScreen === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => setActiveScreen(item.id as ActiveScreen)}\n              className={`flex flex-col items-center justify-center p-1 font-label-caps text-[10px] uppercase font-bold transition-all ${\n                isActive ? \'text-[#04A8FC]\' : \'text-gray-500\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-lg\">\n                {item.icon}\n              </span>\n              <span>{item.label}</span>\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Winner Celebration Modal */}\n      {winnerModalData.isOpen &&\n        winnerModalData.winner &&\n        winnerModalData.match && (\n          <WinnerModal\n            winner={winnerModalData.winner}\n            match={winnerModalData.match}\n            onClose={() =>\n              setWinnerModalData({ isOpen: false, winner: null, match: null })\n            }\n            onGoToBracket={() => {\n              setWinnerModalData({ isOpen: false, winner: null, match: null });\n              setActiveScreen(\'bracket\');\n            }}\n            onNextMatch={() => {\n              setWinnerModalData({ isOpen: false, winner: null, match: null });\n              handleRandomizeOnDeck();\n            }}\n          />\n        )}\n\n      {/* New Battle Quick Modal */}\n      {newBattleModalOpen && (\n        <NewBattleModal\n          bladers={bladers}\n          onClose={() => setNewBattleModalOpen(false)}\n          onStartCustomBattle={handleStartCustomBattle}\n          onQuickStartByName={handleQuickStartByName}\n        />\n      )}\n\n      {/* Support & Community Modal */}\n      {supportModalOpen && (\n        <SupportModal onClose={() => setSupportModalOpen(false)} />\n      )}\n    </div>\n  );\n}\n"
    }
    diff {
