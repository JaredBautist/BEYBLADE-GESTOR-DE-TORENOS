    command_line: "python3 -c \"\nimport urllib.request\nimport json\n\nurls = {\n    \'jackson.png\': \'https://static.wikia.nocookie.net/beyblade/images/9/9f/Ekusu_Kurosu.png/revision/latest?cb=20231006155609\',\n    \'valt.png\': \'https://static.wikia.nocookie.net/beyblade/images/d/df/Valt_Burst_Season_1.png/revision/latest?cb=20210214152737\',\n    \'gingka.png\': \'https://static.wikia.nocookie.net/beyblade/images/0/02/Gingka_Metal_Fusion.png/revision/latest?cb=20200829141042\',\n    \'tyson.png\': \'https://static.wikia.nocookie.net/beyblade/images/a/a2/Takao_Kinomiya_G-Revolution.png/revision/latest?cb=20210103131748\'\n}\n\nfor name, url in urls.items():\n    try:\n        req = urllib.request.Request(url, headers={\'User-Agent\': \'Mozilla/5.0\'})\n        with urllib.request.urlopen(req, timeout=10) as resp:\n            data = resp.read()\n            with open(f\'public/avatars/{name}\', \'wb\') as f:\n                f.write(data)\n            print(f\'Downloaded {name}: {len(data)} bytes\')\n    except Exception as e:\n        print(f\'Error downloading {name}: {e}\')\n\""
