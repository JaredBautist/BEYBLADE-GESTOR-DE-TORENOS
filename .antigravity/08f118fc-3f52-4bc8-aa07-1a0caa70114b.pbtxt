        }
        lines {
          text: "    const existingCount = blader.combos?.length || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const initialSlots = (Math.max(1, Math.min(3, existingCount))) as 1 | 2 | 3;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    setEditSlotsCount(initialSlots);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
