      target_content: "      {/* Main Content Area */}\n      <main className=\"flex-1 md:ml-64 pt-20 px-4 md:px-8 relative z-10\">\n        {activeScreen === \'dashboard\' && (\n          <DashboardScreen\n            currentMatch={currentMatch}\n            config={config}\n            allBladers={bladers}\n            onUpdateScore={handleUpdateScore}\n            onResetMatch={handleResetMatch}\n            onSelectOnDeckMatch={handleSelectOnDeckMatch}\n            onRandomizeOnDeck={handleRandomizeOnDeck}\n            onSwapCorners={handleSwapCorners}\n            onQuickStartMatch={handleQuickStartByName}\n            onOpenNewBattle={() => setNewBattleModalOpen(true)}\n            onNavigateToBladers={() => setActiveScreen(\'bladers\')}\n          />\n        )}\n\n        {activeScreen === \'configuration\' && (\n          <ConfigScreen\n            config={config}\n            registeredBladersCount={bladers.length}\n            onSaveConfig={(updated) => setConfig(updated)}\n            onStartTournament={() => {\n              setActiveScreen(\'bracket\');\n            }}\n          />\n        )}\n\n        {activeScreen === \'bladers\' && (\n          <BladersScreen\n            bladers={bladers}\n            onAddBlader={handleAddBlader}\n            onUpdateBlader={handleUpdateBlader}\n            onToggleVerified={handleToggleVerified}\n            onDeleteBlader={handleDeleteBlader}\n            onToggleBadge={handleToggleBadge}\n          />\n        )}\n\n        {activeScreen === \'bracket\' && (\n          <BracketScreen\n            bladers={bladers}\n            matches={matches}\n            onSelectMatchForConsole={handleSelectMatchForConsole}\n            onSetMatchWinner={handleSetMatchWinner}\n            onGenerateBracket={handleGenerateBracket}\n          />\n        )}\n\n        {activeScreen === \'matches\' && (\n          <MatchesScreen\n            matches={matches}\n            allBladers={bladers}\n            onSelectMatchForConsole={handleSelectMatchForConsole}\n            onQuickAddMatchByName={(nA, nB) => {\n              handleQuickStartByName(nA, nB, config.victoryConditions.pointsToWin);\n            }}\n            onAddNewMatch={(bA, bB, round) => {\n              const bladerA = bladers.find((b) => b.id === bA) || null;\n              const bladerB = bladers.find((b) => b.id === bB) || null;\n              const newM: Match = {\n                id: `match-${Date.now()}`,\n                roundNumber: 2,\n                roundName: round,\n                matchNumber: matches.length + 1,\n                bladerA,\n                bladerB,\n                scoreA: 0,\n                scoreB: 0,\n                targetScore: config.victoryConditions.pointsToWin,\n                status: \'upcoming\',\n                winnerId: null,\n                cornerA: \'Red\',\n                cornerB: \'Blue\',\n                events: []\n              };\n              setMatches((prev) => [newM, ...prev]);\n            }}\n          />\n        )}\n\n        {activeScreen === \'equipment\' && (\n          <EquipmentScreen\n            parts={parts}\n            bladers={bladers}\n            registeredCombos={registeredCombos}\n            onAddPart={handleAddPart}\n            onDeletePart={handleDeletePart}\n            onAddCombo={handleAddCombo}\n            onDeleteCombo={handleDeleteCombo}\n            onUpdateBlader={handleUpdateBlader}\n          />\n        )}\n\n        {activeScreen === \'rules\' && <RulesScreen />}\n\n        {activeScreen === \'history\' && (\n          <HistoryScreen\n            bladers={bladers}\n            history={tournamentHistory}\n            onAddHistoryRecord={handleAddHistoryRecord}\n            onDeleteHistoryRecord={handleDeleteHistoryRecord}\n          />\n        )}\n      </main>\n\n      {/* Mobile Bottom Navigation Bar */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 h-16 bg-white/95 dark:bg-[#111116]/95 border-t border-[#bec7d3]/40 dark:border-white/10 backdrop-blur-lg flex items-center justify-around px-2 z-40\">\n        {[\n          { id: \'dashboard\', label: \'Console\', icon: \'sports_kabaddi\' },\n          { id: \'bracket\', label: \'Bracket\', icon: \'account_tree\' },\n          { id: \'bladers\', label: \'Bladers\', icon: \'groups\' },\n          { id: \'equipment\', label: \'Combos\', icon: \'view_in_ar\' },\n          { id: \'history\', label: \'Historial\', icon: \'emoji_events\' },\n          { id: \'configuration\', label: \'Config\', icon: \'tune\' }\n        ].map((item) => {\n          const isActive = activeScreen === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => setActiveScreen(item.id as ActiveScreen)}\n              className={`flex flex-col items-center justify-center p-1 font-label-caps text-[10px] uppercase font-bold transition-all ${\n                isActive ? \'text-[#04A8FC]\' : \'text-gray-500\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-lg\">{item.icon}</span>\n              <span>{item.label}</span>\n            </button>\n          );\n        })}\n      </nav>"
      replacement_content: "      {/* Main Content Area */}\n      <main className=\"flex-1 md:ml-64 pt-20 pb-24 md:pb-12 px-3 sm:px-6 md:px-8 relative z-10\">\n        {activeScreen === \'dashboard\' && (\n          <DashboardScreen\n            currentMatch={currentMatch}\n            config={config}\n            allBladers={bladers}\n            onUpdateScore={handleUpdateScore}\n            onResetMatch={handleResetMatch}\n            onSelectOnDeckMatch={handleSelectOnDeckMatch}\n            onRandomizeOnDeck={handleRandomizeOnDeck}\n            onSwapCorners={handleSwapCorners}\n            onQuickStartMatch={handleQuickStartByName}\n            onOpenNewBattle={() => setNewBattleModalOpen(true)}\n            onNavigateToBladers={() => setActiveScreen(\'bladers\')}\n          />\n        )}\n\n        {activeScreen === \'configuration\' && (\n          <ConfigScreen\n            config={config}\n            registeredBladersCount={bladers.length}\n            onSaveConfig={(updated) => setConfig(updated)}\n            onStartTournament={() => {\n              setActiveScreen(\'bracket\');\n            }}\n          />\n        )}\n\n        {activeScreen === \'bladers\' && (\n          <BladersScreen\n            bladers={bladers}\n            onAddBlader={handleAddBlader}\n            onUpdateBlader={handleUpdateBlader}\n            onToggleVerified={handleToggleVerified}\n            onDeleteBlader={handleDeleteBlader}\n            onToggleBadge={handleToggleBadge}\n          />\n        )}\n\n        {activeScreen === \'bracket\' && (\n          <BracketScreen\n            bladers={bladers}\n            matches={matches}\n            onSelectMatchForConsole={handleSelectMatchForConsole}\n            onSetMatchWinner={handleSetMatchWinner}\n            onGenerateBracket={handleGenerateBracket}\n          />\n        )}\n\n        {activeScreen === \'matches\' && (\n          <MatchesScreen\n            matches={matches}\n            allBladers={bladers}\n            onSelectMatchForConsole={handleSelectMatchForConsole}\n            onQuickAddMatchByName={(nA, nB) => {\n              handleQuickStartByName(nA, nB, config.victoryConditions.pointsToWin);\n            }}\n            onAddNewMatch={(bA, bB, round) => {\n              const bladerA = bladers.find((b) => b.id === bA) || null;\n              const bladerB = bladers.find((b) => b.id === bB) || null;\n              const newM: Match = {\n                id: `match-${Date.now()}`,\n                roundNumber: 2,\n                roundName: round,\n                matchNumber: matches.length + 1,\n                bladerA,\n                bladerB,\n                scoreA: 0,\n                scoreB: 0,\n                targetScore: config.victoryConditions.pointsToWin,\n                status: \'upcoming\',\n                winnerId: null,\n                cornerA: \'Red\',\n                cornerB: \'Blue\',\n                events: []\n              };\n              setMatches((prev) => [newM, ...prev]);\n            }}\n          />\n        )}\n\n        {activeScreen === \'equipment\' && (\n          <EquipmentScreen\n            parts={parts}\n            bladers={bladers}\n            registeredCombos={registeredCombos}\n            onAddPart={handleAddPart}\n            onDeletePart={handleDeletePart}\n            onAddCombo={handleAddCombo}\n            onDeleteCombo={handleDeleteCombo}\n            onUpdateBlader={handleUpdateBlader}\n          />\n        )}\n\n        {activeScreen === \'rules\' && <RulesScreen />}\n\n        {activeScreen === \'history\' && (\n          <HistoryScreen\n            bladers={bladers}\n            history={tournamentHistory}\n            onAddHistoryRecord={handleAddHistoryRecord}\n            onDeleteHistoryRecord={handleDeleteHistoryRecord}\n          />\n        )}\n      </main>\n\n      {/* Mobile Bottom Navigation Bar */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 h-16 bg-white/95 dark:bg-[#111116]/95 border-t border-slate-200 dark:border-white/10 backdrop-blur-xl flex items-center justify-around px-1.5 z-40 shadow-2xl\">\n        {[\n          { id: \'dashboard\', label: \'Consola\', icon: \'sports_kabaddi\' },\n          { id: \'bracket\', label: \'Bracket\', icon: \'account_tree\' },\n          { id: \'bladers\', label: \'Bladers\', icon: \'groups\' },\n          { id: \'equipment\', label: \'Combos\', icon: \'view_in_ar\' },\n          { id: \'matches\', label: \'Partidas\', icon: \'schedule\' },\n          { id: \'history\', label: \'Historial\', icon: \'emoji_events\' },\n          { id: \'configuration\', label: \'Config\', icon: \'tune\' }\n        ].map((item) => {\n          const isActive = activeScreen === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => {\n                soundManager.playClick();\n                setActiveScreen(item.id as ActiveScreen);\n              }}\n              className={`flex-1 flex flex-col items-center justify-center py-1.5 px-0.5 rounded-xl transition-all min-h-[48px] ${\n                isActive\n                  ? \'text-[#0284c7] dark:text-[#04A8FC] bg-sky-50 dark:bg-[#04A8FC]/15 font-black scale-105\'\n                  : \'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[20px] mb-0.5\">\n                {item.icon}\n              </span>\n              <span className=\"font-label-caps text-[9px] uppercase tracking-wider leading-none\">\n                {item.label}\n              </span>\n            </button>\n          );\n        })}\n      </nav>"
    }
