ing-wider transition-all duration-150 text-left ${\n                isActive\n                  ? \'bg-[#04A8FC] text-white font-bold shadow-md shadow-[#04A8FC]/25 translate-x-1\'\n                  : \'text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/5 hover:translate-x-1\'\n              }`}\n            >\n              <span\n                className=\"material-symbols-outlined text-lg\"\n                style={{ fontVariationSettings: isActive ? \"\'FILL\' 1\" : \"\'FILL\' 0\" }}\n              >\n                {item.icon}\n              </span>\n              <span className=\"flex-1 truncate\">{item.label}</span>\n              {item.badge && (\n                <span className=\"bg-[#AC191F] text-white text-[9px] px-1.5 py-0.5 rounded-full font-bold\">\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* New Battle Quick Action */}\n      <div className=\"px-4 my-4\">\n        <button\n          id=\"btn-new-battle-sidebar\"\n          onClick={() => {\n            soundManager.playClick();\n            onOpenNewBattle();\n          }}\n          className=\"w-full bg-gradient-to-r from-[#04A8FC] to-[#006398] hover:from-[#33b8fc] hover:to-[#04A8FC] text-white font-headline font-bold text-xs uppercase tracking-wider py-3 px-4 rounded-xl shadow-md shadow-[#04A8FC]/30 flex items-center justify-center gap-2 transition-all hover:scale-[1.02] active:scale-[0.98]\"\n        >\n          <span className=\"material-symbols-outlined text-base\">add_circle</span>\n          <span>Nueva Batalla</span>\n        </button>\n      </div>\n\n      {/* Bottom links */}\n      <div className=\"px-3 pt-3 border-t border-[#bec7d3]/30 dark:border-white/10 space-y-1\">\n        <button\n          id=\"btn-support-sidebar\"\n          onClick={() => {\n            soundManager.playClick();\n            onOpenSupportModal()